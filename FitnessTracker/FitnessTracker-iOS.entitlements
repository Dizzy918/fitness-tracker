<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- iCloud sync is implemented and wired up, but its entitlement is left
	     out on purpose: unlike HealthKit's, an iCloud container identifier
	     requires a provisioning profile *to build at all*, which would break
	     the signing-free `xcodebuild … test` the README documents.

	     To turn sync on: set your team in Xcode, add the iCloud capability
	     with CloudKit and a container named iCloud.<your bundle id>, then
	     point StoreConfiguration.cloudContainerIdentifier at it. The app
	     already asks for CloudKit at launch and falls back to a local store
	     when it isn't granted, so nothing else needs changing. -->
</dict>
</plist>
