    "Steps can be sent to your watch as a .fit workout, so the session runs itself rather than being a name you have to remember.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стъпките могат да се изпратят към часовника като .fit тренировка, така че тренировката се води сама, вместо да е име, което трябва да помниш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schritte lassen sich als .fit-Workout an deine Uhr senden — die Einheit führt sich dann selbst, statt ein Name zu sein, den du dir merken musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos se pueden enviar al reloj como entrenamiento .fit, así la sesión se guía sola en vez de ser un nombre que tengas que recordar."
          }
        }
      }
    },
    "Still to do": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Остава да се направи"
