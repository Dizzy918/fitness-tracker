            "state": "translated",
            "value": "Щоб маршрут мав профіль, потрібно щонайменше дві точки."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 경로에 프로필이 생기려면 지점이 최소 두 개 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
