    "If you've seen a higher number on a hard effort, use that instead — this estimate is ±10 bpm at best.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако си виждал по-високо число при тежко усилие, използвай него — тази оценка е ±10 уд/мин в най-добрия случай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du bei einer harten Belastung schon einen höheren Wert gesehen hast, nimm den — diese Schätzung liegt bestenfalls ±10 bpm daneben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has visto un número más alto en un esfuerzo duro, usa ese: esta estimación falla ±10 ppm en el mejor de los casos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as déjà vu un chiffre plus élevé sur un effort dur, prends celui-là : cette estimation est au mieux à ±10 bpm."
          }
        }
      }
    },
