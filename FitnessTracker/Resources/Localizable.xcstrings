      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато не зададеш това, зоните използват най-високия пулс в цялата ти история — по-добре от пика на една тренировка, но пак предположение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du das nicht einträgst, nutzen die Zonen die höchste HF deiner gesamten Historie — besser als der Spitzenwert einer Einheit, aber immer noch geraten."
