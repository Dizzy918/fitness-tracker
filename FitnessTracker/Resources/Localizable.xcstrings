    "Do a daily check-in to get a readiness score. (Health data is iOS-only.)": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи дневна самооценка, за да получиш оценка за готовност. (Данните от Health са само за iOS.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ein tägliches Check-in, um einen Bereitschaftswert zu erhalten. (Health-Daten gibt es nur unter iOS.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un registro diario para obtener una puntuación de disposición. (Los datos de Salud son solo de iOS)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un point quotidien pour obtenir un score de disponibilité. (Les données Santé n'existent que sur iOS.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un check-in giornaliero per ottenere un punteggio di prontezza. (I dati di Salute esistono solo su iOS.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe een dagelijkse check-in voor een gereedheidsscore. (Gezondheidsgegevens zijn alleen op iOS.)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz um registo diário para obteres uma pontuação de prontidão. (Os dados da Saúde só existem em iOS.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób codzienny wpis, aby otrzymać wskaźnik gotowości. (Dane ze Zdrowia są tylko na iOS.)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör en daglig avstämning för att få ett beredskapsvärde. (Hälsodata finns bara på iOS.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンディションスコアを得るにはデイリーチェックインを行ってください。（ヘルスケアのデータは iOS のみです。）"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav en daglig status for at få en parathedsscore. (Sundhedsdata findes kun på iOS.)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta en daglig status for å få en beredskapsscore. (Helsedata finnes bare på iOS.)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee päivittäinen kirjaus saadaksesi valmiuspisteet. (Terveys-tiedot ovat vain iOS:ssä.)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělej denní zápis, ať získáš skóre připravenosti. (Data ze Zdraví jsou jen na iOS.)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlık puanı almak için günlük kayıt gir. (Sağlık verisi yalnızca iOS'ta.)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдите ежедневный опрос, чтобы получить оценку готовности. (Данные «Здоровья» доступны только на iOS.)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдіть щоденне опитування, щоб отримати оцінку готовності. (Дані «Здоров’я» доступні лише на iOS.)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비도 점수를 보려면 일일 체크인을 하세요. (건강 데이터는 iOS 전용입니다.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成每日签到即可获得状态评分。（健康数据仅限 iOS。）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um check-in diário para ter uma nota de prontidão. (Os dados do app Saúde são só no iOS.)"
          }
        }
      }
    },
