    "Sets are logged against an exercise, so start by setting up your library.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се записват към упражнение, затова започни с изграждането на библиотеката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze werden zu einer Übung erfasst — richte also zuerst deine Bibliothek ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series se registran contra un ejercicio, así que empieza montando tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries sont enregistrées sur un exercice : commence donc par constituer ta bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie si registrano su un esercizio, quindi inizia creando la tua libreria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets worden bij een oefening vastgelegd, dus begin met het opzetten van je bibliotheek."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries são registadas num exercício, por isso começa por montar a tua biblioteca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie zapisuje się do ćwiczenia, więc zacznij od zbudowania biblioteki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Set registreras mot en övning, så börja med att bygga ditt bibliotek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットは種目に紐づけて記録します。まずライブラリを用意してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt registreres på en øvelse, så begynd med at opbygge dit bibliotek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett registreres på en øvelse, så begynn med å bygge opp biblioteket ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarjat kirjataan liikkeelle, joten aloita rakentamalla kirjastosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Série se zaznamenávají k cviku, takže začni tím, že si založíš knihovnu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setler bir harekete kaydedilir, o yüzden önce kitaplığını kur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходы записываются к упражнению, поэтому начните с библиотеки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підходи записуються до вправи, тож почніть із бібліотеки."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트는 운동에 기록되므로 먼저 라이브러리부터 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组数要记录在某个动作下，所以先建立动作库。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries são registradas em um exercício, então comece montando sua biblioteca."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسجَّل المجموعات على تمرين، فابدأ بإعداد مكتبتك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σετ καταγράφονται σε μια άσκηση, οπότε ξεκίνα φτιάχνοντας τη βιβλιοθήκη σου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sorozatok gyakorlathoz rögzülnek, ezért kezdd a könyvtárad összeállításával."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriile se înregistrează la un exercițiu, așa că începe prin a-ți construi biblioteca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Série sa zaznamenávajú k cviku, takže začni tým, že si založíš knižnicu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serije se beležijo k vaji, zato začni z ureditvijo knjižnice."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serije se bilježe uz vježbu, pa počni slaganjem knjižnice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Серије се бележе уз вежбу, па почни слагањем библиотеке."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seeriad salvestatakse harjutuse juurde, seega alusta oma kogu seadistamisest."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieejas tiek pierakstītas pie vingrinājuma, tāpēc sāc ar savas bibliotēkas izveidi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serijos žymimos prie pratimo, todėl pradėk nuo bibliotekos sukūrimo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sèries es registren sobre un exercici, així que comença configurant la teva biblioteca."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett eru skráð á æfingu, svo byrjaðu á að setja upp safnið þitt."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Seritë regjistrohen te një ushtrim, prandaj fillo duke ngritur bibliotekën tënde."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се запишуваат кон вежба, па почни со поставување на твојата библиотека."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Logáiltear sraitheanna le cleachtadh, mar sin tosaigh le do leabharlann a chur le chéile."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-settijiet jiġu rreġistrati ma' eżerċizzju, għalhekk ibda billi tibni l-librerija tiegħek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "組數要記在某個動作下，所以請先建立你的動作庫。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Set dicatat pada suatu gerakan, jadi mulailah dengan menyiapkan pustakamu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set dicatat pada sesuatu senaman, jadi mulakan dengan menyediakan pustaka anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hiệp đều được ghi vào một bài tập, nên hãy bắt đầu bằng việc lập thư viện của bạn."
          }
        }
      }
    },
    "Sets are logged against an exercise, so you need at least one. Start from the built-in list and edit it, or add your own.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се записват към упражнение, така че ти трябва поне едно. Започни от вградения списък и го редактирай, или добави свои."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze werden zu einer Übung erfasst, du brauchst also mindestens eine. Fang mit der mitgelieferten Liste an und passe sie an, oder leg eigene an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series se registran contra un ejercicio, así que necesitas al menos uno. Parte de la lista incluida y edítala, o añade los tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries sont enregistrées sur un exercice, il t'en faut donc au moins un. Pars de la liste fournie et modifie-la, ou ajoute les tiens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie si registrano su un esercizio, quindi te ne serve almeno uno. Parti dall'elenco integrato e modificalo, oppure aggiungi i tuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets worden bij een oefening vastgelegd, dus je hebt er minstens één nodig. Begin met de ingebouwde lijst en pas die aan, of voeg je eigen oefeningen toe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries são registadas num exercício, por isso precisas de pelo menos um. Parte da lista incluída e edita-a, ou acrescenta os teus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie zapisuje się do ćwiczenia, więc potrzebujesz przynajmniej jednego. Zacznij od wbudowanej listy i ją zmodyfikuj, albo dodaj własne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Set registreras mot en övning, så du behöver minst en. Utgå från den inbyggda listan och ändra den, eller lägg till egna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットは種目に紐づけて記録するため、最低 1 つ必要です。内蔵リストから始めて編集するか、自分で追加してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt registreres på en øvelse, så du skal have mindst én. Tag udgangspunkt i den indbyggede liste og ret i den, eller tilføj dine egne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett registreres på en øvelse, så du trenger minst én. Ta utgangspunkt i den innebygde lista og rediger den, eller legg til dine egne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarjat kirjataan liikkeelle, joten tarvitset vähintään yhden. Aloita valmiista luettelosta ja muokkaa sitä, tai lisää omia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Série se zaznamenávají k cviku, takže potřebuješ aspoň jeden. Vyjdi ze zabudovaného seznamu a uprav si ho, nebo si přidej vlastní."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setler bir harekete kaydedilir, yani en az bir taneye ihtiyacın var. Hazır listeden başlayıp düzenle ya da kendi hareketini ekle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходы записываются к упражнению, поэтому нужно хотя бы одно. Возьмите встроенный список и отредактируйте его или добавьте своё."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підходи записуються до вправи, тож потрібна щонайменше одна. Візьміть вбудований список і відредагуйте його або додайте своє."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트는 운동에 기록되므로 최소 하나는 있어야 합니다. 기본 목록에서 시작해 수정하거나 직접 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组数要记录在某个动作下，所以至少需要一个。可以从内置列表开始修改，或自己添加。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries são registradas em um exercício, então você precisa de pelo menos um. Comece pela lista embutida e edite, ou crie os seus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسجَّل المجموعات على تمرين، فأنت بحاجة إلى واحد على الأقل. ابدأ من القائمة المدمجة وعدّلها، أو أضف تمارينك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα σετ καταγράφονται σε μια άσκηση, οπότε χρειάζεσαι τουλάχιστον μία. Ξεκίνα από την ενσωματωμένη λίστα και άλλαξέ την, ή πρόσθεσε δικές σου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sorozatok gyakorlathoz rögzülnek, ezért legalább egy kell. Indulj a beépített listáról és szerkeszd, vagy vegyél fel sajátokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seriile se înregistrează la un exercițiu, deci ai nevoie de cel puțin unul. Pornește de la lista predefinită și modific-o, sau adaugă-le pe ale tale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Série sa zaznamenávajú k cviku, takže potrebuješ aspoň jeden. Vyjdi zo vstavaného zoznamu a uprav si ho, alebo si pridaj vlastný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serije se beležijo k vaji, zato potrebuješ vsaj eno. Začni z vgrajenim seznamom in ga uredi ali dodaj svoje."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serije se bilježe uz vježbu, pa trebaš barem jednu. Kreni od ugrađenog popisa i uredi ga, ili dodaj svoje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Серије се бележе уз вежбу, па ти треба бар једна. Крени од уграђене листе и уреди је, или додај своје."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seeriad salvestatakse harjutuse juurde, seega vajad vähemalt üht. Alusta sisseehitatud nimekirjast ja muuda seda või lisa omad."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieejas tiek pierakstītas pie vingrinājuma, tāpēc vajag vismaz vienu. Sāc ar iebūvēto sarakstu un rediģē to vai pievieno savus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serijos žymimos prie pratimo, todėl reikia bent vieno. Pradėk nuo įtaisytojo sąrašo ir jį pakoreguok arba pridėk savo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sèries es registren sobre un exercici, així que en necessites com a mínim un. Parteix de la llista integrada i edita-la, o afegeix-ne de teus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett eru skráð á æfingu, svo þú þarft að minnsta kosti eina. Byrjaðu á innbyggða listanum og breyttu honum, eða bættu við þínum eigin."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Seritë regjistrohen te një ushtrim, prandaj të duhet të paktën një. Nis nga lista e integruar dhe përshtate, ose shto të tuat."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се запишуваат кон вежба, па ти треба барем една. Почни од вградената листа и уреди ја, или додај свои."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Logáiltear sraitheanna le cleachtadh, mar sin teastaíonn ceann amháin ar a laghad uait. Tosaigh leis an liosta ionsuite agus cuir in eagar é, nó cuir do chinn féin leis."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-settijiet jiġu rreġistrati ma' eżerċizzju, għalhekk għandek bżonn mill-inqas wieħed. Ibda mil-lista inkluża u editjaha, jew żid tiegħek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "組數要記在某個動作下，所以至少需要一個。可以從內建清單開始修改，或自己新增。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Set dicatat pada suatu gerakan, jadi kamu perlu setidaknya satu. Mulai dari daftar bawaan lalu ubah, atau tambahkan milikmu sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set dicatat pada sesuatu senaman, jadi anda perlukan sekurang-kurangnya satu. Mulakan daripada senarai terbina dan editnya, atau tambah milik anda sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hiệp đều được ghi vào một bài tập, nên bạn cần ít nhất một bài. Hãy bắt đầu từ danh sách có sẵn rồi sửa lại, hoặc tự thêm bài của riêng bạn."
          }
        }
      }
    },
