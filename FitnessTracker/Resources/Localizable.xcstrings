            "state": "translated",
            "value": "Planuje %lld-dniowy taper przed tą datą."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planerar %lld dagars nedtrappning före det här datumet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日付の前に %lld 日間のテーパーを計画します。"
