    "Couldn't snap that segment to a path — using a straight line.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсечката не можа да се захване за пътека — използва се права линия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Segment ließ sich an keinen Weg anlegen — es wird eine gerade Linie verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo ajustar ese tramo a un camino: se usa una línea recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'aligner ce segment sur un chemin : une ligne droite est utilisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile agganciare quel tratto a un sentiero: si usa una linea retta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat segment kon niet op een pad worden vastgezet — er wordt een rechte lijn gebruikt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ajustar esse troço a um caminho — está a usar-se uma linha reta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dopasować tego odcinka do ścieżki — użyto linii prostej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att fästa den sträckan mot en stig — en rak linje används."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その区間を道に合わせられませんでした。直線で表示します。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Strækningen kunne ikke lægges på en sti — der bruges en ret linje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fikk ikke festet den strekningen til en sti — bruker en rett linje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osuutta ei saatu kiinnitettyä polkuun — käytetään suoraa viivaa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsek se nepodařilo přichytit k cestě — použije se přímka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölüm bir yola oturtulamadı — düz çizgi kullanılıyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось привязать этот участок к дорожке — рисуем прямой линией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прив’язати цю ділянку до доріжки — малюємо прямою лінією."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구간을 길에 맞출 수 없어 직선으로 연결합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将该段吸附到路径——改用直线连接。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encaixar esse trecho em um caminho — usando uma linha reta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر محاذاة هذا المقطع مع مسار — سيُرسم خطًا مستقيمًا."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η προσαρμογή αυτού του τμήματος σε μονοπάτι — χρησιμοποιείται ευθεία γραμμή."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a szakasz nem illeszthető útvonalra — egyenes vonalat használunk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Segmentul nu a putut fi aliniat la o potecă — se folosește o linie dreaptă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento úsek sa nepodarilo priložiť na cestu — používa sa priamka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega odseka ni bilo mogoče pripeti na pot — uporabljena je ravna črta."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taj dio nije bilo moguće poravnati sa stazom — koristi se ravna linija."
          }
        }
      }
    },
