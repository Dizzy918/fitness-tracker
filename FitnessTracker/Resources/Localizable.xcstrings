          }
        }
      }
    },
    "Still warming up — the 42-day average needs about three weeks of history before it settles.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още се загрява — 42-дневната средна има нужда от около три седмици история, преди да се установи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch am Einschwingen — der 42-Tage-Durchschnitt braucht rund drei Wochen Historie, bis er sich setzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía calentando: la media de 42 días necesita unas tres semanas de historial para asentarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore en rodage : la moyenne sur 42 jours a besoin d'environ trois semaines d'historique pour se stabiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora in rodaggio: la media a 42 giorni ha bisogno di circa tre settimane di storico per stabilizzarsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog aan het inlopen — het gemiddelde over 42 dagen heeft zo'n drie weken geschiedenis nodig voordat het stabiel is."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda a assentar — a média de 42 dias precisa de cerca de três semanas de histórico para estabilizar."
          }
        }
      }
    },
    "Stop watching": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спри наблюдението"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr überwachen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de vigilar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la surveillance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di controllare"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet meer volgen"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar de vigiar"
          }
        }
      }
    },
    "Stored on this device only — they go into an encrypted backup if you make one, and nowhere else.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съхраняват се само на това устройство — влизат в криптирано резервно копие, ако направиш такова, и никъде другаде."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät gespeichert — sie landen in einer verschlüsselten Sicherung, falls du eine anlegst, und sonst nirgends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan solo en este dispositivo: van a una copia cifrada si haces una, y a ningún sitio más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockées uniquement sur cet appareil : elles vont dans une sauvegarde chiffrée si tu en fais une, et nulle part ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvate solo su questo dispositivo: finiscono in un backup cifrato se ne fai uno, e da nessun'altra parte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op dit apparaat bewaard — ze gaan mee in een versleutelde reservekopie als je die maakt, en verder nergens heen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardadas só neste dispositivo — vão para uma cópia de segurança cifrada se fizeres uma, e para mais lado nenhum."
          }
        }
      }
    },
    "Straight into the next exercise — the rest comes at the end of the round.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направо към следващото упражнение — почивката идва в края на кръга."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt weiter zur nächsten Übung — die Pause kommt am Ende der Runde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directo al siguiente ejercicio: el descanso llega al final de la ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enchaîne directement sur l'exercice suivant : la récupération vient à la fin du tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito all'esercizio successivo: il recupero arriva alla fine del giro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct door naar de volgende oefening — de rust komt aan het eind van de ronde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue direto para o exercício seguinte — o descanso vem no fim da ronda."
          }
        }
      }
    },
