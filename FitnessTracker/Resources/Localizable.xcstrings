        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Strava o intervals.icu qui sotto per attivare la sincronizzazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel hieronder Strava of intervals.icu om synchroniseren aan te zetten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga o Strava ou o intervals.icu abaixo para ativar a sincronização."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz poniżej Stravę lub intervals.icu, aby włączyć synchronizację."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut Strava eller intervals.icu nedan för att slå på synkronisering."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期を有効にするには、下で Strava または intervals.icu を接続してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind Strava eller intervals.icu nedenfor for at slå synkronisering til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til Strava eller intervals.icu nedenfor for å slå på synkronisering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä Strava tai intervals.icu alta ottaaksesi synkronoinnin käyttöön."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Níže připoj Stravu nebo intervals.icu, aby šla zapnout synchronizace."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitlemeyi açmak için aşağıdan Strava'yı veya intervals.icu'yu bağla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Strava или intervals.icu ниже, чтобы включить синхронизацию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть Strava або intervals.icu нижче, щоб увімкнути синхронізацію."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 사용하려면 아래에서 Strava 또는 intervals.icu를 연결하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
