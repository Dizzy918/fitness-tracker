    "Estimated by your watch from heart rate against pace. It moves slowly and noisily, so read the direction over months rather than any single reading.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено от часовника ти по пулс спрямо темпо. Движи се бавно и шумно, затова чети посоката през месеци, а не отделно измерване."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von deiner Uhr aus Herzfrequenz und Tempo geschätzt. Der Wert bewegt sich langsam und verrauscht — lies die Richtung über Monate, nicht einen einzelnen Messwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado por tu reloj a partir de la frecuencia cardíaca frente al ritmo. Se mueve despacio y con ruido, así que lee la dirección a lo largo de meses, no una medida suelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimé par ta montre à partir de la fréquence cardiaque rapportée à l'allure. La valeur bouge lentement et avec du bruit : lis la tendance sur des mois, pas une mesure isolée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimato dall'orologio dalla frequenza cardiaca rapportata al ritmo. Si muove lentamente e con rumore: leggine la direzione su mesi, non una singola misura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door je horloge geschat uit hartslag tegenover tempo. Het beweegt traag en met ruis, dus lees de richting over maanden en niet één losse meting."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado pelo teu relógio a partir da frequência cardíaca em relação ao ritmo. Move-se devagar e com ruído, por isso lê a direção ao longo de meses e não uma leitura isolada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszacowane przez zegarek z tętna względem tempa. Zmienia się powoli i z szumem, więc czytaj kierunek w skali miesięcy, a nie pojedynczy odczyt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattat av klockan ur puls mot tempo. Värdet rör sig långsamt och brusigt, så läs riktningen över månader snarare än en enskild mätning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計が心拍とペースの関係から推定した値です。ゆっくり、ばらつきを伴って動くので、単発の値ではなく数か月の方向で読んでください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslået af dit ur ud fra puls i forhold til tempo. Tallet bevæger sig langsomt og med støj, så læs retningen over måneder frem for en enkelt måling."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslått av klokka ut fra puls mot tempo. Verdien beveger seg sakte og med støy, så les retningen over måneder heller enn én enkelt måling."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kellon arvio sykkeen ja vauhdin suhteesta. Arvo liikkuu hitaasti ja häiriöisesti, joten lue suuntaa kuukausien yli äläkä yksittäistä lukemaa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad hodinek z tepové frekvence vůči tempu. Hodnota se mění pomalu a zašuměně, takže čti směr v horizontu měsíců, ne jedno měření."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatin tarafından nabzın tempoya oranından tahmin edildi. Yavaş ve gürültülü değişir; bu yüzden tek bir ölçüme değil, aylar içindeki yöne bak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено часами по соотношению пульса и темпа. Меняется медленно и шумно, поэтому смотрите на направление за месяцы, а не на отдельное значение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінено годинником за співвідношенням пульсу й темпу. Змінюється повільно та шумно, тож дивіться на напрямок за місяці, а не на окреме значення."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계가 심박수와 페이스의 관계로 추정한 값입니다. 느리고 들쭉날쭉하게 움직이므로 개별 값이 아니라 몇 달간의 방향을 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由手表根据心率与配速的关系估算。它变化缓慢且噪声大，请看几个月的走势，而不是某一次的数值。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado pelo seu relógio a partir da frequência cardíaca em relação ao ritmo. Varia devagar e com ruído, então olhe a direção ao longo de meses, não uma leitura isolada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّره ساعتك من علاقة النبض بالوتيرة. يتحرك ببطء وبتشويش، فاقرأ الاتجاه عبر أشهر لا قراءة واحدة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτιμάται από το ρολόι σου με βάση τη σχέση παλμών και ρυθμού. Κινείται αργά και με θόρυβο, οπότε κοίτα την κατεύθυνση σε βάθος μηνών, όχι μια μεμονωμένη μέτρηση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az órád becsüli a pulzus és a tempó viszonyából. Lassan és zajosan mozog, ezért hónapok irányát nézd, ne egyetlen mérést."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimat de ceasul tău din raportul dintre puls și ritm. Se mișcă lent și cu zgomot, așa că urmărește direcția pe luni întregi, nu o singură citire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhadujú to tvoje hodinky z pomeru tepovej frekvencie a tempa. Mení sa pomaly a zašumene, takže sleduj smer v mesiacoch, nie jednotlivé meranie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocenila ga je tvoja ura iz razmerja med utripom in tempom. Spreminja se počasi in šumno, zato glej smer čez mesece, ne posamezne meritve."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Procijenio ga je tvoj sat iz odnosa pulsa i tempa. Mijenja se sporo i s puno šuma, pa gledaj smjer kroz mjesece, a ne pojedino mjerenje."
          }
        }
      }
    },
