    "Steps can be sent to your watch as a .fit workout, so the session runs itself rather than being a name you have to remember.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стъпките могат да се изпратят към часовника като .fit тренировка, така че тренировката се води сама, вместо да е име, което трябва да помниш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schritte lassen sich als .fit-Workout an deine Uhr senden — die Einheit führt sich dann selbst, statt ein Name zu sein, den du dir merken musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos se pueden enviar al reloj como entrenamiento .fit, así la sesión se guía sola en vez de ser un nombre que tengas que recordar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes peuvent partir vers ta montre sous forme d'entraînement .fit : la séance se déroule toute seule au lieu d'être un nom à retenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I passi possono essere inviati all'orologio come allenamento .fit, così la sessione si guida da sola invece di essere un nome da ricordare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stappen kunnen als .fit-training naar je horloge, zodat de sessie zichzelf stuurt in plaats van een naam te zijn die je moet onthouden."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os passos podem seguir para o relógio como treino .fit, para a sessão se conduzir sozinha em vez de ser um nome que tens de decorar."
          }
        }
      }
    },
    "Still to do": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Остава да се направи"
