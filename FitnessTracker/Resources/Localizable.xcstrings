    "Estimated by your watch from heart rate against pace. It moves slowly and noisily, so read the direction over months rather than any single reading.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено от часовника ти по пулс спрямо темпо. Движи се бавно и шумно, затова чети посоката през месеци, а не отделно измерване."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von deiner Uhr aus Herzfrequenz und Tempo geschätzt. Der Wert bewegt sich langsam und verrauscht — lies die Richtung über Monate, nicht einen einzelnen Messwert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado por tu reloj a partir de la frecuencia cardíaca frente al ritmo. Se mueve despacio y con ruido, así que lee la dirección a lo largo de meses, no una medida suelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimé par ta montre à partir de la fréquence cardiaque rapportée à l'allure. La valeur bouge lentement et avec du bruit : lis la tendance sur des mois, pas une mesure isolée."
          }
        }
      }
    },
    "Estimated from duration": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено по продължителност"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Dauer geschätzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado por la duración"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimé d'après la durée"
          }
        }
      }
    },
    "Estimated from your highest recorded HR. Set your real max in Settings for accurate zones.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено по най-високия ти записан пулс. Задай реалния максимум в Настройки за точни зони."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deiner höchsten aufgezeichneten HF geschätzt. Trage dein echtes Maximum in den Einstellungen ein, damit die Zonen stimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de tu FC más alta registrada. Pon tu máximo real en Ajustes para que las zonas sean exactas."
          }
        },
