    "Check each row against the PDF before importing — extraction can misread tables.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери всеки ред спрямо PDF-а преди импортиране — извличането може да разчете таблиците погрешно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe jede Zeile vor dem Import gegen das PDF — die Erkennung kann Tabellen falsch lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba cada fila con el PDF antes de importar: la extracción puede leer mal las tablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie chaque ligne avec le PDF avant d'importer : l'extraction peut mal lire les tableaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla ogni riga con il PDF prima di importare: l'estrazione può leggere male le tabelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer elke regel met de PDF voordat je importeert — het uitlezen kan tabellen verkeerd interpreteren."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confere cada linha com o PDF antes de importar — a extração pode ler mal as tabelas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź każdy wiersz z PDF-em przed importem — odczyt może źle zinterpretować tabele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera varje rad mot PDF:en innan du importerar — tolkningen kan läsa tabeller fel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取りは表を誤認することがあります。取り込む前に各行を PDF と照合してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek hver række mod PDF'en, før du importerer — udtrækket kan læse tabeller forkert."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk hver rad mot PDF-en før du importerer — uttrekket kan lese tabeller feil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista jokainen rivi PDF:ää vasten ennen tuontia — poiminta voi lukea taulukot väärin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před importem zkontroluj každý řádek proti PDF — čtení může tabulky přečíst špatně."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarmadan önce her satırı PDF ile karşılaştır — okuma sırasında tablolar yanlış anlaşılabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед импортом сверьте каждую строку с PDF — при разборе таблицы могут быть прочитаны неверно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед імпортом звіряйте кожен рядок із PDF — під час розбору таблиці можуть бути прочитані неправильно."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 전에 각 행을 PDF와 대조하세요 — 추출 과정에서 표를 잘못 읽을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入前请逐行与 PDF 核对——解析时可能读错表格。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira cada linha com o PDF antes de importar — a extração pode ler tabelas errado."
          }
        }
      }
    },
