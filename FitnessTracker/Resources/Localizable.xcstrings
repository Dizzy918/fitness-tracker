    "Until you set this, zones use the highest HR in your whole history — better than one session's peak, but still a guess.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато не зададеш това, зоните използват най-високия пулс в цялата ти история — по-добре от пика на една тренировка, но пак предположение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange du das nicht einträgst, nutzen die Zonen die höchste HF deiner gesamten Historie — besser als der Spitzenwert einer Einheit, aber immer noch geraten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que pongas esto, las zonas usan la FC más alta de todo tu historial: mejor que el pico de una sesión, pero sigue siendo una suposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que tu ne renseignes pas ceci, les zones utilisent la FC la plus haute de tout ton historique : mieux que le pic d'une séance, mais toujours une estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non lo imposti, le zone usano la FC più alta di tutto il tuo storico: meglio del picco di una singola sessione, ma resta una stima."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang je dit niet instelt, gebruiken de zones de hoogste hartslag uit je hele geschiedenis — beter dan de piek van één sessie, maar nog steeds een gok."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto não definires isto, as zonas usam a FC mais alta de todo o teu histórico — melhor do que o pico de uma sessão, mas ainda assim um palpite."
          }
        }
      }
    },
