    "Time in zone needs per-second heart rate, which comes from a .fit import or a synced activity with streams.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Времето в зона изисква пулс по секунди, който идва от .fit импорт или синхронизирана активност с потоци."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit in der Zone braucht Herzfrequenz im Sekundentakt, aus einem .fit-Import oder einer synchronisierten Aktivität mit Datenströmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo en zona necesita frecuencia cardíaca por segundo, que viene de una importación .fit o de una actividad sincronizada con registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps en zone exige une fréquence cardiaque à la seconde, issue d'un import .fit ou d'une activité synchronisée avec relevés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo in zona richiede la frequenza cardiaca al secondo, che arriva da un import .fit o da un'attività sincronizzata con i tracciati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd in zone vereist hartslag per seconde, die uit een .fit-import of een gesynchroniseerde activiteit met verlopen komt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo em zona precisa de frequência cardíaca ao segundo, que vem de uma importação .fit ou de uma atividade sincronizada com registos."
          }
        }
      }
    },
