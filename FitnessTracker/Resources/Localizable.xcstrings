            "value": "Alles Übrige — Arme, Waden, Reha"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo demás: brazos, gemelos, rehabilitación"
          }
        },
        "fr": {
