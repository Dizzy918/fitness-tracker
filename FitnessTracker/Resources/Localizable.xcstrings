          }
        }
      }
    },
    "Still warming up — the 42-day average needs about three weeks of history before it settles.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още се загрява — 42-дневната средна има нужда от около три седмици история, преди да се установи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch am Einschwingen — der 42-Tage-Durchschnitt braucht rund drei Wochen Historie, bis er sich setzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía calentando: la media de 42 días necesita unas tres semanas de historial para asentarse."
          }
        }
      }
    },
    "Stop watching": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спри наблюдението"
