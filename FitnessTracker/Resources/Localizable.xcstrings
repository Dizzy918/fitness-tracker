    "Estimated from your highest recorded HR. Set your real max in Settings for accurate zones.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено по най-високия ти записан пулс. Задай реалния максимум в Настройки за точни зони."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deiner höchsten aufgezeichneten HF geschätzt. Trage dein echtes Maximum in den Einstellungen ein, damit die Zonen stimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de tu FC más alta registrada. Pon tu máximo real en Ajustes para que las zonas sean exactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimé d'après ta FC la plus élevée enregistrée. Renseigne ton vrai maximum dans les Réglages pour des zones justes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimato dalla tua FC più alta registrata. Imposta il massimo reale nelle Impostazioni per zone corrette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschat uit je hoogst vastgelegde hartslag. Zet je echte maximum in Instellingen voor kloppende zones."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir da tua FC mais alta registada. Define o teu máximo real nas Definições para zonas corretas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszacowane z najwyższego zapisanego tętna. Ustaw prawdziwe maksimum w Ustawieniach, aby strefy były poprawne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattat ur din högsta registrerade puls. Ange din verkliga maxpuls i Inställningar för korrekta zoner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された最高心拍から推定しています。正確なゾーンのため、設定で実際の最大心拍を入力してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslået ud fra din højest registrerede puls. Angiv din rigtige makspuls under Indstillinger for korrekte zoner."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslått ut fra den høyeste pulsen som er registrert. Legg inn din virkelige makspuls under Innstillinger for riktige soner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioitu korkeimmasta tallennetusta sykkeestäsi. Aseta todellinen maksimi asetuksissa, jotta alueet ovat oikein."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhadnuto z nejvyšší zaznamenané tepové frekvence. Pro správné zóny zadej v Nastavení skutečné maximum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş en yüksek nabzından tahmin edildi. Doğru bölgeler için gerçek maksimumunu Ayarlar'da gir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено по самому высокому записанному пульсу. Укажите реальный максимум в настройках для точных зон."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінено за найвищим записаним пульсом. Вкажіть справжній максимум у налаштуваннях для точних зон."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 가장 높은 심박수로 추정했습니다. 정확한 구간을 위해 설정에서 실제 최대 심박수를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你记录到的最高心率估算。请在设置中填入真实最大心率以获得准确区间。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado pela maior frequência cardíaca registrada. Informe sua máxima real nos ajustes para ter zonas precisas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُقدَّر من أعلى نبض مسجَّل لديك. أدخل نبضك الأقصى الحقيقي في الإعدادات للحصول على نطاقات دقيقة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτιμήθηκε από τους υψηλότερους καταγεγραμμένους παλμούς σου. Όρισε την πραγματική μέγιστη τιμή στις Ρυθμίσεις για ακριβείς ζώνες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A valaha rögzített legmagasabb pulzusodból becsülve. A pontos zónákhoz add meg a valódi maximumodat a Beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimat din cel mai mare puls înregistrat. Setează maximul real în Setări pentru zone exacte."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhadnuté z najvyššej zaznamenanej tepovej frekvencie. Pre presné zóny zadaj skutočné maximum v Nastaveniach."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocenjeno iz najvišjega zabeleženega utripa. Za natančne cone v Nastavitvah vpiši pravi maksimum."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Procijenjeno iz najvišeg zabilježenog pulsa. Za točne zone upiši pravi maksimum u Postavkama."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Процењено из највишег забележеног пулса. За тачне зоне упиши прави максимум у Подешавањима."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinnatud sinu kõrgeima salvestatud pulsi põhjal. Täpsete tsoonide jaoks sisesta Seadetes tegelik maksimum."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Novērtēts pēc tava augstākā reģistrētā pulsa. Precīzām zonām ievadi īsto maksimumu Iestatījumos."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įvertinta pagal aukščiausią užfiksuotą pulsą. Tikslioms zonoms Nustatymuose įvesk tikrąjį maksimumą."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimat a partir de la freqüència cardíaca més alta registrada. Posa el teu màxim real a Configuració per tenir zones precises."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Metið út frá hæsta skráða púlsinum þínum. Settu raunverulegt hámark í Stillingum til að fá nákvæm þrep."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlerësuar nga rrahjet më të larta të regjistruara. Vendos maksimumin real te Cilësimet për zona të sakta."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценето од најголемиот забележан пулс. За точни зони внеси го вистинскиот максимум во Поставки."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Measta ón ráta croí is airde a taifeadadh. Socraigh do fhíoruasmhéid sna Socruithe le criosanna cruinne a fháil."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Stmat mill-ogħla taħbit tal-qalb irreġistrat. Daħħal il-massimu veru tiegħek fis-Settings biex iż-żoni jkunu preċiżi."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由你記錄到的最高心率估算。請在設定中填入真實最大心率以取得準確區間。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperkirakan dari detak jantung tertinggi yang tercatat. Setel maksimal sebenarnya di Pengaturan agar zonanya akurat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dianggarkan daripada denyutan jantung tertinggi yang dirakam. Tetapkan maksimum sebenar anda dalam Tetapan untuk zon yang tepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính từ nhịp tim cao nhất từng ghi được. Hãy đặt nhịp tim tối đa thật trong Cài đặt để các vùng được chính xác."
          }
        }
      }
    },
