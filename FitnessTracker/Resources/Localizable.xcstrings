    "Exercises run in order, resting after every set.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражненията се изпълняват по ред, с почивка след всяка серия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übungen laufen der Reihe nach, mit Pause nach jedem Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios van en orden, descansando después de cada serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices s'enchaînent dans l'ordre, avec une récupération après chaque série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esercizi si susseguono in ordine, con recupero dopo ogni serie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De oefeningen gaan op volgorde, met rust na elke set."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exercícios seguem por ordem, com descanso após cada série."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenia idą po kolei, z przerwą po każdej serii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övningarna görs i ordning, med vila efter varje set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種目は順番に行い、各セットのあとに休憩します。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelserne køres i rækkefølge med pause efter hvert sæt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelsene går i rekkefølge, med pause etter hvert sett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkeet tehdään järjestyksessä, tauko jokaisen sarjan jälkeen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cviky jdou po sobě, s pauzou po každé sérii."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketler sırayla yapılır, her setten sonra dinlenilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнения идут по порядку, с отдыхом после каждого подхода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправи йдуть по черзі, з відпочинком після кожного підходу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동은 순서대로 진행되며 매 세트 후에 쉽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作按顺序进行，每组之后休息。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exercícios seguem em ordem, com descanso depois de cada série."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسير التمارين بالترتيب، مع راحة بعد كل مجموعة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ασκήσεις γίνονται με τη σειρά, με διάλειμμα μετά από κάθε σετ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyakorlatok sorban következnek, minden sorozat után pihenővel."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercițiile se fac în ordine, cu pauză după fiecare serie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cviky idú po poradí, s prestávkou po každej sérii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaje tečejo po vrsti, s počitkom po vsaki seriji."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbe idu redom, uz odmor nakon svake serije."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбе иду редом, уз одмор после сваке серије."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjutused käivad järjest, puhkus pärast iga seeriat."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingrinājumi notiek pēc kārtas, ar atpūtu pēc katras pieejas."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratimai eina iš eilės, ilsintis po kiekvienos serijos."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els exercicis van en ordre, amb descans després de cada sèrie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfingarnar koma í röð, með hvíld eftir hvert sett."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushtrimet bëhen me radhë, me pushim pas çdo serie."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбите одат по ред, со одмор по секоја серија."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Téann na cleachtaí in ord, le sos i ndiaidh gach sraithe."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-eżerċizzji jsiru wieħed wara l-ieħor, b'mistrieħ wara kull sett."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動作依順序進行，每組之後休息。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakan dijalankan berurutan, istirahat setelah tiap set."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaman dijalankan mengikut urutan, berehat selepas setiap set."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài tập chạy lần lượt, nghỉ sau mỗi hiệp."
          }
        }
      }
    },
