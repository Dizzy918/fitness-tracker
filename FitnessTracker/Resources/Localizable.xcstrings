    "%lld session%@ this week had no power or heart rate, so its load is estimated from duration.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld тренировк%@ тази седмица без мощност или пулс, затова натоварването е оценено по продължителност."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Einheit%@ diese Woche ohne Leistung oder Herzfrequenz — die Belastung wird aus der Dauer geschätzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sesion%@ esta semana sin potencia ni frecuencia cardíaca, así que su carga se estima por la duración."
