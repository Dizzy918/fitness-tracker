    "Recovery, warmup and cooldown laps are dimmed and excluded from the fastest-lap comparison.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обиколките за възстановяване, загряване и разпускане са затъмнени и изключени от сравнението за най-бърза обиколка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholungs-, Aufwärm- und Auslaufrunden sind abgeblendet und vom Vergleich der schnellsten Runde ausgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vueltas de recuperación, calentamiento y vuelta a la calma aparecen atenuadas y quedan fuera de la comparación de vuelta más rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tours de récupération, d'échauffement et de retour au calme sont grisés et exclus de la comparaison du tour le plus rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giri di recupero, riscaldamento e defaticamento sono attenuati ed esclusi dal confronto sul giro più veloce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel-, warming-up- en cooling-downronden zijn gedimd en tellen niet mee in de vergelijking van de snelste ronde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As voltas de recuperação, aquecimento e retorno à calma aparecem esbatidas e ficam fora da comparação da volta mais rápida."
          }
        }
      }
    },
