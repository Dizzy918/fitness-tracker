    "This can't be undone.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това не може да се върне."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode ser desfeito."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego nie da się cofnąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här går inte att ångra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke fortrydes."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke angres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voi kumota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nejde vzít zpět."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geri alınamaz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
