            "value": "Prévoit un affûtage de %lld jours avant cette date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica uno scarico di %lld giorni prima di questa data."
          }
        },
        "nl": {
          "stringUnit": {
