    "No stream data yet. Best efforts need per-second data from a .fit import or Strava sync.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма данни от потоци. Най-добрите усилия изискват данни по секунди от .fit импорт или синхронизация със Strava."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Datenströme. Bestleistungen brauchen Sekundendaten aus einem .fit-Import oder einer Strava-Synchronisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay registros continuos. Los mejores esfuerzos necesitan datos por segundo de una importación .fit o de la sincronización con Strava."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de relevés continus. Les meilleurs efforts exigent des données à la seconde issues d'un import .fit ou d'une synchronisation Strava."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun tracciato continuo. I migliori sforzi richiedono dati al secondo da un import .fit o dalla sincronizzazione con Strava."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen verloopgegevens. Beste inspanningen hebben gegevens per seconde nodig uit een .fit-import of Strava-synchronisatie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem registos contínuos. Os melhores esforços precisam de dados ao segundo de uma importação .fit ou da sincronização com o Strava."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze brak ciągłych zapisów. Najlepsze wysiłki wymagają danych co sekundę z importu .fit albo synchronizacji ze Stravą."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga dataströmmar ännu. Bästa insatser kräver data per sekund från en .fit-import eller Strava-synk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続データがまだありません。ベスト記録には .fit の読み込みか Strava 同期による秒単位データが必要です。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dataforløb endnu. Bedste indsatser kræver data pr. sekund fra en .fit-import eller Strava-synkronisering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dataforløp ennå. Beste innsatser krever data per sekund fra en .fit-import eller Strava-synkronisering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä datavirtoja. Parhaat suoritukset vaativat sekuntikohtaista dataa .fit-tuonnista tai Strava-synkronoinnista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné záznamy. Nejlepší výkony potřebují data po sekundách z importu .fit nebo ze synchronizace se Stravou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kayıt verisi yok. En iyi performanslar için .fit içe aktarımından veya Strava eşitlemesinden gelen saniyelik veri gerekir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записей пока нет. Для лучших отрезков нужны посекундные данные из импорта .fit или синхронизации со Strava."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записів поки немає. Для найкращих відрізків потрібні посекундні дані з імпорту .fit або синхронізації зі Strava."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 스트림 데이터가 없습니다. 최고 기록에는 .fit 가져오기나 Strava 동기화에서 오는 초 단위 데이터가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有数据流。最佳表现需要来自 .fit 导入或 Strava 同步的逐秒数据。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem séries de dados. Os melhores esforços precisam de dados segundo a segundo, de uma importação .fit ou da sincronização com o Strava."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تسجيلات بعد. تحتاج أفضل الجهود إلى بيانات لكل ثانية من استيراد ‎.fit أو مزامنة Strava."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία καταγραφή ακόμη. Οι καλύτερες επιδόσεις χρειάζονται δεδομένα ανά δευτερόλεπτο από εισαγωγή .fit ή συγχρονισμό με Strava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs adatsor. A legjobb teljesítményekhez másodpercenkénti adat kell .fit importból vagy Strava-szinkronból."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există înregistrări. Cele mai bune eforturi au nevoie de date secundă cu secundă dintr-un import .fit sau din sincronizarea cu Strava."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne záznamy. Najlepšie výkony potrebujú údaje po sekundách z importu .fit alebo zo synchronizácie so Stravou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaenkrat ni zapisov. Najboljši dosežki potrebujejo sekundne podatke iz uvoza .fit ali sinhronizacije s Stravo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema zapisa. Najbolji rezultati trebaju podatke po sekundi iz uvoza .fit ili sinkronizacije sa Stravom."
          }
        }
      }
    },
