    "That file isn't readable GPX.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този файл не е четим GPX."
          }
        },
        "de": {
          "stringUnit": {
