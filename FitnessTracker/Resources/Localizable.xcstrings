          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항입니다. 목표가 뜻하는 페이스를 보여 주는 데 쓰입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选填。用于显示该目标对应的配速。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Usado para mostrar o ritmo que a meta exige."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري. يُستخدم لعرض الوتيرة التي يتطلبها الهدف."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό. Χρησιμοποιείται για να δείξει τον ρυθμό που συνεπάγεται ο στόχος."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális. A célból következő tempó megjelenítéséhez használjuk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional. Se folosește pentru a arăta ritmul pe care îl presupune obiectivul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepovinné. Slúži na zobrazenie tempa, ktoré z cieľa vyplýva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobvezno. Uporablja se za prikaz tempa, ki ga cilj zahteva."
          }
        },
        "hr": {
