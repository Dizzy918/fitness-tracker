          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importér fra Sundhed eller lav en daglig status for at få en parathedsscore."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer fra Helse eller ta en daglig status for å få en beredskapsscore."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo Terveydestä tai tee päivittäinen kirjaus saadaksesi valmiuspisteet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naimportuj data ze Zdraví nebo udělej denní zápis, ať získáš skóre připravenosti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlık puanı almak için Sağlık'tan veri al ya da günlük kayıt gir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте из «Здоровья» или пройдите ежедневный опрос, чтобы получить оценку готовности."
