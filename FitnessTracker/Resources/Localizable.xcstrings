    "Most of those days have nothing planned, so this assumes you rest through them.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "През повечето от тези дни няма нищо планирано, затова се приема, че почиваш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den meisten dieser Tage ist nichts geplant — es wird also angenommen, dass du sie ruhst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de esos días no tienen nada planificado, así que esto asume que descansas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart de ces jours n'ont rien de prévu : on suppose donc que tu les passes au repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte di quei giorni non ha nulla in programma, quindi si presume che tu riposi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de meeste van die dagen staat niets gepland, dus hier wordt aangenomen dat je rust houdt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria desses dias não tem nada planeado, por isso assume-se que descansas."
          }
        }
      }
    },
