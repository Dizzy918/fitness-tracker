        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adskilt af kommaer. Valgfrit — bruges til søgning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skilt med komma. Valgfritt — brukes til søk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilkuilla eroteltuna. Valinnainen — käytetään hakuun."
