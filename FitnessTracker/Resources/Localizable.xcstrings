    "Need at least two road runs.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужни са поне две шосейни бягания."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens zwei Straßenläufe nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacen falta al menos dos carreras en asfalto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut au moins deux courses sur route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno due corse su strada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn minstens twee wegtrainingen nodig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São precisas pelo menos duas corridas em estrada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne są co najmniej dwa biegi po asfalcie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det krävs minst två löppass på väg."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロードのランが少なくとも 2 本必要です。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der skal være mindst to løbeture på vej."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det trengs minst to løpeøkter på vei."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan vähintään kaksi maantiejuoksua."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou potřeba aspoň dva silniční běhy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az iki asfalt koşusu gerekiyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно хотя бы две пробежки по асфальту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно щонайменше дві пробіжки по асфальту."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로드 러닝이 최소 두 번은 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要两次公路跑。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessárias pelo menos duas corridas de rua."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم جريتان على الأقل على الطريق."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειάζονται τουλάχιστον δύο τρεξίματα σε δρόμο."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legalább két országúti futás kell."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E nevoie de cel puțin două alergări pe șosea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Treba aspoň dva cestné behy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebna sta vsaj dva cestna teka."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebna su barem dva cestovna trčanja."
          }
        }
      }
    },
    "Needed to read workouts out of PDFs. Get a key from console.anthropic.com. Stored in the Keychain on this device — extraction calls the API directly, so the key stays local and usage is billed to your account.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен е, за да се четат тренировки от PDF. Вземи ключ от console.anthropic.com. Пази се в Keychain на това устройство — извличането вика API-то директно, така че ключът остава локален, а потреблението се таксува на твоя акаунт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig, um Einheiten aus PDFs zu lesen. Hol dir einen Schlüssel auf console.anthropic.com. Er wird im Schlüsselbund dieses Geräts gespeichert — das Auslesen ruft die API direkt auf, der Schlüssel bleibt also lokal und die Nutzung wird deinem Konto berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesaria para leer entrenamientos de PDF. Consigue una clave en console.anthropic.com. Se guarda en el Llavero de este dispositivo: la extracción llama a la API directamente, así que la clave se queda aquí y el consumo se factura a tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour lire des séances dans des PDF. Obtiens une clé sur console.anthropic.com. Elle est stockée dans le trousseau de cet appareil : l'extraction appelle l'API directement, la clé reste donc locale et la consommation est facturée à ton compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessaria per leggere allenamenti dai PDF. Ottieni una chiave su console.anthropic.com. Viene salvata nel portachiavi di questo dispositivo: l'estrazione chiama l'API direttamente, quindi la chiave resta locale e i consumi vengono addebitati al tuo account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodig om trainingen uit PDF's te lezen. Haal een sleutel op via console.anthropic.com. Hij wordt in de sleutelhanger van dit apparaat bewaard — het uitlezen roept de API rechtstreeks aan, dus de sleutel blijft lokaal en het verbruik gaat naar jouw account."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessária para ler treinos a partir de PDF. Obtém uma chave em console.anthropic.com. Fica guardada no porta-chaves deste dispositivo — a extração chama a API diretamente, por isso a chave fica local e o consumo é faturado à tua conta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebny do odczytu treningów z PDF-ów. Klucz pobierzesz na console.anthropic.com. Jest przechowywany w pęku kluczy tego urządzenia — odczyt woła API bezpośrednio, więc klucz zostaje lokalnie, a zużycie obciąża twoje konto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behövs för att läsa pass ur PDF:er. Hämta en nyckel på console.anthropic.com. Den sparas i nyckelringen på den här enheten — tolkningen anropar API:et direkt, så nyckeln stannar lokalt och förbrukningen debiteras ditt konto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF からワークアウトを読むために必要です。キーは console.anthropic.com で取得できます。このデバイスのキーチェーンに保存され、読み取りは API を直接呼ぶため、キーは端末内にとどまり、利用料はあなたのアカウントに請求されます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nødvendig for at læse træninger ud af PDF'er. Hent en nøgle på console.anthropic.com. Den gemmes i nøgleringen på denne enhed — udtrækket kalder API'et direkte, så nøglen bliver lokalt, og forbruget faktureres din konto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nødvendig for å lese økter ut av PDF-er. Hent en nøkkel på console.anthropic.com. Den lagres i nøkkelringen på denne enheten — uttrekket kaller API-et direkte, så nøkkelen blir værende lokalt og forbruket faktureres kontoen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan harjoitusten lukemiseen PDF-tiedostoista. Hanki avain osoitteesta console.anthropic.com. Se tallennetaan tämän laitteen avainnippuun — poiminta kutsuu rajapintaa suoraan, joten avain pysyy paikallisena ja käyttö laskutetaan tililtäsi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potřebný ke čtení tréninků z PDF. Klíč získáš na console.anthropic.com. Ukládá se do klíčenky tohoto zařízení — čtení volá API přímo, takže klíč zůstává lokálně a spotřeba se účtuje tvému účtu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF'lerden antrenman okumak için gerekli. Anahtarı console.anthropic.com adresinden al. Bu cihazın anahtar zincirinde saklanır — okuma doğrudan API'yi çağırır, yani anahtar yerelde kalır ve kullanım senin hesabına faturalanır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен для чтения тренировок из PDF. Ключ можно получить на console.anthropic.com. Хранится в связке ключей этого устройства — разбор обращается к API напрямую, поэтому ключ остаётся локальным, а расход списывается с вашего счёта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен для читання тренувань із PDF. Ключ можна отримати на console.anthropic.com. Зберігається у в’язці ключів цього пристрою — розбір звертається до API напряму, тож ключ лишається локальним, а витрати списуються з вашого рахунку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF에서 운동을 읽으려면 필요합니다. console.anthropic.com에서 키를 받으세요. 이 기기의 키체인에 저장되며, 추출은 API를 직접 호출하므로 키는 기기 안에 머물고 사용량은 본인 계정으로 청구됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 PDF 读取训练时需要。可在 console.anthropic.com 获取密钥。密钥存放在本设备的钥匙串中——解析会直接调用 API，因此密钥留在本地，用量计入你的账户。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessária para ler treinos em PDFs. Obtenha uma chave em console.anthropic.com. Fica guardada nas Chaves deste dispositivo — a extração chama a API direto, então a chave permanece local e o uso é cobrado na sua conta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لازم لقراءة التمارين من ملفات PDF. احصل على مفتاح من console.anthropic.com. يُخزَّن في سلسلة المفاتيح على هذا الجهاز — ويستدعي الاستخراج الواجهة مباشرة، فيبقى المفتاح محليًا ويُحتسب الاستخدام على حسابك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται για την ανάγνωση προπονήσεων από PDF. Πάρε κλειδί από το console.anthropic.com. Αποθηκεύεται στο Keychain αυτής της συσκευής — η εξαγωγή καλεί απευθείας το API, οπότε το κλειδί μένει τοπικά και η χρέωση πάει στον λογαριασμό σου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzések PDF-ből való kiolvasásához kell. Kulcsot a console.anthropic.com oldalon szerezhetsz. Az eszköz kulcstartójában tárolódik — a kinyerés közvetlenül az API-t hívja, így a kulcs helyben marad, a használatot pedig a te fiókodra számolják."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesară pentru citirea antrenamentelor din PDF-uri. Obții o cheie de la console.anthropic.com. Se păstrează în Keychain-ul acestui dispozitiv — extragerea apelează API-ul direct, așa că cheia rămâne locală, iar consumul se facturează contului tău."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebný na čítanie tréningov z PDF. Kľúč získaš na console.anthropic.com. Ukladá sa do kľúčenky tohto zariadenia — čítanie volá API priamo, takže kľúč zostáva lokálne a spotreba sa účtuje tvojmu účtu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreben za branje treningov iz PDF. Ključ dobiš na console.anthropic.com. Shrani se v ključavnico te naprave — branje kliče API neposredno, zato ključ ostane lokalno, poraba pa se zaračuna tvojemu računu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potreban za čitanje treninga iz PDF-ova. Ključ dobiješ na console.anthropic.com. Sprema se u Keychain ovog uređaja — čitanje zove API izravno, pa ključ ostaje lokalno, a potrošnja se naplaćuje tvom računu."
          }
        }
      }
    },
    "Needs rides with a power meter. Power comes from a .fit import or a synced activity with streams.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужни са каране с измервател на мощност. Мощността идва от .fit импорт или синхронизирана активност с потоци."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt Radeinheiten mit Leistungsmesser. Leistung kommt aus einem .fit-Import oder einer synchronisierten Aktivität mit Datenströmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere salidas con potenciómetro. La potencia viene de una importación .fit o de una actividad sincronizada con registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite des sorties avec capteur de puissance. La puissance provient d'un import .fit ou d'une activité synchronisée avec relevés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono uscite con misuratore di potenza. La potenza arriva da un import .fit o da un'attività sincronizzata con i tracciati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist ritten met een vermogensmeter. Vermogen komt uit een .fit-import of een gesynchroniseerde activiteit met verlopen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de saídas com medidor de potência. A potência vem de uma importação .fit ou de uma atividade sincronizada com registos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga jazd z pomiarem mocy. Moc pochodzi z importu .fit albo zsynchronizowanej aktywności z zapisami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver cykelpass med effektmätare. Effekten kommer från en .fit-import eller en synkad aktivitet med dataströmmar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パワーメーター付きのライドが必要です。パワーは .fit の読み込みか、連続データ付きの同期アクティビティから得られます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræver ture med powermeter. Effekten kommer fra en .fit-import eller en synkroniseret aktivitet med dataforløb."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krever økter med wattmåler. Watt kommer fra en .fit-import eller en synkronisert aktivitet med dataforløp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatii ajoja tehomittarilla. Teho tulee .fit-tuonnista tai synkronoidusta suorituksesta, jossa on datavirrat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje jízdy s wattmetrem. Výkon pochází z importu .fit nebo ze synchronizované aktivity se záznamy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç ölçerli sürüşler gerekir. Güç, bir .fit içe aktarımından veya kayıtları olan eşitlenmiş bir etkinlikten gelir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны велотренировки с измерителем мощности. Мощность берётся из импорта .fit или синхронизированной активности с записями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібні велотренування з вимірювачем потужності. Потужність береться з імпорту .fit або синхронізованої активності із записами."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파워미터로 기록한 라이딩이 필요합니다. 파워는 .fit 가져오기나 스트림이 있는 동기화 활동에서 옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要带功率计的骑行。功率来自 .fit 导入或带数据流的同步活动。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige pedais com medidor de potência. A potência vem de uma importação .fit ou de uma atividade sincronizada com séries de dados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب ركوبًا بمقياس قدرة. تأتي القدرة من استيراد ‎.fit أو نشاط مُزامَن يحتوي تسجيلات."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρειάζεται ποδηλασίες με μετρητή ισχύος. Η ισχύς προέρχεται από εισαγωγή .fit ή συγχρονισμένη δραστηριότητα με καταγραφές."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Teljesítménymérős kerékpározás kell hozzá. A teljesítmény .fit importból vagy adatsorokat tartalmazó szinkronizált tevékenységből érkezik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt necesare ture cu powermetru. Puterea vine dintr-un import .fit sau dintr-o activitate sincronizată cu înregistrări."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje jazdy s wattmetrom. Výkon pochádza z importu .fit alebo zo synchronizovanej aktivity so záznamami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebuje vožnje z merilnikom moči. Moč pride iz uvoza .fit ali iz sinhronizirane aktivnosti z zapisi."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebne su vožnje s mjeračem snage. Snaga dolazi iz uvoza .fit ili iz sinkronizirane aktivnosti sa zapisima."
          }
        }
      }
    },
