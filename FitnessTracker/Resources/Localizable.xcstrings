          "stringUnit": {
            "state": "translated",
            "value": "Diżakkoppjar ajrobiku %@ fil-mija, %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有酸素デカップリング %@ パーセント、%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유산소 디커플링 %@ 퍼센트, %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有氧解耦 %@%%，%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانفصال الهوائي %@ بالمئة، %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有氧解耦 %@%%，%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Decoupling aerobik %@ persen, %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyahgandingan aerobik %@ peratus, %@"
          }
        },
        "vi": {
          "stringUnit": {
