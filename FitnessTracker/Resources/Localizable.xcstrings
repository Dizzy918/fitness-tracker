    "No efforts long enough to read a threshold from yet. These need a 20-minute stretch of recorded power or heart rate.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма достатъчно дълги усилия, от които да се отчете праг. Нужни са 20 минути непрекъснато записана мощност или пулс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Belastungen lang genug, um eine Schwelle abzulesen. Dafür brauchst du 20 zusammenhängende Minuten aufgezeichneter Leistung oder Herzfrequenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay esfuerzos lo bastante largos para leer un umbral. Hacen falta 20 minutos seguidos de potencia o frecuencia cardíaca registradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'efforts assez longs pour en lire un seuil. Il faut 20 minutes d'affilée de puissance ou de fréquence cardiaque enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora sforzi abbastanza lunghi per ricavarne una soglia. Servono 20 minuti consecutivi di potenza o frequenza cardiaca registrate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen inspanningen lang genoeg om er een drempel uit te lezen. Daarvoor is 20 minuten aaneengesloten vastgelegd vermogen of hartslag nodig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há esforços suficientemente longos para daí ler um limiar. São precisos 20 minutos seguidos de potência ou frequência cardíaca registadas."
