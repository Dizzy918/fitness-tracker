    "Everything else — arms, calves, rehab": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко останало — ръце, прасци, рехабилитация"
          }
        },
        "de": {
