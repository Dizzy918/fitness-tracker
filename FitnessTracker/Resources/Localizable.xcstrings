    "iCloud sync isn't available, so everything is stored on this device. %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизацията с iCloud не е достъпна, затова всичко се съхранява на това устройство. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Synchronisierung ist nicht verfügbar, alles wird also auf diesem Gerät gespeichert. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud no está disponible, así que todo se guarda en este dispositivo. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud n'est pas disponible : tout est donc stocké sur cet appareil. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud non è disponibile, quindi tutto è salvato su questo dispositivo. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie is niet beschikbaar, dus alles wordt op dit apparaat bewaard. %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com o iCloud não está disponível, por isso tudo é guardado neste dispositivo. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja z iCloud jest niedostępna, więc wszystko jest zapisane na tym urządzeniu. %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synk är inte tillgänglig, så allt lagras på den här enheten. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期は利用できないため、すべてこのデバイスに保存されます。%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronisering er ikke tilgængelig, så alt gemmes på denne enhed. %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronisering er ikke tilgjengelig, så alt lagres på denne enheten. %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synkronointi ei ole käytettävissä, joten kaikki tallennetaan tähän laitteeseen. %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace s iCloudem není dostupná, takže se všechno ukládá do tohoto zařízení. %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud eşitlemesi kullanılamıyor, bu yüzden her şey bu cihazda saklanıyor. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с iCloud недоступна, поэтому всё хранится на этом устройстве. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація з iCloud недоступна, тож усе зберігається на цьому пристрої. %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화를 쓸 수 없어 모든 데이터가 이 기기에 저장됩니다. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步不可用，因此所有数据都存在本设备上。%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com o iCloud não está disponível, então tudo fica guardado neste dispositivo. %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة iCloud غير متاحة، لذا يُخزَّن كل شيء على هذا الجهاز. %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συγχρονισμός με iCloud δεν είναι διαθέσιμος, οπότε όλα αποθηκεύονται σε αυτή τη συσκευή. %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-szinkronizálás nem érhető el, ezért minden ezen az eszközön tárolódik. %@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizarea cu iCloud nu e disponibilă, așa că totul e stocat pe acest dispozitiv. %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizácia s iCloudom nie je dostupná, takže všetko sa ukladá do tohto zariadenia. %@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacija z iCloudom ni na voljo, zato je vse shranjeno v tej napravi. %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija s iCloudom nije dostupna, pa je sve pohranjeno na ovom uređaju. %@"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизација са iCloud-ом није доступна, па је све сачувано на овом уређају. %@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudi sünkroonimine pole saadaval, seega on kõik salvestatud sellesse seadmesse. %@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sinhronizācija nav pieejama, tāpēc viss tiek glabāts šajā ierīcē. %@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sinchronizavimas nepasiekiamas, todėl viskas saugoma šiame įrenginyje. %@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronització amb iCloud no està disponible, així que tot es guarda en aquest dispositiu. %@"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-samstilling er ekki í boði, svo allt er geymt í þessu tæki. %@"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizimi me iCloud nuk është i disponueshëm, prandaj gjithçka ruhet në këtë pajisje. %@"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизацијата со iCloud не е достапна, па сè се чува на овој уред. %@"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl sioncronú iCloud ar fáil, mar sin stóráiltear gach rud ar an ngléas seo. %@"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Is-sinkronizzazzjoni ma' iCloud mhijiex disponibbli, għalhekk kollox jinħażen fuq dan l-apparat. %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步無法使用，因此所有資料都存在本裝置上。%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi iCloud tidak tersedia, jadi semuanya disimpan di perangkat ini. %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyegerakan iCloud tidak tersedia, jadi semuanya disimpan pada peranti ini. %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ iCloud không khả dụng, nên mọi thứ được lưu trên thiết bị này. %@"
          }
        }
      }
    },
