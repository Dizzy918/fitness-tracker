    "Check each row against the PDF before importing — extraction can misread tables.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Провери всеки ред спрямо PDF-а преди импортиране — извличането може да разчете таблиците погрешно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe jede Zeile vor dem Import gegen das PDF — die Erkennung kann Tabellen falsch lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba cada fila con el PDF antes de importar: la extracción puede leer mal las tablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie chaque ligne avec le PDF avant d'importer : l'extraction peut mal lire les tableaux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla ogni riga con il PDF prima di importare: l'estrazione può leggere male le tabelle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer elke regel met de PDF voordat je importeert — het uitlezen kan tabellen verkeerd interpreteren."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Confere cada linha com o PDF antes de importar — a extração pode ler mal as tabelas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź każdy wiersz z PDF-em przed importem — odczyt może źle zinterpretować tabele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera varje rad mot PDF:en innan du importerar — tolkningen kan läsa tabeller fel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取りは表を誤認することがあります。取り込む前に各行を PDF と照合してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek hver række mod PDF'en, før du importerer — udtrækket kan læse tabeller forkert."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk hver rad mot PDF-en før du importerer — uttrekket kan lese tabeller feil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista jokainen rivi PDF:ää vasten ennen tuontia — poiminta voi lukea taulukot väärin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před importem zkontroluj každý řádek proti PDF — čtení může tabulky přečíst špatně."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarmadan önce her satırı PDF ile karşılaştır — okuma sırasında tablolar yanlış anlaşılabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед импортом сверьте каждую строку с PDF — при разборе таблицы могут быть прочитаны неверно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед імпортом звіряйте кожен рядок із PDF — під час розбору таблиці можуть бути прочитані неправильно."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 전에 각 행을 PDF와 대조하세요 — 추출 과정에서 표를 잘못 읽을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入前请逐行与 PDF 核对——解析时可能读错表格。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira cada linha com o PDF antes de importar — a extração pode ler tabelas errado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع كل سطر مقابل ملف PDF قبل الاستيراد — قد يُخطئ الاستخراج في قراءة الجداول."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε κάθε γραμμή με το PDF πριν την εισαγωγή — η εξαγωγή μπορεί να διαβάσει λάθος τους πίνακες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálás előtt vesd össze minden sort a PDF-fel — a kinyerés félreolvashatja a táblázatokat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică fiecare rând cu PDF-ul înainte de import — extragerea poate citi greșit tabelele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred importom porovnaj každý riadok s PDF — čítanie môže zle prečítať tabuľky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred uvozom vsako vrstico primerjaj s PDF — branje lahko napačno prebere tabele."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije uvoza usporedi svaki redak s PDF-om — čitanje može krivo pročitati tablice."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пре увоза упореди сваки ред са PDF-ом — читање може погрешно да прочита табеле."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli enne importi iga rida PDF-i vastu — lugemine võib tabeleid valesti tõlgendada."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pirms importēšanas salīdzini katru rindu ar PDF — nolasīšana var kļūdīties tabulās."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieš importuodamas palygink kiekvieną eilutę su PDF — skaitymas gali neteisingai suprasti lenteles."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova cada fila amb el PDF abans d'importar: l'extracció pot llegir malament les taules."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Berðu hverja línu saman við PDF-skjalið áður en þú flytur inn — lesturinn getur mislesið töflur."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Krahaso çdo rresht me PDF-në përpara importimit — nxjerrja mund t'i lexojë gabim tabelat."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пред увоз спореди го секој ред со PDF-от — читањето може погрешно да ги прочита табелите."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiceáil gach ró in aghaidh an PDF sula n-iompórtálann tú — is féidir leis an sliocht táblaí a mhíléamh."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Qabbel kull ringiela mal-PDF qabel timporta — l-estrazzjoni tista' taqra t-tabelli ħażin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入前請逐列與 PDF 核對——解析時可能讀錯表格。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa tiap baris terhadap PDF sebelum mengimpor — ekstraksi bisa salah membaca tabel."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa setiap baris dengan PDF sebelum mengimport — pengekstrakan boleh tersalah baca jadual."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối chiếu từng dòng với PDF trước khi nhập — việc trích xuất có thể đọc sai bảng."
          }
        }
      }
    },
