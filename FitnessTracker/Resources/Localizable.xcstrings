    "Runs until you press lap on the watch.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Продължава, докато не натиснеш обиколка на часовника."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft, bis du auf der Uhr die Runde drückst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue hasta que pulses vuelta en el reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poursuit jusqu'à ce que tu appuies sur tour sur la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosegue finché non premi giro sull'orologio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt door tot je op je horloge op ronde drukt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua até carregares em volta no relógio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa, aż naciśniesz okrążenie na zegarku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätter tills du trycker varv på klockan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計でラップを押すまで続きます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsætter, indtil du trykker omgang på uret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetter til du trykker runde på klokka."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkuu, kunnes painat kellosta kierrosta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží, dokud na hodinkách nezmáčkneš okruh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatte tur düğmesine basana kadar sürer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт, пока вы не нажмёте «круг» на часах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває, доки ви не натиснете «коло» на годиннику."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계에서 랩 버튼을 누를 때까지 계속됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直进行，直到你在手表上按下分段键。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue até você apertar volta no relógio."
          }
        }
      }
    },
    "SWOLF adds length time and stroke count — lower means more efficient.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF събира времето за дължина и броя загребвания — по-ниско значи по-ефективно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF addiert Bahnzeit und Zugzahl — niedriger heißt effizienter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SWOLF suma el tiempo del largo y el número de brazadas: menos es más eficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le SWOLF additionne le temps de longueur et le nombre de mouvements : plus bas, plus efficace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo SWOLF somma il tempo della vasca e il numero di bracciate: più basso significa più efficiente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF telt baantijd en slagen bij elkaar op — lager betekent efficiënter."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O SWOLF soma o tempo da piscina e o número de braçadas — mais baixo significa mais eficiente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF sumuje czas długości i liczbę ruchów — niżej znaczy wydajniej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF adderar banlängdstid och antal simtag — lägre betyder effektivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF は 1 本のタイムとストローク数の合計です。低いほど効率的です。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF lægger banetid og antal tag sammen — lavere betyder mere effektivt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF legger sammen tiden på lengden og antall tak — lavere betyr mer effektivt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF laskee yhteen altaanvälin ajan ja vetojen määrän — pienempi on tehokkaampi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF sčítá čas na délku a počet záběrů — nižší znamená efektivnější."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF, kulvar süresi ile kulaç sayısını toplar — düşük olması daha verimli demektir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF складывает время отрезка и число гребков — чем меньше, тем эффективнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF додає час відрізка до кількості гребків — що менше, то ефективніше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF는 한 랩의 시간과 스트로크 수를 더한 값으로, 낮을수록 효율적입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF 是单程用时加划水次数——数值越低效率越高。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SWOLF soma o tempo da piscina com o número de braçadas — quanto menor, mais eficiente."
          }
        }
      }
    },
