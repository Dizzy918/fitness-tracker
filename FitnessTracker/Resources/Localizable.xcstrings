        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għad m'hemmx reġistrazzjonijiet. L-aħjar sforzi jeħtieġu data kull sekonda minn importazzjoni .fit jew mis-sinkronizzazzjoni ma' Strava."
