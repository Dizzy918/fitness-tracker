    "Most of those days have nothing planned, so this assumes you rest through them.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "През повечето от тези дни няма нищо планирано, затова се приема, че почиваш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den meisten dieser Tage ist nichts geplant — es wird also angenommen, dass du sie ruhst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de esos días no tienen nada planificado, así que esto asume que descansas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart de ces jours n'ont rien de prévu : on suppose donc que tu les passes au repos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte di quei giorni non ha nulla in programma, quindi si presume che tu riposi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de meeste van die dagen staat niets gepland, dus hier wordt aangenomen dat je rust houdt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria desses dias não tem nada planeado, por isso assume-se que descansas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W większości tych dni nic nie zaplanowano, więc przyjmuje się, że odpoczywasz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De flesta av de dagarna har inget inplanerat, så det här antar att du vilar då."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その大半の日は何も予定されていないため、休むものとして計算しています。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste af de dage har intet planlagt, så her antages det, at du hviler."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De fleste av de dagene har ingenting planlagt, så her antas det at du hviler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useimmille noista päivistä ei ole suunniteltu mitään, joten tässä oletetaan, että lepäät ne."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Většina těch dní nemá nic naplánováno, takže se předpokládá, že je proodpočíváš."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O günlerin çoğunda planlı bir şey yok, bu yüzden onları dinlenerek geçirdiğin varsayılıyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На большинстве этих дней ничего не запланировано, поэтому считается, что вы их отдыхаете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На більшості цих днів нічого не заплановано, тож вважається, що ви їх відпочиваєте."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 날들 대부분은 계획이 없어서, 쉬는 것으로 가정했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那些日子大多没有安排，因此默认你会一直休息。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria desses dias está sem nada planejado, então a conta assume que você vai descansar neles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معظم تلك الأيام بلا خطة، لذا يفترض الحساب أنك سترتاح فيها."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι περισσότερες από αυτές τις μέρες δεν έχουν κάτι προγραμματισμένο, οπότε θεωρείται ότι ξεκουράζεσαι."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azoknak a napoknak a többségére nincs semmi tervezve, ezért a számítás pihenéssel számol."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Majoritatea acelor zile nu au nimic planificat, așa că se presupune că te odihnești."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Väčšina tých dní nemá nič naplánované, takže sa predpokladá, že ich preoddychuješ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Večina teh dni nima nič načrtovanega, zato se predpostavlja, da počivaš."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Većina tih dana nema ništa planirano, pa se pretpostavlja da ih odmaraš."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Већина тих дана нема ништа планирано, па се претпоставља да их одмараш."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Enamikul neist päevadest pole midagi planeeritud, seega eeldatakse, et puhkad need läbi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lielākajai daļai šo dienu nekas nav ieplānots, tāpēc tiek pieņemts, ka tu tās atpūties."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Daugumai tų dienų nieko neplanuota, todėl daroma prielaida, kad jas ilsiesi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La majoria d'aquells dies no tenen res planificat, així que se suposa que descanses."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flestir þessara daga eru án áætlunar, svo gert er ráð fyrir að þú hvílir þig þá."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumica e atyre ditëve nuk kanë asgjë të planifikuar, prandaj supozohet se i pushon."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повеќето од тие денови немаат ништо планирано, па се претпоставува дека одмараш."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl aon rud pleanáilte don chuid is mó de na laethanta sin, mar sin glactar leis go nglacann tú scíth iontu."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Il-biċċa l-kbira ta' dawk il-ġranet m'għandhom xejn ippjanat, għalhekk qed jiġi preżunt li tistrieħ fihom."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那些日子大多沒有安排，因此預設你會一直休息。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian besar hari itu belum ada rencananya, jadi ini menganggap kamu beristirahat sepanjang hari-hari tersebut."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebanyakan hari itu tiada apa-apa yang dirancang, jadi ini menganggap anda berehat sepanjang hari-hari tersebut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần lớn những ngày đó chưa có gì trong kế hoạch, nên phép tính coi như bạn nghỉ suốt các ngày ấy."
          }
        }
      }
    },
