    "Affects display only. Your data is stored in metric and converted for display, so switching back and forth never changes a recorded value.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Влияе само на показването. Данните се пазят в метрични единици и се преобразуват за показване, така че превключването никога не променя записана стойност."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrifft nur die Anzeige. Deine Daten werden metrisch gespeichert und zur Anzeige umgerechnet — Umschalten ändert also nie einen aufgezeichneten Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo afecta a la presentación. Tus datos se guardan en métrico y se convierten para mostrarlos, así que cambiar de un sistema a otro nunca altera un valor registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'affecte que l'affichage. Tes données sont stockées en métrique et converties pour l'affichage : basculer d'un système à l'autre ne modifie jamais une valeur enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Influisce solo sulla visualizzazione. I dati sono salvati in metrico e convertiti per la visualizzazione, quindi passare da un sistema all'altro non cambia mai un valore registrato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft alleen invloed op de weergave. Je gegevens worden metrisch bewaard en voor weergave omgerekend, dus heen en weer schakelen verandert nooit een vastgelegde waarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Afeta apenas a apresentação. Os teus dados são guardados em métrico e convertidos para mostrar, por isso alternar nunca altera um valor registado."
          }
        }
      }
    },
