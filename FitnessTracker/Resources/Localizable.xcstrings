    "Mixed time and distance steps, so there's no single total until it's run.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Смесени стъпки по време и разстояние, така че няма общ сбор, докато не се изпълни."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemischte Zeit- und Distanzschritte — es gibt also keine Gesamtsumme, bis die Einheit gelaufen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos mezclados de tiempo y distancia, así que no hay un total único hasta hacerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étapes mêlant temps et distance : il n'y a pas de total unique avant de l'avoir faite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passi misti di tempo e distanza: non c'è un totale unico finché non la esegui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemengde tijd- en afstandsstappen, dus er is geen totaal tot je hem gedaan hebt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos que misturam tempo e distância, por isso não há um total único até a fazeres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroki mieszają czas i dystans, więc nie ma jednej sumy, dopóki jej nie wykonasz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandade tids- och distanssteg, så det finns ingen enda summa förrän passet är gjort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間と距離のステップが混在しているため、実施するまで合計は決まりません。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandede tids- og distancetrin, så der er ingen samlet sum, før passet er gennemført."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blandede tids- og distansesteg, så det finnes ingen samlet sum før økta er gjennomført."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekaisin aika- ja matkavaiheita, joten yhtä kokonaissummaa ei ole ennen suoritusta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroky mísí čas a vzdálenost, takže dokud trénink neproběhne, žádný jednotný součet není."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre ve mesafe adımları karışık, bu yüzden antrenman yapılana kadar tek bir toplam yok."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги смешивают время и дистанцию, поэтому единой суммы не будет, пока тренировка не выполнена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кроки змішують час і дистанцію, тож єдиної суми не буде, доки тренування не виконано."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 스텝과 거리 스텝이 섞여 있어, 실제로 해보기 전에는 하나의 합계가 나오지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步骤中时间与距离混用，因此在实际完成之前没有统一的总量。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As etapas misturam tempo e distância, então não há um total único até o treino ser feito."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطوات تمزج الزمن والمسافة، فلا يوجد إجمالي واحد قبل تنفيذها."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα βήματα αναμειγνύουν χρόνο και απόσταση, οπότε δεν υπάρχει ενιαίο σύνολο μέχρι να εκτελεστεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lépések időt és távot vegyítenek, így nincs egyetlen összeg, amíg le nem futod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pașii amestecă timp și distanță, așa că nu există un total unic până nu îl parcurgi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroky miešajú čas a vzdialenosť, takže kým tréning neprebehne, jednotný súčet nie je."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koraki mešajo čas in razdaljo, zato dokler treninga ne opraviš, enotne vsote ni."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koraci miješaju vrijeme i udaljenost, pa jedinstvenog zbroja nema dok se ne odradi."
          }
        }
      }
    },
