    "Quit and reopen the app to apply this.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Затвори и отвори приложението отново, за да се приложи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende die App und öffne sie neu, damit das wirksam wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la app y vuelve a abrirla para aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitte et rouvre l'app pour appliquer ce réglage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi e riapri l'app per applicarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de app af en open hem opnieuw om dit toe te passen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha e volta a abrir a app para aplicar isto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij i otwórz aplikację ponownie, aby to zastosować."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta och öppna appen igen för att tillämpa detta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反映するにはアプリを終了して開き直してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk appen og åbn den igen for at anvende dette."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt og åpne appen på nytt for å ta dette i bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulje ja avaa sovellus uudelleen ottaaksesi tämän käyttöön."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby se to projevilo, ukonči a znovu otevři aplikaci."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
