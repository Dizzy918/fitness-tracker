    "Couldn't snap that segment to a path — using a straight line.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсечката не можа да се захване за пътека — използва се права линия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Segment ließ sich an keinen Weg anlegen — es wird eine gerade Linie verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo ajustar ese tramo a un camino: se usa una línea recta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'aligner ce segment sur un chemin : une ligne droite est utilisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile agganciare quel tratto a un sentiero: si usa una linea retta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat segment kon niet op een pad worden vastgezet — er wordt een rechte lijn gebruikt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ajustar esse troço a um caminho — está a usar-se uma linha reta."
          }
        }
      }
    },
