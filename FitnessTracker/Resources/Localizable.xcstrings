          "stringUnit": {
            "state": "translated",
            "value": "Sluit de app af en open hem opnieuw om dit toe te passen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha e volta a abrir a app para aplicar isto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij i otwórz aplikację ponownie, aby to zastosować."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta och öppna appen igen för att tillämpa detta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反映するにはアプリを終了して開き直してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk appen og åbn den igen for at anvende dette."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt og åpne appen på nytt for å ta dette i bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulje ja avaa sovellus uudelleen ottaaksesi tämän käyttöön."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
