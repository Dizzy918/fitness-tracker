          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett videre til neste øvelse — pausen kommer på slutten av runden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoraan seuraavaan liikkeeseen — tauko tulee kierroksen lopussa."
          }
        },
        "cs": {
          "stringUnit": {
