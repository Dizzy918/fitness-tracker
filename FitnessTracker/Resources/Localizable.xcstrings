    "Derived from your best effort converted to a 10 km equivalent. A lab or field test would be more accurate.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изведено от най-доброто ти усилие, преобразувано към еквивалент на 10 км. Лабораторен или полеви тест би бил по-точен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeleitet aus deiner Bestleistung, umgerechnet auf ein 10-km-Äquivalent. Ein Labor- oder Feldtest wäre genauer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivado de tu mejor esfuerzo convertido a un equivalente de 10 km. Una prueba de laboratorio o de campo sería más precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déduit de ton meilleur effort converti en équivalent 10 km. Un test en laboratoire ou sur le terrain serait plus précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricavato dal tuo miglior sforzo convertito in un equivalente sui 10 km. Un test da laboratorio o sul campo sarebbe più preciso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgeleid van je beste inspanning, omgerekend naar een 10 km-equivalent. Een lab- of veldtest zou nauwkeuriger zijn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivado do teu melhor esforço convertido para um equivalente de 10 km. Um teste de laboratório ou de campo seria mais preciso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyprowadzone z twojego najlepszego wysiłku przeliczonego na ekwiwalent 10 km. Test laboratoryjny lub terenowy byłby dokładniejszy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Härlett ur din bästa insats omräknad till en 10 km-motsvarighet. Ett labb- eller fälttest skulle vara noggrannare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベスト記録を 10 km 相当に換算して求めています。ラボまたはフィールドテストのほうが正確です。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udledt af din bedste indsats omregnet til en 10 km-ækvivalent. En labora­torie- eller felttest ville være mere præcis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utledet av din beste innsats omregnet til en 10 km-ekvivalent. En lab- eller felttest ville vært mer nøyaktig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Johdettu parhaasta suorituksestasi muunnettuna 10 km:n vastineeksi. Laboratorio- tai kenttätesti olisi tarkempi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odvozeno z tvého nejlepšího výkonu přepočteného na ekvivalent 10 km. Laboratorní nebo terénní test by byl přesnější."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En iyi performansının 10 km eşdeğerine çevrilmesinden türetildi. Laboratuvar veya saha testi daha doğru olur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выведено из вашего лучшего отрезка, приведённого к эквиваленту 10 км. Лабораторный или полевой тест был бы точнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виведено з вашого найкращого відрізка, приведеного до еквівалента 10 км. Лабораторний чи польовий тест був би точнішим."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최고 기록을 10 km 환산값으로 바꿔 계산했습니다. 실험실이나 필드 테스트가 더 정확합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由你的最佳表现换算为 10 公里等效值推导而来。实验室或场地测试会更准确。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivado do seu melhor esforço convertido para um equivalente de 10 km. Um teste de laboratório ou de campo seria mais preciso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشتق من أفضل جهد لك بعد تحويله إلى ما يعادل 10 كم. اختبار مخبري أو ميداني سيكون أدق."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προκύπτει από την καλύτερη επίδοσή σου μετατρεπόμενη σε ισοδύναμο 10 χλμ. Ένα εργαστηριακό ή επιτόπιο τεστ θα ήταν ακριβέστερο."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legjobb teljesítményedből származtatva, 10 km-es megfelelőre átszámítva. Egy labor- vagy terepteszt pontosabb lenne."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivat din cel mai bun efort al tău, convertit într-un echivalent de 10 km. Un test de laborator sau de teren ar fi mai exact."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odvodené z tvojho najlepšieho výkonu prepočítaného na ekvivalent 10 km. Laboratórny alebo terénny test by bol presnejší."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izpeljano iz tvojega najboljšega dosežka, pretvorjenega v ekvivalent 10 km. Laboratorijski ali terenski test bi bil natančnejši."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvedeno iz tvog najboljeg rezultata pretvorenog u ekvivalent od 10 km. Laboratorijski ili terenski test bio bi točniji."
          }
        }
      }
    },
