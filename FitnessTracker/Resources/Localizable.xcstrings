    "Plan a route on the map, or import a GPX file. Export sends it to your watch.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Планирай маршрут на картата или импортирай GPX файл. Експортът го изпраща към часовника ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane eine Route auf der Karte oder importiere eine GPX-Datei. Der Export schickt sie an deine Uhr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica una ruta en el mapa o importa un archivo GPX. Exportar la envía a tu reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace un itinéraire sur la carte, ou importe un fichier GPX. L'export l'envoie à ta montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia un percorso sulla mappa o importa un file GPX. L'esportazione lo invia al tuo orologio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan een route op de kaart, of importeer een GPX-bestand. Exporteren stuurt hem naar je horloge."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeia um percurso no mapa, ou importa um ficheiro GPX. Exportar envia-o para o teu relógio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanuj trasę na mapie albo zaimportuj plik GPX. Eksport wysyła ją na zegarek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planera en rutt på kartan, eller importera en GPX-fil. Exporten skickar den till klockan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図上でルートを引くか、GPX ファイルを読み込んでください。書き出すと時計へ送れます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlæg en rute på kortet, eller importér en GPX-fil. Eksport sender den til dit ur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlegg en rute på kartet, eller importer en GPX-fil. Eksport sender den til klokka."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnittele reitti kartalla tai tuo GPX-tiedosto. Vienti lähettää sen kelloosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naplánuj trasu v mapě nebo naimportuj soubor GPX. Export ji pošle do hodinek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haritada bir rota planla ya da bir GPX dosyası içe aktar. Dışa aktarma onu saatine gönderir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проложите маршрут на карте или импортируйте файл GPX. Экспорт отправит его на часы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокладіть маршрут на карті або імпортуйте файл GPX. Експорт надішле його на годинник."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도에서 경로를 그리거나 GPX 파일을 가져오세요. 내보내기로 시계에 보낼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在地图上规划路线，或导入 GPX 文件。导出即可发送到手表。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje uma rota no mapa ou importe um arquivo GPX. A exportação envia para o seu relógio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطّط مسارًا على الخريطة، أو استورد ملف GPX. ويرسله التصدير إلى ساعتك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδίασε μια διαδρομή στον χάρτη ή εισήγαγε ένα αρχείο GPX. Η εξαγωγή τη στέλνει στο ρολόι σου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervezz útvonalat a térképen, vagy importálj egy GPX-fájlt. Az exportálás elküldi az órádra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifică un traseu pe hartă sau importă un fișier GPX. Exportul îl trimite pe ceas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Naplánuj trasu na mape alebo importuj súbor GPX. Export ju pošle do hodiniek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Načrtuj pot na zemljevidu ali uvozi datoteko GPX. Izvoz jo pošlje na tvojo uro."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isplaniraj rutu na karti ili uvezi datoteku GPX. Izvoz je šalje na tvoj sat."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Испланирај руту на мапи или увези датотеку GPX. Извоз је шаље на твој сат."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeeri marsruut kaardil või impordi GPX-fail. Eksport saadab selle su kellale."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izplāno maršrutu kartē vai importē GPX failu. Eksports to nosūta uz tavu pulksteni."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suplanuok maršrutą žemėlapyje arba importuok GPX failą. Eksportas nusiunčia jį į tavo laikrodį."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica una ruta al mapa o importa un fitxer GPX. L'exportació l'envia al teu rellotge."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipuleggðu leið á kortinu eða flyttu inn GPX-skrá. Útflutningur sendir hana í úrið þitt."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiko një itinerar në hartë ose importo një skedar GPX. Eksporti e dërgon te ora jote."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Испланирај траса на мапата или увези GPX-датотека. Извозот ја испраќа на твојот часовник."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Pleanáil bealach ar an léarscáil, nó iompórtáil comhad GPX. Seolann an easpórtáil chuig d'uaireadóir é."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ippjana rotta fuq il-mappa, jew importa fajl GPX. L-esportazzjoni tibgħatha lill-arloġġ tiegħek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在地圖上規劃路線，或匯入 GPX 檔案。匯出即可傳送到手錶。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencanakan rute di peta, atau impor file GPX. Ekspor mengirimkannya ke jammu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rancang laluan pada peta, atau import fail GPX. Eksport menghantarnya ke jam anda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ lộ trình trên bản đồ, hoặc nhập một tệp GPX. Xuất ra là gửi được sang đồng hồ của bạn."
          }
        }
      }
    },
