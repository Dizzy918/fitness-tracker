          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικό. Χρησιμοποιείται για να δείξει τον ρυθμό που συνεπάγεται ο στόχος."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális. A célból következő tempó megjelenítéséhez használjuk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional. Se folosește pentru a arăta ritmul pe care îl presupune obiectivul."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepovinné. Slúži na zobrazenie tempa, ktoré z cieľa vyplýva."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobvezno. Uporablja se za prikaz tempa, ki ga cilj zahteva."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezno. Koristi se za prikaz tempa koji cilj podrazumijeva."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Необавезно. Користи се за приказ темпа који циљ подразумева."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vabatahtlik. Kasutatakse selleks, et näidata eesmärgist tulenevat tempot."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobligāti. Izmanto, lai parādītu tempu, ko paredz mērķis."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprivaloma. Naudojama parodyti tempą, kurio reikalauja tikslas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. S'utilitza per mostrar el ritme que implica l'objectiu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfrjálst. Notað til að sýna hraðann sem markmiðið krefst."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsionale. Përdoret për të treguar ritmin që kërkon objektivi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изборно. Се користи за да се прикаже темпото што целта го подразбира."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnach. Úsáidtear é chun an luas a thugann an sprioc le fios a thaispeáint."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fakultattiv. Jintuża biex jintwera l-pass li timplika l-mira."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。用來顯示該目標對應的配速。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsional. Dipakai untuk menampilkan pace yang tersirat dari target itu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan. Digunakan untuk menunjukkan pace yang tersirat daripada sasaran itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc. Dùng để hiển thị pace mà mục tiêu đó ngụ ý."
          }
        }
      }
    },
