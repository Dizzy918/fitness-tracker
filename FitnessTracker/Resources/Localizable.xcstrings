    "There's nothing to sign up for and nowhere for your training to go. It lives in a database on this device, and in a backup if you make one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nichts zu registrieren und keinen Ort, an den dein Training abfließen könnte. Es liegt in einer Datenbank auf diesem Gerät — und in einem Backup, falls du eines anlegst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a aucune inscription et nulle part où votre entraînement puisse partir. Il vit dans une base de données sur cet appareil, et dans une sauvegarde si vous en faites une."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada a lo que registrarse ni sitio al que pueda irse tu entrenamiento. Vive en una base de datos de este dispositivo y, si haces una, en una copia de seguridad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è niente a cui iscriversi né un posto dove il tuo allenamento possa finire. Vive in un database su questo dispositivo e, se ne fai uno, in un backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er valt niets aan te melden en er is nergens waar je training heen kan. Ze staat in een database op dit apparaat, en in een reservekopie als je die maakt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada em que se inscrever nem para onde o seu treino possa ir. Vive numa base de dados neste dispositivo e, se fizer uma, numa cópia de segurança."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há cadastro nenhum nem para onde seu treino possa ir. Ele vive em um banco de dados neste dispositivo e, se você fizer um, em um backup."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma się gdzie rejestrować ani dokąd twój trening miałby trafić. Mieszka w bazie danych na tym urządzeniu, a jeśli zrobisz kopię zapasową — także w niej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget att registrera sig för och ingenstans för din träning att ta vägen. Den bor i en databas på den här enheten, och i en säkerhetskopia om du gör en."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet at melde sig til og ingen steder, din træning kan tage hen. Den bor i en database på denne enhed — og i en sikkerhedskopi, hvis du laver en."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingenting å registrere seg for og ingen steder treningen din kan ta veien. Den bor i en database på denne enheten, og i en sikkerhetskopi om du lager en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mihinkään ei tarvitse rekisteröityä eikä harjoittelullasi ole minne mennä. Se on tietokannassa tällä laitteella — ja varmuuskopiossa, jos sellaisen teet."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма за какво да се регистрираш и няма къде да отидат тренировките ти. Те живеят в база данни на това устройство — и в резервно копие, ако си направиш такова."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není se kam registrovat a tvůj trénink nemá kam odejít. Žije v databázi v tomhle zařízení — a v záloze, pokud si ji uděláš."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録するものは何もなく、トレーニングの行き先もありません。この端末のデータベースにあり、バックアップを取ればその中にもあります。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydolunacak bir şey yok, antrenmanının gidebileceği bir yer de. Bu cihazdaki bir veritabanında yaşar; bir yedek alırsan onun içinde de."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрироваться негде, и вашим тренировкам некуда уйти. Они живут в базе данных на этом устройстве — и в резервной копии, если вы её сделаете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Реєструватися ніде, і вашим тренуванням нікуди йти. Вони живуть у базі даних на цьому пристрої — і в резервній копії, якщо ви її зробите."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가입할 것도 없고 당신의 훈련이 흘러갈 곳도 없습니다. 이 기기의 데이터베이스에, 그리고 백업을 만든다면 그 안에 머뭅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账号要注册，你的训练也无处可去。它存在这台设备的数据库里；如果你做了备份，也在备份里。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء تسجّل فيه ولا مكان يذهب إليه تدريبك. فهو يعيش في قاعدة بيانات على هذا الجهاز، وفي نسخة احتياطية إن أنشأت واحدة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει εγγραφή πουθενά και κανένα μέρος για να πάει η προπόνησή σου. Ζει σε μια βάση δεδομένων σε αυτή τη συσκευή — και σε ένα αντίγραφο ασφαλείας, αν φτιάξεις ένα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs hova regisztrálni, és az edzésednek sincs hova mennie. Egy adatbázisban él ezen az eszközön — és egy biztonsági mentésben, ha készítesz olyat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ai unde să te înregistrezi și antrenamentul tău nu are unde să plece. Trăiește într-o bază de date pe acest dispozitiv — și într-o copie de rezervă, dacă faci una."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie je sa kam registrovať a tvoj tréning nemá kam odísť. Žije v databáze v tomto zariadení — a v zálohe, ak si ju urobíš."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni se kam registrirati in tvoj trening nima kam oditi. Živi v bazi podatkov na tej napravi — in v varnostni kopiji, če jo narediš."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema se gdje registrirati i tvoj trening nema kamo otići. Živi u bazi podataka na ovom uređaju — i u sigurnosnoj kopiji, ako je napraviš."
          }
        }
      }
    },
    "Thigh (L)": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бедро (Л)"
          }
