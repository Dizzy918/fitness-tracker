    },
    "Each site is compared between its own first and last reading in the window — you probably measure your waist more often than your calves.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко място се сравнява между собственото си първо и последно измерване в периода — вероятно мериш талията си по-често от прасците."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stelle wird zwischen ihrem eigenen ersten und letzten Messwert im Zeitraum verglichen — die Taille misst du vermutlich öfter als die Waden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada punto se compara entre su primera y su última medida dentro del periodo: probablemente mides la cintura más a menudo que los gemelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque point est comparé entre sa première et sa dernière mesure sur la période : tu mesures sans doute ta taille plus souvent que tes mollets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni punto viene confrontato tra la sua prima e la sua ultima misura nel periodo: probabilmente misuri la vita più spesso dei polpacci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk punt wordt vergeleken tussen zijn eigen eerste en laatste meting in de periode — je meet je taille waarschijnlijk vaker dan je kuiten."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ponto é comparado entre a sua primeira e a sua última medida no período — provavelmente medes a cintura mais vezes do que os gémeos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde miejsce porównuje się między własnym pierwszym a ostatnim pomiarem w okresie — talię mierzysz pewnie częściej niż łydki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje ställe jämförs mellan sin egen första och sista mätning i perioden — du mäter nog midjan oftare än vaderna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各部位はその部位自身の期間内の最初と最後の計測値で比較します。ウエストはふくらはぎより頻繁に測るはずです。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert sted sammenlignes mellem sin egen første og sidste måling i perioden — du måler nok taljen oftere end læggene."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert sted sammenlignes mellom sin egen første og siste måling i perioden — du måler nok livet oftere enn leggene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutakin kohtaa verrataan sen omaan ensimmäiseen ja viimeiseen mittaukseen jaksolla — mittaat vyötärön luultavasti useammin kuin pohkeet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé místo se porovnává mezi svým prvním a posledním měřením v období — pas si nejspíš měříš častěji než lýtka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bölge, bu aralıktaki kendi ilk ve son ölçümü arasında karşılaştırılır — muhtemelen belini baldırlarından daha sık ölçüyorsun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая зона сравнивается между своим первым и последним замером за период — талию вы, скорее всего, измеряете чаще, чем голени."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна зона порівнюється між своїм першим і останнім заміром за період — талію ви, найімовірніше, міряєте частіше, ніж гомілки."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 부위는 해당 기간의 첫 측정값과 마지막 측정값끼리 비교합니다 — 보통 허리를 종아리보다 자주 재니까요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个部位都在该时段内用自己的首次与末次测量值比较——毕竟量腰围多半比量小腿勤。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ponto é comparado entre a primeira e a última medição dele no período — você provavelmente mede a cintura com mais frequência do que as panturrilhas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقارَن كل موضع بين أول وآخر قياس له في الفترة — غالبًا تقيس خصرك أكثر مما تقيس سمانتيك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε σημείο συγκρίνεται ανάμεσα στην πρώτη και την τελευταία δική του μέτρηση στην περίοδο — μάλλον μετράς τη μέση σου πιο συχνά από τις γάμπες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden testtájat a saját első és utolsó mérése között hasonlítunk össze az időszakon belül — a derekadat valószínűleg gyakrabban méred, mint a vádlidat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare zonă se compară între prima și ultima ei măsurătoare din perioadă — probabil îți măsori talia mai des decât gambele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé miesto sa porovnáva medzi svojím prvým a posledným meraním v danom období — pás si asi meriaš častejšie než lýtka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako mesto se primerja med svojo prvo in zadnjo meritvijo v obdobju — pas verjetno meriš pogosteje kot meča."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako se mjesto uspoređuje između svog prvog i zadnjeg mjerenja u razdoblju — struk vjerojatno mjeriš češće od listova."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Свако место се пореди између свог првог и последњег мерења у периоду — струк вероватно мериш чешће од листова."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga kohta võrreldakse selle enda esimese ja viimase mõõtmise vahel perioodis — vööd mõõdad ilmselt sagedamini kui säärt."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katra vieta tiek salīdzināta starp savu pirmo un pēdējo mērījumu periodā — vidukli tu droši vien mēri biežāk nekā ikrus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekviena vieta lyginama tarp savo pirmojo ir paskutiniojo matavimo per laikotarpį — liemenį tikriausiai matuoji dažniau nei blauzdas."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada zona es compara entre la seva primera i la seva darrera mesura del període: segurament et mesures la cintura més sovint que els bessons."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver staður er borinn saman milli fyrstu og síðustu mælingar sinnar á tímabilinu — þú mælir sennilega mittið oftar en kálfana."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo vend krahasohet mes matjes së parë dhe të fundit të vet brenda periudhës — ndoshta belin e mat më shpesh se pulpat."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секое место се споредува меѓу своето прво и последно мерење во периодот — струкот веројатно го мериш почесто од листовите."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Déantar gach suíomh a chur i gcomparáid idir a chéad léamh agus a léamh deireanach féin sa tréimhse — is dócha go dtomhaiseann tú do choim níos minice ná do cholpaí."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kull post jitqabbel bejn l-ewwel u l-aħħar kejl tiegħu stess f'dan il-perjodu — x'aktarx tkejjel il-qadd aktar spiss mill-pexxuni."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個部位都在此期間內用自己的第一次與最後一次量測值比較——畢竟量腰圍多半比量小腿勤。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiap bagian dibandingkan antara pengukuran pertama dan terakhirnya sendiri dalam rentang ini — kamu mungkin mengukur pinggang lebih sering daripada betis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap bahagian dibandingkan antara bacaan pertama dan terakhirnya sendiri dalam julat ini — anda mungkin mengukur pinggang lebih kerap daripada betis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi vị trí được so giữa lần đo đầu và lần đo cuối của chính nó trong khoảng này — chắc bạn đo vòng eo thường xuyên hơn đo bắp chân."
          }
        }
      }
    },
