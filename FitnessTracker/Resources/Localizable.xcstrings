    "Training load, fitness and fatigue, intensity distribution, thresholds estimated from what you've actually done.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsbelastung, Fitness und Ermüdung, Intensitätsverteilung, Schwellen geschätzt aus dem, was du tatsächlich trainiert hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge d'entraînement, forme et fatigue, répartition des intensités, seuils estimés à partir de ce que vous avez réellement fait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga de entrenamiento, forma y fatiga, distribución de intensidad y umbrales estimados a partir de lo que realmente has hecho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carico di allenamento, forma e fatica, distribuzione dell'intensità, soglie stimate da ciò che hai davvero fatto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsbelasting, fitheid en vermoeidheid, intensiteitsverdeling, drempels geschat uit wat je werkelijk hebt gedaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga de treino, forma e fadiga, distribuição de intensidade, limiares estimados a partir do que realmente fez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga de treino, forma e fadiga, distribuição de intensidade, limiares estimados a partir do que você realmente fez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obciążenie treningowe, forma i zmęczenie, rozkład intensywności, progi oszacowane z tego, co naprawdę zrobiłeś."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Träningsbelastning, form och trötthet, intensitetsfördelning och trösklar skattade utifrån vad du faktiskt gjort."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træningsbelastning, form og træthed, intensitetsfordeling og tærskler anslået ud fra det, du faktisk har lavet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treningsbelastning, form og tretthet, intensitetsfordeling og terskler anslått ut fra det du faktisk har gjort."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjoituskuorma, kunto ja väsymys, tehojakauma sekä kynnykset arvioituna siitä, mitä olet oikeasti tehnyt."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировъчно натоварване, форма и умора, разпределение на интензивността и прагове, оценени от това, което наистина си правил."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tréninková zátěž, kondice a únava, rozložení intenzity a prahy odhadnuté z toho, co jsi opravdu odtrénoval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーニング負荷、体力と疲労、強度の分布、そして実際にこなした内容から推定した閾値。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman yükü, kondisyon ve yorgunluk, şiddet dağılımı ve gerçekten yaptıklarından tahmin edilen eşikler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировочная нагрузка, форма и усталость, распределение интенсивности и пороги, оценённые по тому, что вы действительно сделали."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренувальне навантаження, форма й втома, розподіл інтенсивності та пороги, оцінені з того, що ви справді зробили."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훈련 부하, 체력과 피로, 강도 분포, 그리고 실제로 해낸 것에서 추정한 역치."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练负荷、体能与疲劳、强度分布，以及从你实际练过的内容推算出的阈值。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حمل التدريب، واللياقة والإجهاد، وتوزيع الشدة، وعتبات مُقدَّرة مما فعلته فعلًا."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορτίο προπόνησης, φυσική κατάσταση και κόπωση, κατανομή έντασης, κατώφλια εκτιμημένα από αυτά που πραγματικά έκανες."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Edzésterhelés, fittség és fáradtság, intenzitáseloszlás, és a ténylegesen elvégzett munkából becsült küszöbök."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încărcătură de antrenament, formă și oboseală, distribuția intensității, praguri estimate din ce ai făcut cu adevărat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tréningová záťaž, kondícia a únava, rozloženie intenzity a prahy odhadnuté z toho, čo si naozaj odtrénoval."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obremenitev treninga, pripravljenost in utrujenost, porazdelitev intenzivnosti in pragovi, ocenjeni iz tega, kar si dejansko naredil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opterećenje treninga, forma i umor, raspodjela intenziteta i pragovi procijenjeni iz onoga što si stvarno odradio."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Оптерећење тренинга, форма и умор, расподела интензитета и прагови процењени из онога што си стварно одрадио."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Treeningkoormus, vorm ja väsimus, intensiivsuse jaotus ning läved, mis on hinnatud selle põhjal, mida sa tegelikult tegid."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniņu slodze, forma un nogurums, intensitātes sadalījums un sliekšņi, kas aplēsti no tā, ko tu patiešām esi izdarījis."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniruočių krūvis, forma ir nuovargis, intensyvumo pasiskirstymas ir slenksčiai, įvertinti iš to, ką iš tikrųjų padarei."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Càrrega d'entrenament, forma i fatiga, distribució de la intensitat i llindars estimats a partir del que realment has fet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfingaálag, form og þreyta, dreifing ákefðar og þröskuldar metnir út frá því sem þú hefur í raun gert."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngarkesa e stërvitjes, forma dhe lodhja, shpërndarja e intensitetit dhe pragjet e vlerësuara nga ajo që ke bërë vërtet."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренинг оптоварување, форма и замор, распределба на интензитетот и прагови проценети од тоа што навистина си го направил."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ualach traenála, aclaíocht agus tuirse, dáileadh na déine, agus tairseacha measta ón méid atá déanta agat i ndáiríre."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagħbija tat-taħriġ, forma u għeja, distribuzzjoni tal-intensità, u limiti stmati minn dak li verament għamilt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訓練負荷、體能與疲勞、強度分布，以及從你實際練過的內容推算出的閾值。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beban latihan, kebugaran dan kelelahan, distribusi intensitas, ambang yang diperkirakan dari apa yang benar-benar kamu lakukan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beban latihan, kecergasan dan keletihan, taburan intensiti, ambang yang dianggarkan daripada apa yang benar-benar anda lakukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải tập luyện, thể lực và mệt mỏi, phân bố cường độ, các ngưỡng ước tính từ chính những gì bạn đã thật sự tập."
          }
        }
      }
    },
