    "Both are optional — a plan can just be a name on a day.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "И двете са по избор — планът може да е просто име за деня."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beides ist optional — ein Plan kann auch nur ein Name an einem Tag sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos son opcionales: un plan puede ser solo un nombre en un día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux sont facultatifs : un plan peut n'être qu'un nom sur un jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi sono facoltativi: un piano può essere solo un nome su un giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide zijn optioneel — een plan kan gewoon een naam op een dag zijn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos são opcionais — um plano pode ser apenas um nome num dia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba są opcjonalne — plan może być po prostu nazwą w danym dniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda är valfria — en plan kan vara bara ett namn på en dag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも任意です。プランはその日の名前だけでも構いません。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge dele er valgfrie — en plan kan være bare et navn på en dag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge er valgfrie — en plan kan være bare et navn på en dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat ovat valinnaisia — suunnitelma voi olla pelkkä nimi päivälle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obojí je nepovinné — plán může být jen název na daný den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de isteğe bağlı — bir plan sadece bir güne yazılmış bir isim olabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба поля необязательны — планом может быть просто название на день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва поля необов’язкові — планом може бути просто назва на день."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 선택 사항입니다 — 계획은 그날에 적힌 이름 하나여도 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项均为选填——一个计划可以只是某天的一个名字。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos são opcionais — um plano pode ser só um nome em um dia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلاهما اختياري — قد تكون الخطة مجرد اسم في يوم."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και τα δύο είναι προαιρετικά — ένα πλάνο μπορεί να είναι απλώς ένα όνομα σε μια μέρα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindkettő opcionális — egy terv lehet csupán egy név egy naphoz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambele sunt opționale — un plan poate fi doar un nume într-o zi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oboje je nepovinné — plán môže byť len názov v konkrétny deň."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oboje je neobvezno — načrt je lahko samo ime na nekem dnevu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oboje je neobavezno — plan može biti samo ime na nekom danu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Обоје је необавезно — план може да буде само име на неком дану."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõlemad on vabatahtlikud — plaan võib olla lihtsalt nimi ühel päeval."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Abi ir neobligāti — plāns var būt vienkārši nosaukums kādā dienā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abu neprivalomi — planas gali būti tiesiog pavadinimas tam tikrą dieną."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tots dos són opcionals: un pla pot ser només un nom en un dia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvort tveggja er valfrjálst — áætlun getur verið bara nafn á einum degi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të dyja janë opsionale — një plan mund të jetë thjesht një emër në një ditë."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "И двете се изборни — планот може да биде само име на некој ден."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an dá cheann roghnach — is féidir le plean a bheith ina ainm ar lá amháin."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-tnejn huma fakultattivi — pjan jista' jkun sempliċement isem f'ġurnata."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項皆為選填——一個計畫可以只是某天的一個名字。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keduanya opsional — sebuah rencana bisa sekadar nama pada satu hari."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-duanya pilihan — sesuatu rancangan boleh jadi sekadar nama pada satu hari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai đều không bắt buộc — một kế hoạch có thể chỉ là một cái tên đặt vào một ngày."
          }
        }
      }
    },
