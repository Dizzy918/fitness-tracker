    "Already read from Health for today. Changing a value here overrides it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вече е прочетено от Health за днес. Промяна тук го замества."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für heute bereits aus Health gelesen. Eine Änderung hier überschreibt den Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya leído de Salud para hoy. Cambiar un valor aquí lo sobrescribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà lu depuis Santé pour aujourd'hui. Modifier une valeur ici la remplace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già letto da Salute per oggi. Modificare un valore qui lo sovrascrive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag al uit Gezondheid gelezen. Een waarde hier wijzigen overschrijft die."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já lido da Saúde para hoje. Alterar um valor aqui substitui-o."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dziś już odczytano ze Zdrowia. Zmiana wartości tutaj ją nadpisuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redan inläst från Hälsa för i dag. Att ändra ett värde här skriver över det."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日分はすでにヘルスケアから読み込み済みです。ここで値を変えると上書きされます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede læst fra Sundhed for i dag. Ændrer du en værdi her, tilsidesættes den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Allerede lest fra Helse for i dag. Endrer du en verdi her, overstyres den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettu jo Terveydestä tälle päivälle. Arvon muuttaminen tässä ohittaa sen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro dnešek už načteno ze Zdraví. Změna hodnoty zde ji přepíše."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün için Sağlık'tan zaten okundu. Buradaki bir değeri değiştirmek onu geçersiz kılar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сегодня уже считано из «Здоровья». Изменение значения здесь переопределит его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На сьогодні вже зчитано зі «Здоров’я». Зміна значення тут перевизначить його."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 자료는 이미 건강 앱에서 읽었습니다. 여기서 값을 바꾸면 그 값이 우선합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的数据已从「健康」读取。在此修改将覆盖该数值。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já lido do app Saúde para hoje. Alterar um valor aqui substitui o dele."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُرئت بيانات اليوم من تطبيق الصحة. تغيير قيمة هنا يتجاوزها."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχει ήδη διαβαστεί από την Υγεία για σήμερα. Αλλάζοντας μια τιμή εδώ την αντικαθιστάς."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mai adatokat már beolvastuk a Health appból. Az itteni érték módosítása felülírja azt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja citit din Health pentru azi. Modificarea unei valori aici o suprascrie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešné údaje už boli načítané zo Zdravia. Zmena hodnoty tu ju prepíše."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za danes je že prebrano iz Zdravja. Sprememba vrednosti tukaj jo prepiše."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za danas je već očitano iz Zdravlja. Promjena vrijednosti ovdje je nadjačava."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "За данас је већ очитано из Здравља. Промена вредности овде је надјачава."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänane on Tervisest juba loetud. Väärtuse muutmine siin kirjutab selle üle."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šodienas dati jau nolasīti no Veselības. Vērtības maiņa šeit to pārraksta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiandienos duomenys jau nuskaityti iš Sveikatos. Reikšmės keitimas čia ją perrašo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja s'ha llegit de Salut per avui. Canviar un valor aquí el substitueix."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þegar lesið úr Heilsu fyrir daginn í dag. Ef þú breytir gildi hér tekur það yfir."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tashmë e lexuar nga Shëndeti për sot. Ndryshimi i një vlere këtu e mbivendos atë."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веќе прочитано од Здравје за денес. Менувањето на вредност овде ја заменува."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léite ó Health don lá inniu cheana. Sáraíonn athrú luacha anseo é."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diġà nqara minn Health għal-lum. Jekk tibdel valur hawn, dan jieħu post tiegħu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的資料已從「健康」讀取。在此修改將覆寫該數值。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah dibaca dari Health untuk hari ini. Mengubah nilai di sini akan menimpanya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sudah dibaca daripada Health untuk hari ini. Mengubah nilai di sini akan menggantikannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đọc từ Health cho hôm nay. Sửa giá trị ở đây sẽ ghi đè lên nó."
          }
        }
      }
    },
