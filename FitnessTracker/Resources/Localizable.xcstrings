          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer uit Gezondheid of doe een dagelijkse check-in voor een gereedheidsscore."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa da Saúde ou faz um registo diário para obteres uma pontuação de prontidão."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj ze Zdrowia albo zrób codzienny wpis, aby otrzymać wskaźnik gotowości."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera från Hälsa eller gör en daglig avstämning för att få ett beredskapsvärde."
