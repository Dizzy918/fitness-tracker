    "Sets are logged against an exercise, so start by setting up your library.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се записват към упражнение, затова започни с изграждането на библиотеката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze werden zu einer Übung erfasst — richte also zuerst deine Bibliothek ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series se registran contra un ejercicio, así que empieza montando tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries sont enregistrées sur un exercice : commence donc par constituer ta bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie si registrano su un esercizio, quindi inizia creando la tua libreria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets worden bij een oefening vastgelegd, dus begin met het opzetten van je bibliotheek."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries são registadas num exercício, por isso começa por montar a tua biblioteca."
          }
        }
      }
    },
    "Sets are logged against an exercise, so you need at least one. Start from the built-in list and edit it, or add your own.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се записват към упражнение, така че ти трябва поне едно. Започни от вградения списък и го редактирай, или добави свои."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze werden zu einer Übung erfasst, du brauchst also mindestens eine. Fang mit der mitgelieferten Liste an und passe sie an, oder leg eigene an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series se registran contra un ejercicio, así que necesitas al menos uno. Parte de la lista incluida y edítala, o añade los tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries sont enregistrées sur un exercice, il t'en faut donc au moins un. Pars de la liste fournie et modifie-la, ou ajoute les tiens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie si registrano su un esercizio, quindi te ne serve almeno uno. Parti dall'elenco integrato e modificalo, oppure aggiungi i tuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets worden bij een oefening vastgelegd, dus je hebt er minstens één nodig. Begin met de ingebouwde lijst en pas die aan, of voeg je eigen oefeningen toe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries são registadas num exercício, por isso precisas de pelo menos um. Parte da lista incluída e edita-a, ou acrescenta os teus."
          }
        }
      }
    },
