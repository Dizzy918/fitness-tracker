        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма достатъчно дълги усилия, от които да се отчете праг. Нужни са 20 минути непрекъснато записана мощност или пулс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Belastungen lang genug, um eine Schwelle abzulesen. Dafür brauchst du 20 zusammenhängende Minuten aufgezeichneter Leistung oder Herzfrequenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay esfuerzos lo bastante largos para leer un umbral. Hacen falta 20 minutos seguidos de potencia o frecuencia cardíaca registradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'efforts assez longs pour en lire un seuil. Il faut 20 minutes d'affilée de puissance ou de fréquence cardiaque enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora sforzi abbastanza lunghi per ricavarne una soglia. Servono 20 minuti consecutivi di potenza o frequenza cardiaca registrate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen inspanningen lang genoeg om er een drempel uit te lezen. Daarvoor is 20 minuten aaneengesloten vastgelegd vermogen of hartslag nodig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há esforços suficientemente longos para daí ler um limiar. São precisos 20 minutos seguidos de potência ou frequência cardíaca registadas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze wysiłków dość długich, by odczytać z nich próg. Potrzeba 20 minut ciągłego zapisu mocy albo tętna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga insatser är ännu långa nog att läsa av en tröskel ur. Det krävs 20 sammanhängande minuter med registrerad effekt eller puls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閾値を読み取れるだけ長い運動がまだありません。パワーまたは心拍が 20 分間続けて記録されている必要があります。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Endnu ingen indsatser lange nok til at aflæse en tærskel. Der kræves 20 sammenhængende minutter med registreret effekt eller puls."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen økter er ennå lange nok til å lese av en terskel. Det kreves 20 sammenhengende minutter med registrert watt eller puls."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä riittävän pitkiä suorituksia kynnyksen lukemiseen. Niihin tarvitaan 20 minuuttia yhtäjaksoista tallennettua tehoa tai sykettä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nejsou dost dlouhá úsilí, ze kterých by šel odečíst práh. Je potřeba 20 souvislých minut zaznamenaného výkonu nebo tepové frekvence."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eşik okunacak kadar uzun bir efor yok. Bunun için 20 dakikalık kesintisiz kayıtlı güç veya nabız gerekir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет отрезков, достаточно длинных для определения порога. Нужны 20 минут подряд записанной мощности или пульса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає відрізків, достатньо довгих для визначення порога. Потрібні 20 хвилин поспіль записаної потужності або пульсу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 역치를 읽을 만큼 긴 구간이 없습니다. 파워나 심박수가 20분 연속으로 기록되어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有足够长的片段用于推算阈值。需要连续 20 分钟的功率或心率记录。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há esforços longos o bastante para tirar um limiar. É preciso um trecho de 20 minutos com potência ou frequência cardíaca gravada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد بعد جهود طويلة بما يكفي لاستخراج عتبة. يلزم 20 دقيقة متصلة من القدرة أو النبض المسجَّل."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη αρκετά μεγάλες προσπάθειες για να βγει κατώφλι. Χρειάζονται 20 συνεχόμενα λεπτά καταγεγραμμένης ισχύος ή παλμών."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs elég hosszú terhelés, amiből küszöböt lehetne olvasni. Ehhez 20 perc összefüggő rögzített teljesítmény vagy pulzus kell."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există eforturi suficient de lungi pentru a deduce un prag. E nevoie de 20 de minute continue de putere sau puls înregistrat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nie sú dosť dlhé úsilia, z ktorých by sa dal odčítať prah. Treba 20 súvislých minút zaznamenaného výkonu alebo tepovej frekvencie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaenkrat ni dovolj dolgih naporov, iz katerih bi lahko odčitali prag. Potrebnih je 20 zaporednih minut zabeležene moči ali utripa."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasad nema dovoljno dugih napora iz kojih bi se očitao prag. Potrebno je 20 uzastopnih minuta zabilježene snage ili pulsa."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Засад нема довољно дугих напора из којих би се очитао праг. Потребно је 20 узастопних минута забележене снаге или пулса."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel pole piisavalt pikki pingutusi, millest läve välja lugeda. Selleks on vaja 20 järjestikust minutit salvestatud võimsust või pulssi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl nav pietiekami garu piepūļu, no kurām nolasīt slieksni. Tam vajag 20 minūtes nepārtraukta reģistrēta jaudas vai pulsa ieraksta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kol kas nėra pakankamai ilgų pastangų, iš kurių būtų galima nuskaityti slenkstį. Reikia 20 minučių ištisinio galios ar pulso įrašo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha esforços prou llargs per deduir-ne un llindar. Calen 20 minuts seguits de potència o pulsacions enregistrades."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Enn eru engir nógu langir kaflar til að lesa þröskuld úr. Það þarf 20 mínútur samfellt af skráðu afli eða púlsi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende nuk ka përpjekje mjaftueshëm të gjata për të nxjerrë një prag. Duhen 20 minuta rresht me fuqi ose rrahje të regjistruara."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште нема доволно долги напори од кои би се отчитал праг. Потребни се 20 непрекинати минути запишана моќност или пулс."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl aon iarracht fada go leor ann fós chun tairseach a léamh aisti. Teastaíonn 20 nóiméad leanúnach de chumhacht nó de ráta croí taifeadta."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għad m'hemmx sforzi twal biżżejjed biex minnhom jinqara limitu. Iridu 20 minuta sħaħ ta' qawwa jew taħbit irreġistrat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有夠長的片段可用來推算閾值。這需要連續 20 分鐘的功率或心率紀錄。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada performa yang cukup panjang untuk membaca ambang. Ini perlu rentang 20 menit daya atau detak jantung yang terekam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada prestasi yang cukup panjang untuk membaca ambang. Ini memerlukan rentetan 20 minit kuasa atau denyutan jantung yang dirakam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có đoạn nào đủ dài để đọc ra ngưỡng. Việc này cần một đoạn 20 phút liên tục có ghi công suất hoặc nhịp tim."
          }
        }
      }
    },
