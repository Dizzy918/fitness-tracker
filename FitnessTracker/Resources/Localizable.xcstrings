    "%@ short — that's the closest this plate set can make without going over.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ по-малко — това е най-близкото, което този комплект дискове може да направи, без да надхвърли."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zu wenig — näher kommt dieser Scheibensatz nicht heran, ohne darüber zu liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan %@: es lo más cerca que puede quedar este juego de discos sin pasarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque %@ : c'est au plus près que ce jeu de disques peut arriver sans dépasser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano %@: è il massimo che questo set di dischi può fare senza superare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te weinig — dichterbij komt deze schijvenset niet zonder eroverheen te gaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %@ — é o mais perto que este conjunto de discos consegue chegar sem passar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje %@ — bliżej ten zestaw talerzy nie dojdzie bez przekroczenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ för lite — närmare kommer den här viktuppsättningen inte utan att gå över."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不足。オーバーせずに作れる、このプレートでの最も近い重量です。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ for lidt — tættere kan dette sæt vægtskiver ikke komme uden at gå over."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ for lite — nærmere kommer ikke dette vektsettet uten å gå over."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vajaa — lähemmäs tämä levysarja ei pääse ylittämättä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí %@ — blíž se tato sada kotoučů nedostane, aniž by váhu překročila."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eksik — bu plaka setiyle aşmadan ulaşılabilecek en yakın değer bu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хватает %@ — ближе этим набором блинов не набрать, не перебрав."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бракує %@ — ближче цим набором млинців не набрати, не перевищивши."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 부족 — 이 원판 구성으로 초과하지 않고 만들 수 있는 가장 가까운 무게입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差 %@——这是现有杠片在不超重的前提下能凑到的最接近重量。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %@ — é o mais perto que essas anilhas chegam sem passar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقص %@ — هذا أقرب وزن يمكن تكوينه بهذه الأقراص دون تجاوز الهدف."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λείπουν %@ — είναι το πιο κοντινό που βγάζουν αυτοί οι δίσκοι χωρίς να το ξεπεράσουν."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hiányzik — ennél közelebb ez a tárcsakészlet nem tud jönni túllépés nélkül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipsesc %@ — e cel mai aproape la care ajung aceste discuri fără să depășească."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chýba %@ — bližšie sa touto sadou kotúčov bez prekročenia dostať nedá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Manjka %@ — bližje s temi utežmi brez preseganja ne gre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedostaje %@ — bliže se s ovim utezima ne može bez prekoračenja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаје %@ — ближе се овим теговима не може без прекорачења."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puudu on %@ — lähemale need kettad üle minemata ei saa."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trūkst %@ — tuvāk ar šiem diskiem, nepārsniedzot, netikt."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trūksta %@ — arčiau su šiais diskais neviršijant neprieisi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Falten %@: és el més a prop que arriben aquests discs sense passar-se."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vantar %@ — nær kemst þetta skífusett ekki án þess að fara yfir."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungojnë %@ — më afër nuk shkohet me këto disqe pa e kaluar."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостигаат %@ — поблиску со овие тегови не оди без да се пречекори."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in easnamh — sin an ceann is gaire is féidir leis an tacar plátaí seo a dhéanamh gan dul thairis."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonqsu %@ — dak hu l-eqreb li tista' tasal b'dawn il-platti mingħajr ma taqbeż."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "差 %@——這是現有槓片在不超重的前提下能湊到的最接近重量。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurang %@ — itu yang paling dekat yang bisa disusun set plat ini tanpa kelebihan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurang %@ — itulah yang paling hampir boleh disusun oleh set plat ini tanpa terlebih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu %@ — đó là mức gần nhất bộ bánh tạ này ghép được mà không vượt quá."
          }
        }
      }
    },
