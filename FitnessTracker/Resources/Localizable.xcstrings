    "Recovery, warmup and cooldown laps are dimmed and excluded from the fastest-lap comparison.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обиколките за възстановяване, загряване и разпускане са затъмнени и изключени от сравнението за най-бърза обиколка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholungs-, Aufwärm- und Auslaufrunden sind abgeblendet und vom Vergleich der schnellsten Runde ausgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vueltas de recuperación, calentamiento y vuelta a la calma aparecen atenuadas y quedan fuera de la comparación de vuelta más rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tours de récupération, d'échauffement et de retour au calme sont grisés et exclus de la comparaison du tour le plus rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giri di recupero, riscaldamento e defaticamento sono attenuati ed esclusi dal confronto sul giro più veloce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel-, warming-up- en cooling-downronden zijn gedimd en tellen niet mee in de vergelijking van de snelste ronde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As voltas de recuperação, aquecimento e retorno à calma aparecem esbatidas e ficam fora da comparação da volta mais rápida."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrążenia regeneracyjne, rozgrzewkowe i schłodzeniowe są przyciemnione i wyłączone z porównania najszybszego okrążenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varv för återhämtning, uppvärmning och nedvarvning är nedtonade och undantagna från jämförelsen av snabbaste varv."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリー、ウォームアップ、クールダウンのラップは淡色表示で、最速ラップの比較から除外されます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgange til restitution, opvarmning og nedkøling er tonet ned og indgår ikke i sammenligningen af hurtigste omgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Runder til restitusjon, oppvarming og nedjogg er dempet og holdes utenfor sammenligningen av raskeste runde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautus-, lämmittely- ja jäähdyttelykierrokset on himmennetty eivätkä ne ole mukana nopeimman kierroksen vertailussa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerační, rozklusávací a vyklusávací okruhy jsou ztlumené a do porovnání nejrychlejšího okruhu nevstupují."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanma, ısınma ve soğuma turları soluklaştırılır ve en hızlı tur karşılaştırmasına dahil edilmez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановительные, разминочные и заминочные круги показаны приглушённо и не участвуют в сравнении самого быстрого круга."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлювальні, розминкові та заминкові кола показані приглушено й не беруть участі в порівнянні найшвидшого кола."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회복, 웜업, 쿨다운 랩은 흐리게 표시되며 최고 랩 비교에서 제외됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复、热身和放松分段会变暗显示，且不参与最快分段的比较。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltas de recuperação, aquecimento e volta à calma aparecem esmaecidas e ficam fora da comparação da volta mais rápida."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لفات الاستشفاء والإحماء والتهدئة تظهر باهتة وتُستبعد من مقارنة أسرع لفة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γύροι αποκατάστασης, προθέρμανσης και αποθεραπείας εμφανίζονται θαμπά και εξαιρούνται από τη σύγκριση ταχύτερου γύρου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A regeneráló, bemelegítő és levezető körök halványan jelennek meg, és kimaradnak a leggyorsabb kör összehasonlításából."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Turele de recuperare, încălzire și revenire apar estompate și sunt excluse din comparația celei mai rapide ture."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeneračné, rozklusávacie a vyklusávacie okruhy sú stlmené a do porovnania najrýchlejšieho okruhu nevstupujú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeneracijski, ogrevalni in ohlajevalni krogi so zatemnjeni in izključeni iz primerjave najhitrejšega kroga."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krugovi oporavka, zagrijavanja i hlađenja prikazani su prigušeno i isključeni su iz usporedbe najbržeg kruga."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Кругови опоравка, загревања и хлађења приказани су пригушено и искључени су из поређења најбржег круга."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taastumis-, soojendus- ja lõdvestusringid on tuhmid ning jäävad kiireima ringi võrdlusest välja."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjaunošanās, iesildīšanās un atsildīšanās apļi ir pieklusināti un netiek iekļauti ātrākā apļa salīdzinājumā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atsigavimo, apšilimo ir atvėsimo ratai rodomi pritemdyti ir neįtraukiami į greičiausio rato palyginimą."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voltes de recuperació, escalfament i tornada a la calma es mostren atenuades i queden fora de la comparació de la volta més ràpida."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurheimtar-, upphitunar- og niðurskokkshringir eru daufir og teljast ekki með í samanburði á hraðasta hring."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Xhirot e rikuperimit, ngrohjes dhe qetësimit shfaqen të zbehta dhe përjashtohen nga krahasimi i xhiros më të shpejtë."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Круговите за опоравување, загревање и разладување се прикажани пригушено и не влегуваат во споредбата на најбрзиот круг."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá camchuairteanna téarnaimh, téimh agus fuaraithe maolaithe agus fágtar as comparáid na camchuairte is tapúla iad."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Id-dawriet ta' rkupru, tisħin u tkessiħ jidhru mċajpra u ma jidħlux fil-paragun tal-eħfef dawra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復、熱身與緩和的分段會變淡顯示，且不列入最快分段的比較。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lap pemulihan, pemanasan dan pendinginan ditampilkan redup dan tidak ikut dalam perbandingan lap tercepat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusingan pemulihan, pemanasan dan pendinginan dipaparkan malap dan tidak disertakan dalam perbandingan pusingan terpantas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các vòng hồi phục, khởi động và thả lỏng được làm mờ và không tính vào phần so vòng nhanh nhất."
          }
        }
      }
    },
