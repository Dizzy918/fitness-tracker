    "Estimated from your highest recorded HR. Set your real max in Settings for accurate zones.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценено по най-високия ти записан пулс. Задай реалния максимум в Настройки за точни зони."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deiner höchsten aufgezeichneten HF geschätzt. Trage dein echtes Maximum in den Einstellungen ein, damit die Zonen stimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir de tu FC más alta registrada. Pon tu máximo real en Ajustes para que las zonas sean exactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimé d'après ta FC la plus élevée enregistrée. Renseigne ton vrai maximum dans les Réglages pour des zones justes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimato dalla tua FC più alta registrata. Imposta il massimo reale nelle Impostazioni per zone corrette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschat uit je hoogst vastgelegde hartslag. Zet je echte maximum in Instellingen voor kloppende zones."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimado a partir da tua FC mais alta registada. Define o teu máximo real nas Definições para zonas corretas."
          }
        }
      }
    },
