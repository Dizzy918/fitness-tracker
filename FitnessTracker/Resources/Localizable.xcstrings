    "Mixed time and distance steps, so there's no single total until it's run.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Смесени стъпки по време и разстояние, така че няма общ сбор, докато не се изпълни."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemischte Zeit- und Distanzschritte — es gibt also keine Gesamtsumme, bis die Einheit gelaufen ist."
          }
        }
      }
    },
    "Mode": {
