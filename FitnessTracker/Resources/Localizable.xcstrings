    "If you've seen a higher number on a hard effort, use that instead — this estimate is ±10 bpm at best.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако си виждал по-високо число при тежко усилие, използвай него — тази оценка е ±10 уд/мин в най-добрия случай."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du bei einer harten Belastung schon einen höheren Wert gesehen hast, nimm den — diese Schätzung liegt bestenfalls ±10 bpm daneben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has visto un número más alto en un esfuerzo duro, usa ese: esta estimación falla ±10 ppm en el mejor de los casos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu as déjà vu un chiffre plus élevé sur un effort dur, prends celui-là : cette estimation est au mieux à ±10 bpm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai già visto un numero più alto in uno sforzo duro, usa quello: questa stima sbaglia di ±10 bpm nel migliore dei casi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je bij een zware inspanning een hoger getal gezien, gebruik dat dan — deze schatting zit er op zijn best ±10 bpm naast."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se já viste um número mais alto num esforço duro, usa esse — esta estimativa erra ±10 bpm na melhor das hipóteses."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli przy ciężkim wysiłku widziałeś wyższą liczbę, użyj jej — to oszacowanie myli się w najlepszym razie o ±10 ud./min."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du sett en högre siffra vid en hård insats, använd den i stället — den här uppskattningen slår fel med ±10 slag/min i bästa fall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きつい運動でもっと高い値を見たことがあれば、そちらを使ってください。この推定は良くても ±10 bpm の誤差があります。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du set et højere tal under en hård indsats, så brug det — dette skøn rammer i bedste fald ±10 slag/min ved siden af."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har du sett et høyere tall på en hard økt, bruk det i stedet — dette anslaget bommer med ±10 slag/min i beste fall."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos olet nähnyt kovassa vedossa korkeamman luvun, käytä sitä — tämä arvio heittää parhaimmillaankin ±10 lyöntiä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jsi při těžkém úsilí viděl vyšší číslo, použij to — tenhle odhad se v nejlepším případě mýlí o ±10 tepů."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorlu bir eforda daha yüksek bir sayı gördüysen onu kullan — bu tahmin en iyi ihtimalle ±10 atım/dk şaşar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если на тяжёлой работе видели число выше — используйте его: точность этой оценки в лучшем случае ±10 уд/мин."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо на важкій роботі бачили вище число — візьміть його: точність цієї оцінки в найкращому разі ±10 уд/хв."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힘든 운동에서 더 높은 수치를 봤다면 그 값을 쓰세요 — 이 추정치는 잘해야 ±10 bpm 수준입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你在大强度训练中见过更高的数值，请用那个——这个估算最多只能精确到 ±10 次/分。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você já viu um número maior em um esforço forte, use aquele — esta estimativa erra ±10 bpm na melhor das hipóteses."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن رأيت رقمًا أعلى في جهد شاق، فاستخدمه بدلًا من هذا — دقة هذا التقدير ‎±10 نبضة/د في أفضل الأحوال."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν έχεις δει μεγαλύτερο νούμερο σε σκληρή προσπάθεια, βάλε εκείνο — αυτή η εκτίμηση έχει ακρίβεια ±10 σφ./λεπτό στην καλύτερη περίπτωση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha kemény terhelésnél láttál már magasabb számot, azt add meg — ez a becslés a legjobb esetben is ±10 ütés/perc."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ai văzut un număr mai mare la un efort intens, folosește-l pe acela — estimarea asta are cel mult ±10 bpm precizie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si pri ťažkom úsilí videl vyššie číslo, použi to — tento odhad sa v najlepšom prípade mýli o ±10 úderov/min."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če si pri težkem naporu videl višjo številko, uporabi tisto — ta ocena je v najboljšem primeru natančna na ±10 utr./min."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako si na teškom naporu vidio veći broj, upiši taj — ova je procjena u najboljem slučaju točna na ±10 otk./min."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако си на тешком напору видео већи број, упиши тај — ова процена је у најбољем случају тачна на ±10 откуцаја/мин."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui oled raskel pingutusel näinud kõrgemat numbrit, kasuta seda — see hinnang on parimal juhul ±10 lööki/min täpne."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja smagā piepūlē esi redzējis lielāku skaitli, izmanto to — šī aplēse labākajā gadījumā ir ±10 sit./min precīza."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei per sunkią pastangą matei didesnį skaičių, naudok jį — šis įvertis geriausiu atveju tikslus ±10 tv./min."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has vist un número més alt en un esforç dur, fes servir aquell: aquesta estimació té ±10 ppm de marge en el millor dels casos."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú hefur séð hærri tölu í erfiðri áreynslu skaltu nota hana — þetta mat er í besta falli ±10 slög/mín."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse ke parë një numër më të lartë në një përpjekje të fortë, përdor atë — ky vlerësim është në rastin më të mirë ±10 rrahje/min."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако си видел поголем број при тежок напор, употреби го тој — оваа проценка е во најдобар случај точна на ±10 отч./мин."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Má chonaic tú uimhir níos airde ar iarracht chrua, bain úsáid as sin — níl an meastachán seo cruinn ach go ±10 buille/nóim ar a fheabhas."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jekk rajt numru ogħla fi sforz iebes, uża dak minflok — din l-istima hija preċiża sa ±10 taħbitiet/min fl-aħjar każ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你在大強度訓練中見過更高的數值，請改用那個——這個估算最多也只能到 ±10 次/分。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau kamu pernah melihat angka lebih tinggi saat latihan berat, pakai yang itu — perkiraan ini paling banter ±10 bpm."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda pernah melihat angka lebih tinggi semasa usaha berat, gunakan yang itu — anggaran ini paling baik pun ±10 bpm."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn từng thấy con số cao hơn trong một buổi gắng sức, hãy dùng con số đó — ước tính này giỏi lắm cũng chỉ ±10 bpm."
          }
        }
      }
    },
