    "No efforts long enough to read a threshold from yet. These need a 20-minute stretch of recorded power or heart rate.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма достатъчно дълги усилия, от които да се отчете праг. Нужни са 20 минути непрекъснато записана мощност или пулс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Belastungen lang genug, um eine Schwelle abzulesen. Dafür brauchst du 20 zusammenhängende Minuten aufgezeichneter Leistung oder Herzfrequenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay esfuerzos lo bastante largos para leer un umbral. Hacen falta 20 minutos seguidos de potencia o frecuencia cardíaca registradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'efforts assez longs pour en lire un seuil. Il faut 20 minutes d'affilée de puissance ou de fréquence cardiaque enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora sforzi abbastanza lunghi per ricavarne una soglia. Servono 20 minuti consecutivi di potenza o frequenza cardiaca registrate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen inspanningen lang genoeg om er een drempel uit te lezen. Daarvoor is 20 minuten aaneengesloten vastgelegd vermogen of hartslag nodig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há esforços suficientemente longos para daí ler um limiar. São precisos 20 minutos seguidos de potência ou frequência cardíaca registadas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze wysiłków dość długich, by odczytać z nich próg. Potrzeba 20 minut ciągłego zapisu mocy albo tętna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga insatser är ännu långa nog att läsa av en tröskel ur. Det krävs 20 sammanhängande minuter med registrerad effekt eller puls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閾値を読み取れるだけ長い運動がまだありません。パワーまたは心拍が 20 分間続けて記録されている必要があります。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Endnu ingen indsatser lange nok til at aflæse en tærskel. Der kræves 20 sammenhængende minutter med registreret effekt eller puls."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen økter er ennå lange nok til å lese av en terskel. Det kreves 20 sammenhengende minutter med registrert watt eller puls."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä riittävän pitkiä suorituksia kynnyksen lukemiseen. Niihin tarvitaan 20 minuuttia yhtäjaksoista tallennettua tehoa tai sykettä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nejsou dost dlouhá úsilí, ze kterých by šel odečíst práh. Je potřeba 20 souvislých minut zaznamenaného výkonu nebo tepové frekvence."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eşik okunacak kadar uzun bir efor yok. Bunun için 20 dakikalık kesintisiz kayıtlı güç veya nabız gerekir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет отрезков, достаточно длинных для определения порога. Нужны 20 минут подряд записанной мощности или пульса."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки немає відрізків, достатньо довгих для визначення порога. Потрібні 20 хвилин поспіль записаної потужності або пульсу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 역치를 읽을 만큼 긴 구간이 없습니다. 파워나 심박수가 20분 연속으로 기록되어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有足够长的片段用于推算阈值。需要连续 20 分钟的功率或心率记录。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há esforços longos o bastante para tirar um limiar. É preciso um trecho de 20 minutos com potência ou frequência cardíaca gravada."
          }
        }
      }
    },
