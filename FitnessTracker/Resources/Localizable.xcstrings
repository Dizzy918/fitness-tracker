      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Спри наблюдението"
          }
        }
      }
    },
    "Stored on this device only — they go into an encrypted backup if you make one, and nowhere else.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съхраняват се само на това устройство — влизат в криптирано резервно копие, ако направиш такова, и никъде другаде."
          }
        }
