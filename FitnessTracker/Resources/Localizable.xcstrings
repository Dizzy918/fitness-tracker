    "Everything is stored on this device. Turn sync on to share it with your other devices.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко се съхранява на това устройство. Включи синхронизацията, за да го споделиш с другите си устройства."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird auf diesem Gerät gespeichert. Aktiviere die Synchronisierung, um es mit deinen anderen Geräten zu teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se guarda en este dispositivo. Activa la sincronización para compartirlo con tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est stocké sur cet appareil. Active la synchronisation pour le partager avec tes autres appareils."
          }
        },
        "it": {
          "stringUnit": {
