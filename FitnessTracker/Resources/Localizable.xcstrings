    "A suggestion from your own trends, not a measurement. If it disagrees with how you feel, trust yourself.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение от собствените ти тенденции, не измерване. Ако не съвпада с усещането ти, вярвай на себе си."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorschlag aus deinen eigenen Trends, keine Messung. Wenn er deinem Gefühl widerspricht, vertraue dir selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sugerencia a partir de tus propias tendencias, no una medición. Si no coincide con cómo te sientes, hazte caso a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une suggestion tirée de tes propres tendances, pas une mesure. Si elle contredit ce que tu ressens, fie-toi à toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suggerimento tratto dalle tue tendenze, non una misurazione. Se non coincide con come ti senti, fidati di te."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een suggestie uit je eigen trends, geen meting. Wijkt die af van hoe je je voelt, vertrouw dan op jezelf."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sugestão a partir das tuas próprias tendências, não uma medição. Se não bater certo com o que sentes, confia em ti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestia z twoich własnych trendów, nie pomiar. Jeśli kłóci się z tym, jak się czujesz, zaufaj sobie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett förslag ur dina egna trender, inte en mätning. Om det inte stämmer med hur du känner dig, lita på dig själv."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定値ではなく、あなた自身の傾向からの提案です。体感と食い違うなら、自分を信じてください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et forslag ud fra dine egne tendenser, ikke en måling. Passer det ikke med, hvordan du har det, så stol på dig selv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et forslag ut fra dine egne trender, ikke en måling. Stemmer det ikke med hvordan du føler deg, så stol på deg selv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdotus omista trendeistäsi, ei mittaus. Jos se on ristiriidassa tuntemustesi kanssa, luota itseesi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrh z tvých vlastních trendů, ne měření. Pokud nesouhlasí s tím, jak se cítíš, věř sobě."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ölçüm değil, kendi eğilimlerinden çıkan bir öneri. Hissettiğinle çelişiyorsa kendine güven."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это подсказка по вашим же трендам, а не измерение. Если она расходится с самочувствием — доверяйте себе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це підказка за вашими ж трендами, а не вимірювання. Якщо вона розходиться із самопочуттям — довіряйте собі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정값이 아니라 당신의 추세에서 나온 제안입니다. 몸 상태와 다르다면 자신을 믿으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是根据你自身趋势给出的建议，不是测量结果。若与你的感受不符，请相信自己。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma sugestão a partir das suas próprias tendências, não uma medição. Se discordar de como você se sente, confie em você."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتراح مبني على اتجاهاتك أنت، لا قياس. إن خالف إحساسك، ثق بنفسك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόταση από τις δικές σου τάσεις, όχι μέτρηση. Αν διαφωνεί με το πώς νιώθεις, εμπιστέψου τον εαυτό σου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javaslat a saját trendjeidből, nem mérés. Ha nem egyezik azzal, ahogy érzed magad, bízz magadban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O sugestie bazată pe propriile tale tendințe, nu o măsurătoare. Dacă nu se potrivește cu ce simți, ai încredere în tine."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrh z tvojich vlastných trendov, nie meranie. Ak sa nezhoduje s tým, ako sa cítiš, ver sebe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predlog iz tvojih lastnih trendov, ne meritev. Če se ne ujema s tvojim počutjem, zaupaj sebi."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijedlog iz tvojih vlastitih trendova, a ne mjerenje. Ako se ne slaže s tim kako se osjećaš, vjeruj sebi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлог из твојих сопствених трендова, а не мерење. Ако се не слаже с тим како се осећаш, веруј себи."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Soovitus sinu enda trendide põhjal, mitte mõõtmine. Kui see läheb sinu enesetundega vastuollu, usalda iseennast."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieteikums no tavām paša tendencēm, nevis mērījums. Ja tas nesaskan ar to, kā jūties, uzticies sev."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasiūlymas iš tavo paties tendencijų, ne matavimas. Jei jis nesutampa su tuo, kaip jautiesi, pasitikėk savimi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suggeriment a partir de les teves pròpies tendències, no una mesura. Si no coincideix amb com et trobes, fes-te cas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillaga út frá þínum eigin þróunarlínum, ekki mæling. Ef hún stangast á við líðan þína skaltu treysta sjálfum þér."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një sugjerim nga trendet e tua, jo një matje. Nëse nuk përputhet me si ndihesh, beso veten."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлог од твоите сопствени трендови, а не мерење. Ако не се совпаѓа со тоа како се чувствуваш, верувај си на себе."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Moladh as do threochtaí féin, ní tomhas. Mura réitíonn sé leis an gcaoi a mbraitheann tú, bíodh muinín agat asat féin."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suġġeriment mix-xejriet tiegħek stess, mhux kejl. Jekk ma jaqbilx ma' kif tħossok, afda lilek innifsek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是依你自身趨勢給出的建議，不是量測結果。若與你的感受不符，請相信自己。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saran dari tren milikmu sendiri, bukan hasil pengukuran. Kalau tidak cocok dengan yang kamu rasakan, percayai dirimu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan daripada aliran anda sendiri, bukan ukuran. Jika ia tidak sepadan dengan apa yang anda rasa, percayalah pada diri sendiri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một gợi ý rút ra từ xu hướng của chính bạn, không phải kết quả đo. Nếu nó khác với cảm nhận của bạn, hãy tin vào bản thân."
          }
        }
      }
    },
    "A synthetic season, so every screen has something in it. You can delete it afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erfundene Saison, damit jeder Bildschirm etwas zeigt. Du kannst sie danach löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une saison fictive, pour que chaque écran ait de quoi s'afficher. Vous pourrez la supprimer ensuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una temporada inventada, para que todas las pantallas tengan algo. Puedes borrarla después."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stagione inventata, così ogni schermata ha qualcosa da mostrare. Puoi eliminarla dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verzonnen seizoen, zodat elk scherm iets laat zien. Je kunt het daarna verwijderen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma época inventada, para que todos os ecrãs tenham algo. Pode eliminá-la depois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma temporada inventada, para que toda tela tenha algo. Você pode excluir depois."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmyślony sezon, żeby każdy ekran miał co pokazać. Potem możesz go usunąć."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En påhittad säsong, så att varje skärm har något att visa. Du kan radera den efteråt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En opdigtet sæson, så hver skærm har noget at vise. Du kan slette den bagefter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En oppdiktet sesong, så hver skjerm har noe å vise. Du kan slette den etterpå."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keksitty kausi, jotta joka näytöllä on jotain. Voit poistaa sen jälkeenpäin."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Измислен сезон, за да има какво да се покаже на всеки екран. После можеш да го изтриеш."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymyšlená sezóna, aby měla každá obrazovka co ukázat. Potom ji můžeš smazat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "架空の1シーズン分。どの画面にも中身が入ります。あとから削除できます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uydurma bir sezon; böylece her ekranda bir şeyler olur. Sonradan silebilirsin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдуманный сезон, чтобы на каждом экране было что показать. Потом его можно удалить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигаданий сезон, щоб на кожному екрані було що показати. Потім його можна видалити."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상의 한 시즌이라 어느 화면에나 내용이 채워집니다. 나중에 지울 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个虚构的赛季，让每个界面都有内容。之后可以删除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موسم مُصطنَع، حتى تجد في كل شاشة شيئًا. ويمكنك حذفه بعد ذلك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια πλασματική σεζόν, ώστε κάθε οθόνη να έχει κάτι. Μπορείς να τη διαγράψεις μετά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy kitalált szezon, hogy minden képernyőn legyen mit nézni. Utána törölheted."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sezon inventat, ca fiecare ecran să aibă ceva în el. Îl poți șterge după aceea."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vymyslená sezóna, aby mala každá obrazovka čo ukázať. Potom ju môžeš zmazať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmišljena sezona, da ima vsak zaslon kaj pokazati. Pozneje jo lahko izbrišeš."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmišljena sezona, da svaki zaslon ima što pokazati. Poslije je možeš obrisati."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Измишљена сезона, да сваки екран има шта да прикаже. После је можеш обрисати."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljamõeldud hooaeg, et igal ekraanil oleks midagi näha. Võid selle hiljem kustutada."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izdomāta sezona, lai katrā ekrānā būtu kaut kas redzams. Pēc tam to vari izdzēst."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išgalvotas sezonas, kad kiekviename ekrane kas nors būtų. Paskui gali jį ištrinti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una temporada inventada, perquè cada pantalla tingui alguna cosa. Després ho pots esborrar."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdiktað tímabil, svo hver skjár hafi eitthvað í sér. Þú getur eytt því á eftir."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një sezon i sajuar, që çdo ekran të ketë diçka. Mund ta fshish më pas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Измислена сезона, за да има што да се прикаже на секој екран. Потоа можеш да ја избришеш."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Séasúr cumtha, ionas go mbeidh rud éigin ar gach scáileán. Is féidir leat é a scriosadh ina dhiaidh sin."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Staġun maħluq, biex kull skrin ikollu xi ħaġa fih. Tista' tħassru wara."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個虛構的賽季，讓每個畫面都有內容。之後可以刪除。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim buatan, supaya setiap layar ada isinya. Bisa kamu hapus setelahnya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Musim rekaan, supaya setiap skrin ada isinya. Anda boleh memadamnya kemudian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mùa giải giả lập, để màn hình nào cũng có nội dung. Bạn có thể xóa sau."
          }
        }
      }
    },
