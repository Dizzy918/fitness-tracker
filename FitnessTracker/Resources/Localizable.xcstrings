            "value": "Se poursuit jusqu'à ce que tu appuies sur tour sur la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosegue finché non premi giro sull'orologio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt door tot je op je horloge op ronde drukt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua até carregares em volta no relógio."
          }
        }
      }
    },
    "SWOLF adds length time and stroke count — lower means more efficient.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF събира времето за дължина и броя загребвания — по-ниско значи по-ефективно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF addiert Bahnzeit und Zugzahl — niedriger heißt effizienter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SWOLF suma el tiempo del largo y el número de brazadas: menos es más eficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le SWOLF additionne le temps de longueur et le nombre de mouvements : plus bas, plus efficace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo SWOLF somma il tempo della vasca e il numero di bracciate: più basso significa più efficiente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF telt baantijd en slagen bij elkaar op — lager betekent efficiënter."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O SWOLF soma o tempo da piscina e o número de braçadas — mais baixo significa mais eficiente."
          }
        }
      }
    },
