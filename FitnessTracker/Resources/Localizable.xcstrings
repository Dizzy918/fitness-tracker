        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребни се трчања со податоци по секунда, од увоз .fit или од синхронизирана активност со записи."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Teastaíonn rití le sonraí gach soicind, ó iompórtáil .fit nó ó ghníomhaíocht shioncronaithe le taifid."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeħtieġ ġirjiet b'data kull sekonda, minn importazzjoni .fit jew minn attività sinkronizzata bir-reġistrazzjonijiet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要有逐秒資料的跑步，來自 .fit 匯入或帶有資料流的同步活動。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu lari dengan data per detik, dari impor .fit atau aktivitas tersinkron yang punya rekaman."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan larian dengan data setiap saat, daripada import .fit atau aktiviti tersegerak yang mempunyai rakaman."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần các buổi chạy có dữ liệu từng giây, từ tệp .fit nhập vào hoặc hoạt động đồng bộ có kèm chuỗi dữ liệu."
          }
        }
      }
    },
