          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa de Salud o haz un registro diario para obtener una puntuación de disposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe depuis Santé ou fais un point quotidien pour obtenir un score de disponibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
