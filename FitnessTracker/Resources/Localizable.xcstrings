    "Any of these, now or later.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Което и да е от тези, сега или по-късно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines davon, jetzt oder später."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera de estas, ahora o más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe laquelle, maintenant ou plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una qualsiasi di queste, ora o più tardi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een van deze, nu of later."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer uma destas, agora ou mais tarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowolne z tych, teraz albo później."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken som helst av dessa, nu eller senare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どれでも、今でもあとでも構いません。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En hvilken som helst af dem, nu eller senere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken som helst av disse, nå eller senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä tahansa näistä, nyt tai myöhemmin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kterékoli z toho, teď nebo později."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlardan herhangi biri, şimdi ya da sonra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любое из этого — сейчас или потом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-що з цього — зараз або пізніше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금이든 나중이든, 아무거나 골라도 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下任选其一，现在或以后都行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer um destes, agora ou depois."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيٌّ من هذه، الآن أو لاحقًا."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οτιδήποτε από αυτά, τώρα ή αργότερα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármelyik ezek közül, most vagy később."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oricare dintre acestea, acum sau mai târziu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čokoľvek z toho, teraz alebo neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karkoli od tega, zdaj ali pozneje."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilo što od ovoga, sad ili kasnije."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Било шта од овога, сад или касније."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ükskõik milline neist, kohe või hiljem."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jebkurš no šiem, tagad vai vēlāk."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bet kuris iš šių, dabar arba vėliau."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsevol d'aquestes, ara o més endavant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvað sem er af þessu, núna eða síðar."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilado prej tyre, tani ose më vonë."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Било што од ова, сега или подоцна."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceann ar bith díobh seo, anois nó níos déanaí."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwalunkwe waħda minn dawn, issa jew aktar tard."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下任選其一，現在或之後都行。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salah satu dari ini, sekarang atau nanti."
          }
        },
        "ms": {
          "stringUnit": {
