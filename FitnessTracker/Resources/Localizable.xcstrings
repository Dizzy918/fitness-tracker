    "Save a session once — the exercises, sets, reps and rest — and start it with one tap on the day.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запази тренировка веднъж — упражненията, сериите, повторенията и почивката — и я започни с едно докосване в деня."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Einheit einmal — Übungen, Sätze, Wiederholungen und Pausen — und starte sie am Tag mit einem Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una sesión una vez —los ejercicios, series, repeticiones y descansos— y empiézala con un toque el día que toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une séance une fois — les exercices, séries, répétitions et récupérations — et lance-la d'un geste le jour venu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una sessione una volta — esercizi, serie, ripetizioni e recuperi — e avviala con un tocco il giorno stesso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een sessie één keer — de oefeningen, sets, herhalingen en rust — en start hem op de dag zelf met één tik."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda uma sessão uma vez — os exercícios, séries, repetições e descansos — e começa-a com um toque no dia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz sesję raz — ćwiczenia, serie, powtórzenia i przerwy — i uruchom ją jednym dotknięciem w danym dniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara ett pass en gång — övningarna, seten, repetitionerna och vilan — och starta det med ett tryck på dagen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを一度保存すれば（種目、セット、レップ、レスト）、当日は 1 タップで開始できます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem et pas én gang — øvelser, sæt, gentagelser og pauser — og start det med ét tryk på dagen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre en økt én gang — øvelsene, settene, repetisjonene og pausene — og start den med ett trykk på dagen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna harjoitus kerran — liikkeet, sarjat, toistot ja tauot — ja käynnistä se yhdellä napautuksella sinä päivänä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulož si trénink jednou — cviky, série, opakování i odpočinek — a v den D ho spusť jedním klepnutím."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir antrenmanı bir kez kaydet — hareketler, setler, tekrarlar ve dinlenme — ve o gün tek dokunuşla başlat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните тренировку один раз — упражнения, подходы, повторения и отдых — и запускайте её одним касанием в нужный день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть тренування один раз — вправи, підходи, повторення й відпочинок — і запускайте його одним дотиком у потрібний день."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션을 한 번만 저장해 두면 — 운동, 세트, 횟수, 휴식까지 — 당일에 한 번 눌러 시작할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一次训练保存下来——动作、组数、次数和休息——当天点一下就能开始。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um treino uma vez — exercícios, séries, repetições e descanso — e comece com um toque no dia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الحصة مرة واحدة — التمارين والمجموعات والتكرارات والراحة — وابدأها بنقرة واحدة في يومها."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθήκευσε μια προπόνηση μία φορά — ασκήσεις, σετ, επαναλήψεις και διαλείμματα — και ξεκίνησέ την με ένα πάτημα την ημέρα που θα τη κάνεις."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentsd el az edzést egyszer — gyakorlatok, sorozatok, ismétlések, pihenők —, és aznap egyetlen koppintással indítsd."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează un antrenament o dată — exercițiile, seriile, repetările și pauzele — și pornește-l cu o singură atingere în ziua respectivă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulož si tréning raz — cviky, série, opakovania aj oddych — a v deň D ho spusť jedným ťuknutím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrani trening enkrat — vaje, serije, ponovitve in počitke — in ga tistega dne zaženi z enim dotikom."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremi trening jednom — vježbe, serije, ponavljanja i odmore — pa ga tog dana pokreni jednim dodirom."
          }
        }
      }
    },
