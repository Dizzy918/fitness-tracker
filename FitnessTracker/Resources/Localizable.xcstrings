            "value": "FTP"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP"
          }
        }
      }
    },
    "FTP unlocks Intensity Factor, TSS and power-based training load on rides. Body weight adds W/kg. Both are optional — average and normalized power work without them.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP отключва Intensity Factor, TSS и натоварване по мощност при каране. Телесното тегло добавя W/кг. И двете са по избор — средната и нормализираната мощност работят без тях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP schaltet Intensity Factor, TSS und leistungsbasierte Trainingsbelastung bei Radeinheiten frei. Das Körpergewicht ergänzt W/kg. Beides ist optional — Durchschnitts- und normalisierte Leistung funktionieren auch ohne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El FTP desbloquea el Intensity Factor, el TSS y la carga de entrenamiento por potencia en las salidas. El peso corporal añade W/kg. Ambos son opcionales: la potencia media y la normalizada funcionan sin ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La FTP débloque l'Intensity Factor, le TSS et la charge d'entraînement par la puissance à vélo. Le poids de corps ajoute les W/kg. Les deux sont facultatifs : la puissance moyenne et normalisée fonctionnent sans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'FTP sblocca Intensity Factor, TSS e carico di allenamento basato sulla potenza in bici. Il peso corporeo aggiunge i W/kg. Entrambi sono facoltativi: potenza media e normalizzata funzionano anche senza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP ontgrendelt Intensity Factor, TSS en vermogensgebaseerde trainingsbelasting op de fiets. Lichaamsgewicht voegt W/kg toe. Beide zijn optioneel — gemiddeld en genormaliseerd vermogen werken ook zonder."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O FTP desbloqueia o Intensity Factor, o TSS e a carga de treino por potência nas saídas. O peso corporal acrescenta os W/kg. Ambos são opcionais — a potência média e a normalizada funcionam sem eles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP odblokowuje Intensity Factor, TSS i obciążenie treningowe z mocy na rowerze. Masa ciała dodaje W/kg. Oba są opcjonalne — moc średnia i znormalizowana działają i bez nich."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP låser upp Intensity Factor, TSS och effektbaserad träningsbelastning på cykelpass. Kroppsvikten ger W/kg. Båda är valfria — medeleffekt och normaliserad effekt fungerar utan dem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP を入れるとライドで Intensity Factor、TSS、パワーベースのトレーニング負荷が使えます。体重を入れると W/kg も出ます。どちらも任意で、平均パワーと正規化パワーはなくても動きます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP låser op for Intensity Factor, TSS og effektbaseret træningsbelastning på cykelture. Kropsvægten giver W/kg. Begge dele er valgfrie — gennemsnits- og normaliseret effekt virker uden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP låser opp Intensity Factor, TSS og wattbasert treningsbelastning på sykkeløkter. Kroppsvekten gir W/kg. Begge er valgfrie — snittwatt og normalisert watt fungerer uten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP avaa Intensity Factorin, TSS:n ja tehoon perustuvan harjoituskuormituksen pyöräilyssä. Kehonpaino tuo W/kg:n. Molemmat ovat valinnaisia — keskiteho ja normalisoitu teho toimivat ilmankin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP odemkne Intensity Factor, TSS a zátěž podle výkonu na kole. Tělesná hmotnost přidá W/kg. Obojí je nepovinné — průměrný a normalizovaný výkon fungují i bez nich."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP, bisiklet sürüşlerinde Intensity Factor, TSS ve güce dayalı antrenman yükünü açar. Vücut ağırlığı W/kg ekler. İkisi de isteğe bağlı — ortalama ve normalize güç bunlarsız da çalışır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP открывает Intensity Factor, TSS и расчёт нагрузки по мощности на велотренировках. Вес тела добавляет Вт/кг. Оба поля необязательны — средняя и нормализованная мощность работают и без них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP відкриває Intensity Factor, TSS і розрахунок навантаження за потужністю на велотренуваннях. Вага тіла додає Вт/кг. Обидва поля необов’язкові — середня та нормалізована потужність працюють і без них."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP를 입력하면 라이딩에서 Intensity Factor, TSS, 파워 기반 훈련 부하를 쓸 수 있습니다. 체중을 넣으면 W/kg이 추가됩니다. 둘 다 선택 사항이며, 평균 파워와 정규화 파워는 없어도 동작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写 FTP 后，骑行可以使用 Intensity Factor、TSS 和基于功率的训练负荷。填写体重会增加瓦/公斤。两者都是选填——平均功率和标准化功率没有它们也能用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FTP libera o Intensity Factor, o TSS e a carga de treino por potência nos pedais. O peso corporal acrescenta W/kg. Os dois são opcionais — potência média e normalizada funcionam sem eles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح FTP مؤشر الشدة وTSS وحمل التدريب المبني على القدرة في ركوب الدراجة. ويضيف وزن الجسم واط/كجم. كلاهما اختياري — القدرة المتوسطة والمعيارية تعملان بدونهما."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το FTP ξεκλειδώνει τον Intensity Factor, το TSS και το φορτίο προπόνησης βάσει ισχύος στην ποδηλασία. Το σωματικό βάρος προσθέτει W/kg. Και τα δύο είναι προαιρετικά — η μέση και η κανονικοποιημένη ισχύς λειτουργούν χωρίς αυτά."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az FTP feloldja az Intensity Factort, a TSS-t és a teljesítményalapú edzésterhelést a kerékpáros edzéseknél. A testsúly hozzáadja a W/kg-ot. Mindkettő opcionális — az átlag- és a normalizált teljesítmény ezek nélkül is működik."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP deblochează Intensity Factor, TSS și încărcătura de antrenament bazată pe putere la ture. Greutatea corporală adaugă W/kg. Ambele sunt opționale — puterea medie și cea normalizată funcționează și fără ele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP odomkne Intensity Factor, TSS a záťaž podľa výkonu na bicykli. Telesná hmotnosť pridá W/kg. Oboje je nepovinné — priemerný a normalizovaný výkon fungujú aj bez nich."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP odklene Intensity Factor, TSS in obremenitev po moči na kolesarskih treningih. Telesna teža doda W/kg. Oboje je neobvezno — povprečna in normalizirana moč delujeta tudi brez tega."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP otključava Intensity Factor, TSS i opterećenje po snazi na vožnjama. Tjelesna težina dodaje W/kg. Oboje je neobavezno — prosječna i normalizirana snaga rade i bez toga."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP откључава Intensity Factor, TSS и оптерећење по снази на вожњама. Телесна тежина додаје W/kg. Обоје је необавезно — просечна и нормализована снага раде и без тога."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP avab rattasõitudel Intensity Factori, TSS-i ja võimsusel põhineva treeningkoormuse. Kehakaal lisab W/kg. Mõlemad on vabatahtlikud — keskmine ja normaliseeritud võimsus töötavad ka ilma nendeta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP atver Intensity Factor, TSS un uz jaudu balstītu treniņu slodzi braucienos. Ķermeņa svars pievieno W/kg. Abi ir neobligāti — vidējā un normalizētā jauda darbojas arī bez tiem."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP atrakina Intensity Factor, TSS ir galia pagrįstą treniruočių krūvį dviračio važiavimuose. Kūno svoris prideda W/kg. Abu neprivalomi — vidutinė ir normalizuota galia veikia ir be jų."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'FTP desbloqueja l'Intensity Factor, el TSS i la càrrega d'entrenament per potència a les sortides en bici. El pes corporal hi afegeix els W/kg. Tots dos són opcionals: la potència mitjana i la normalitzada funcionen sense ells."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP opnar á Intensity Factor, TSS og aflmiðað æfingaálag í hjólatúrum. Líkamsþyngd bætir við W/kg. Hvort tveggja er valfrjálst — meðalafl og normað afl virka án þeirra."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP-ja shkyç Intensity Factor, TSS dhe ngarkesën e stërvitjes bazuar në fuqi për daljet me biçikletë. Pesha trupore shton W/kg. Të dyja janë opsionale — fuqia mesatare dhe e normalizuar punojnë edhe pa to."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP отклучува Intensity Factor, TSS и оптоварување според моќност кај возењата. Телесната тежина додава W/kg. И двете се изборни — просечната и нормализираната моќност работат и без нив."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Osclaíonn FTP an Intensity Factor, TSS agus ualach traenála bunaithe ar chumhacht ar thurais rothaíochta. Cuireann meáchan coirp W/kg leis. Tá an dá cheann roghnach — oibríonn meánchumhacht agus cumhacht normalaithe gan iad."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-FTP jiftaħ l-Intensity Factor, it-TSS u t-tagħbija tat-taħriġ ibbażata fuq il-qawwa fir-rikbiet. Il-piż tal-ġisem iżid il-W/kg. It-tnejn huma fakultattivi — il-qawwa medja u dik normalizzata jaħdmu mingħajrhom."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填入 FTP 後，騎乘就能使用 Intensity Factor、TSS 與以功率為基礎的訓練負荷。填入體重會多出瓦/公斤。兩者皆為選填——平均功率與標準化功率沒有它們也能用。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP membuka Intensity Factor, TSS dan beban latihan berbasis daya untuk gowes. Berat badan menambahkan W/kg. Keduanya opsional — daya rata-rata dan daya ternormalisasi tetap jalan tanpanya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "FTP membuka Intensity Factor, TSS dan beban latihan berasaskan kuasa bagi kayuhan. Berat badan menambah W/kg. Kedua-duanya pilihan — kuasa purata dan kuasa ternormal tetap berfungsi tanpanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có FTP thì buổi đạp sẽ mở khóa Intensity Factor, TSS và tải tập luyện tính theo công suất. Cân nặng thì thêm được W/kg. Cả hai đều không bắt buộc — công suất trung bình và công suất chuẩn hóa vẫn chạy mà không cần chúng."
          }
        }
      }
    },
