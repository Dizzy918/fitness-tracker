            "value": "Изведено от най-доброто ти усилие, преобразувано към еквивалент на 10 км. Лабораторен или полеви тест би бил по-точен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeleitet aus deiner Bestleistung, umgerechnet auf ein 10-km-Äquivalent. Ein Labor- oder Feldtest wäre genauer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivado de tu mejor esfuerzo convertido a un equivalente de 10 km. Una prueba de laboratorio o de campo sería más precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déduit de ton meilleur effort converti en équivalent 10 km. Un test en laboratoire ou sur le terrain serait plus précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricavato dal tuo miglior sforzo convertito in un equivalente sui 10 km. Un test da laboratorio o sul campo sarebbe più preciso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgeleid van je beste inspanning, omgerekend naar een 10 km-equivalent. Een lab- of veldtest zou nauwkeuriger zijn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivado do teu melhor esforço convertido para um equivalente de 10 km. Um teste de laboratório ou de campo seria mais preciso."
          }
        }
      }
    },
