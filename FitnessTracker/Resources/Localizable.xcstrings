            "value": "Числата, с които работят треньорите"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čísla, se kterými pracují trenéři"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチが使う数値"
          }
        },
        "tr": {
          "stringUnit": {
