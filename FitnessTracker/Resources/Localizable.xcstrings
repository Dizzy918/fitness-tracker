            "value": "Disposición %lld sobre 100, %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibilité %lld sur 100, %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prontezza %lld su 100, %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereedheid %lld van 100, %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prontidão %lld em 100, %@"
          }
        }
      }
    },
    "Readiness is a heuristic over your own recent trends — not a medical measurement. Treat it as one input alongside how you actually feel.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовността е евристика върху собствените ти скорошни тенденции — не медицинско измерване. Приемай я като един показател редом с това как реално се чувстваш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereitschaft ist eine Heuristik über deine eigenen jüngsten Trends — keine medizinische Messung. Nimm sie als einen Anhaltspunkt neben dem, wie du dich tatsächlich fühlst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disposición es una heurística sobre tus propias tendencias recientes, no una medición médica. Tómala como un dato más junto a cómo te sientes de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilité est une heuristique sur tes propres tendances récentes, pas une mesure médicale. Prends-la comme un élément parmi d'autres, à côté de ce que tu ressens vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prontezza è un'euristica sulle tue tendenze recenti, non una misurazione medica. Prendila come un dato accanto a come ti senti davvero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereedheid is een vuistregel over je eigen recente trends — geen medische meting. Zie het als één gegeven naast hoe je je echt voelt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A prontidão é uma heurística sobre as tuas tendências recentes — não uma medição médica. Toma-a como mais um dado ao lado do que sentes de facto."
          }
        }
      }
    },
