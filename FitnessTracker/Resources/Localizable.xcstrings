    "A routine is a session you can run again. Set up your exercise library first.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Рутината е тренировка, която можеш да повториш. Първо създай библиотеката с упражнения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Routine ist eine Einheit, die du wiederholen kannst. Lege zuerst deine Übungsbibliothek an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rutina es una sesión que puedes repetir. Primero crea tu biblioteca de ejercicios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une routine est une séance que tu peux refaire. Commence par créer ta bibliothèque d'exercices."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una routine è una sessione che puoi rifare. Prima crea la tua libreria di esercizi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een routine is een sessie die je opnieuw kunt doen. Zet eerst je oefeningenbibliotheek op."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma rotina é uma sessão que podes repetir. Começa por criar a tua biblioteca de exercícios."
          }
        }
      }
    },
    "A suggestion from your own trends, not a measurement. If it disagrees with how you feel, trust yourself.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение от собствените ти тенденции, не измерване. Ако не съвпада с усещането ти, вярвай на себе си."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorschlag aus deinen eigenen Trends, keine Messung. Wenn er deinem Gefühl widerspricht, vertraue dir selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sugerencia a partir de tus propias tendencias, no una medición. Si no coincide con cómo te sientes, hazte caso a ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une suggestion tirée de tes propres tendances, pas une mesure. Si elle contredit ce que tu ressens, fie-toi à toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suggerimento tratto dalle tue tendenze, non una misurazione. Se non coincide con come ti senti, fidati di te."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een suggestie uit je eigen trends, geen meting. Wijkt die af van hoe je je voelt, vertrouw dan op jezelf."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma sugestão a partir das tuas próprias tendências, não uma medição. Se não bater certo com o que sentes, confia em ti."
          }
        }
      }
    },
