    "Shown when you pick this exercise while logging a set.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показва се, когато избереш това упражнение при записване на серия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angezeigt, wenn du diese Übung beim Erfassen eines Satzes auswählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra cuando eliges este ejercicio al registrar una serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'affiche quand tu choisis cet exercice en enregistrant une série."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare quando scegli questo esercizio mentre registri una serie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt getoond wanneer je deze oefening kiest bij het vastleggen van een set."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece quando escolhes este exercício ao registar uma série."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje się, gdy wybierasz to ćwiczenie przy zapisywaniu serii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas när du väljer den här övningen medan du registrerar ett set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットの記録時にこの種目を選ぶと表示されます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises, når du vælger denne øvelse, mens du registrerer et sæt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises når du velger denne øvelsen mens du registrerer et sett."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy, kun valitset tämän liikkeen sarjaa kirjatessasi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí se, když si tenhle cvik vybereš při zaznamenávání série."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Set kaydederken bu hareketi seçtiğinde gösterilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается, когда вы выбираете это упражнение при записи подхода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показується, коли ви вибираєте цю вправу під час запису підходу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트를 기록할 때 이 운동을 고르면 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录组数时选中该动作会显示。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece quando você escolhe este exercício ao registrar uma série."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر عند اختيارك هذا التمرين أثناء تسجيل مجموعة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται όταν διαλέγεις αυτή την άσκηση καταγράφοντας ένα σετ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkor jelenik meg, amikor sorozat rögzítésekor ezt a gyakorlatot választod."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se afișează când alegi acest exercițiu în timp ce înregistrezi o serie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí sa, keď si tento cvik vyberieš pri zaznamenávaní série."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže se, ko to vajo izbereš med beleženjem serije."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje se kad odabereš ovu vježbu dok bilježiš seriju."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Приказује се кад изабереш ову вежбу док бележиш серију."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvatakse, kui valid seeria salvestamisel selle harjutuse."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parādās, kad, pierakstot pieeju, izvēlies šo vingrinājumu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodoma, kai žymėdamas seriją pasirenki šį pratimą."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mostra quan tries aquest exercici en registrar una sèrie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Birtist þegar þú velur þessa æfingu við skráningu setts."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shfaqet kur e zgjedh këtë ushtrim gjatë regjistrimit të një serie."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се прикажува кога ќе ја избереш оваа вежба при запишување серија."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Taispeántar é nuair a roghnaíonn tú an cleachtadh seo agus sraith á logáil agat."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jidher meta tagħżel dan l-eżerċizzju waqt li tirreġistra sett."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄組數時選到這個動作就會顯示。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan saat kamu memilih gerakan ini ketika mencatat set."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipaparkan apabila anda memilih senaman ini semasa mencatat set."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện lên khi bạn chọn bài tập này lúc ghi một hiệp."
          }
        }
      }
    },
