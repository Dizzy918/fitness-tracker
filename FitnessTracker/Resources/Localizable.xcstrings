    "Do a daily check-in to get a readiness score. (Health data is iOS-only.)": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи дневна самооценка, за да получиш оценка за готовност. (Данните от Health са само за iOS.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ein tägliches Check-in, um einen Bereitschaftswert zu erhalten. (Health-Daten gibt es nur unter iOS.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un registro diario para obtener una puntuación de disposición. (Los datos de Salud son solo de iOS)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais un point quotidien pour obtenir un score de disponibilité. (Les données Santé n'existent que sur iOS.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un check-in giornaliero per ottenere un punteggio di prontezza. (I dati di Salute esistono solo su iOS.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe een dagelijkse check-in voor een gereedheidsscore. (Gezondheidsgegevens zijn alleen op iOS.)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz um registo diário para obteres uma pontuação de prontidão. (Os dados da Saúde só existem em iOS.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób codzienny wpis, aby otrzymać wskaźnik gotowości. (Dane ze Zdrowia są tylko na iOS.)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör en daglig avstämning för att få ett beredskapsvärde. (Hälsodata finns bara på iOS.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンディションスコアを得るにはデイリーチェックインを行ってください。（ヘルスケアのデータは iOS のみです。）"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav en daglig status for at få en parathedsscore. (Sundhedsdata findes kun på iOS.)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta en daglig status for å få en beredskapsscore. (Helsedata finnes bare på iOS.)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee päivittäinen kirjaus saadaksesi valmiuspisteet. (Terveys-tiedot ovat vain iOS:ssä.)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělej denní zápis, ať získáš skóre připravenosti. (Data ze Zdraví jsou jen na iOS.)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlık puanı almak için günlük kayıt gir. (Sağlık verisi yalnızca iOS'ta.)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдите ежедневный опрос, чтобы получить оценку готовности. (Данные «Здоровья» доступны только на iOS.)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдіть щоденне опитування, щоб отримати оцінку готовності. (Дані «Здоров’я» доступні лише на iOS.)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비도 점수를 보려면 일일 체크인을 하세요. (건강 데이터는 iOS 전용입니다.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成每日签到即可获得状态评分。（健康数据仅限 iOS。）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um check-in diário para ter uma nota de prontidão. (Os dados do app Saúde são só no iOS.)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل حالتك يوميًا للحصول على درجة الجاهزية. (بيانات الصحة متاحة على iOS فقط.)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε ημερήσια καταγραφή για να πάρεις βαθμολογία ετοιμότητας. (Τα δεδομένα Υγείας υπάρχουν μόνο σε iOS.)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készenléti pontszámhoz végezz napi bejelentkezést. (A Health-adatok csak iOS-en érhetők el.)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Completează raportul zilnic ca să primești un scor de pregătire. (Datele Health există doar pe iOS.)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplň denný záznam a získaš skóre pripravenosti. (Údaje zo Zdravia sú len na iOS.)"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za oceno pripravljenosti opravi dnevni vpis. (Podatki Zdravja so samo na iOS.)"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispuni dnevni upis da dobiješ ocjenu spremnosti. (Podaci iz Zdravlja dostupni su samo na iOS-u.)"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Попуни дневни унос да добијеш оцену спремности. (Подаци из Здравља постоје само на iOS-у.)"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee igapäevane sissekanne, et saada valmisoleku hinnang. (Tervise andmed on ainult iOS-is.)"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai iegūtu gatavības vērtējumu, veic dienas pierakstu. (Veselības dati ir tikai iOS.)"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad gautum pasirengimo įvertį, užpildyk dienos įrašą. (Sveikatos duomenys tik iOS.)"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes el registre diari per obtenir una puntuació de preparació. (Les dades de Salut només són a iOS.)"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráðu daglega líðan til að fá viðbúnaðareinkunn. (Heilsugögn eru aðeins í iOS.)"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bëj regjistrimin ditor për të marrë një vlerësim gatishmërie. (Të dhënat e Shëndetit janë vetëm në iOS.)"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Направи дневен запис за да добиеш оцена за подготвеност. (Податоците од Здравје се само на iOS.)"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Déan seiceáil laethúil chun scór ullmhachta a fháil. (Níl sonraí Health ar fáil ach ar iOS.)"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħmel ir-reġistrazzjoni ta' kuljum biex tikseb punteġġ ta' tħejjija. (Id-data ta' Health hija biss fuq iOS.)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成每日簽到即可取得狀態評分。（健康資料僅限 iOS。）"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakukan check-in harian untuk mendapat skor kesiapan. (Data Health hanya ada di iOS.)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat daftar masuk harian untuk mendapatkan skor kesediaan. (Data Health hanya ada pada iOS.)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy điểm danh hằng ngày để có điểm sẵn sàng. (Dữ liệu Health chỉ có trên iOS.)"
          }
        }
      }
    },
