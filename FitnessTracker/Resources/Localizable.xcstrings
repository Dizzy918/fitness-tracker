      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още няма достатъчно дълги усилия, от които да се отчете праг. Нужни са 20 минути непрекъснато записана мощност или пулс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Belastungen lang genug, um eine Schwelle abzulesen. Dafür brauchst du 20 zusammenhängende Minuten aufgezeichneter Leistung oder Herzfrequenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay esfuerzos lo bastante largos para leer un umbral. Hacen falta 20 minutos seguidos de potencia o frecuencia cardíaca registradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'efforts assez longs pour en lire un seuil. Il faut 20 minutes d'affilée de puissance ou de fréquence cardiaque enregistrées."
          }
        }
      }
    },
