    "Save a session once — the exercises, sets, reps and rest — and start it with one tap on the day.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запази тренировка веднъж — упражненията, сериите, повторенията и почивката — и я започни с едно докосване в деня."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Einheit einmal — Übungen, Sätze, Wiederholungen und Pausen — und starte sie am Tag mit einem Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una sesión una vez —los ejercicios, series, repeticiones y descansos— y empiézala con un toque el día que toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une séance une fois — les exercices, séries, répétitions et récupérations — et lance-la d'un geste le jour venu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una sessione una volta — esercizi, serie, ripetizioni e recuperi — e avviala con un tocco il giorno stesso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een sessie één keer — de oefeningen, sets, herhalingen en rust — en start hem op de dag zelf met één tik."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda uma sessão uma vez — os exercícios, séries, repetições e descansos — e começa-a com um toque no dia."
          }
        }
      }
    },
