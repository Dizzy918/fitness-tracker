        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Stërvitja jote, në pajisjen tënde"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твојот тренинг, на твојот уред"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Do chuid traenála, ar do ghléas féin"
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "It-taħriġ tiegħek, fuq l-apparat tiegħek"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的訓練，留在你的裝置上"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihanmu, di perangkatmu"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan anda, pada peranti anda"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu tập của bạn, nằm trên máy bạn"
          }
        }
      }
    },
