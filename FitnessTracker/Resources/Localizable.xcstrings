      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко място се сравнява между собственото си първо и последно измерване в периода — вероятно мериш талията си по-често от прасците."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stelle wird zwischen ihrem eigenen ersten und letzten Messwert im Zeitraum verglichen — die Taille misst du vermutlich öfter als die Waden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada punto se compara entre su primera y su última medida dentro del periodo: probablemente mides la cintura más a menudo que los gemelos."
