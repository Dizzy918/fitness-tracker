    "Close, but you arrive with a little fatigue still in the legs. An easier final week would sharpen it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Близо е, но пристигаш с малко умора в краката. По-лека последна седмица би те изострила."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapp — du kommst mit etwas Müdigkeit in den Beinen an. Eine leichtere Schlusswoche würde das schärfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca, pero llegas con algo de fatiga todavía en las piernas. Una última semana más suave lo afinaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est proche, mais tu arrives avec encore un peu de fatigue dans les jambes. Une dernière semaine plus légère affûterait ça."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sei quasi, ma arrivi con ancora un po' di fatica nelle gambe. Un'ultima settimana più leggera ti affilerebbe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna, maar je komt aan met nog wat vermoeidheid in de benen. Een rustigere laatste week zou dat aanscherpen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perto, mas chegas com alguma fadiga ainda nas pernas. Uma última semana mais leve afinava isso."
          }
        }
      }
    },
