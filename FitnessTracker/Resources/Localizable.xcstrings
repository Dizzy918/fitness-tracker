          }
        }
      }
    },
    "This workout has no GPS track, so the card is stats only.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази тренировка няма GPS следа, затова картата е само със статистики."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einheit hat keinen GPS-Track, die Karte zeigt also nur Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este entrenamiento no tiene track GPS, así que la tarjeta solo lleva datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette séance n'a pas de trace GPS : la carte ne contient que des chiffres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo allenamento non ha una traccia GPS, quindi la scheda riporta solo i numeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze training heeft geen GPS-track, dus de kaart bevat alleen cijfers."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este treino não tem trilho de GPS, por isso o cartão só traz números."
          }
        }
      }
    },
    "This workout has recorded data — a GPS track, laps or a sensor stream. Those aren't changed here, so editing the summary can make it disagree with them.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази тренировка има записани данни — GPS следа, обиколки или поток от сензори. Те не се променят тук, така че редактирането на обобщението може да го разминe с тях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einheit hat aufgezeichnete Daten — einen GPS-Track, Runden oder Sensordaten. Die werden hier nicht geändert, das Bearbeiten der Zusammenfassung kann sie also in Widerspruch dazu bringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este entrenamiento tiene datos grabados: un track GPS, vueltas o registros de sensores. Aquí no se tocan, así que editar el resumen puede dejarlo en contradicción con ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette séance contient des données enregistrées : une trace GPS, des tours ou des relevés de capteurs. Ils ne sont pas modifiés ici : éditer le résumé peut donc le mettre en contradiction avec eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo allenamento ha dati registrati: una traccia GPS, dei giri o i dati dei sensori. Qui non vengono toccati, quindi modificare il riepilogo può metterlo in contraddizione con essi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze training heeft vastgelegde gegevens — een GPS-track, ronden of een sensorverloop. Die worden hier niet gewijzigd, dus de samenvatting aanpassen kan hem in tegenspraak brengen met die gegevens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este treino tem dados gravados — um trilho de GPS, voltas ou registos de sensores. Aqui não são alterados, por isso editar o resumo pode pô-lo em contradição com eles."
          }
        }
      }
    },
