        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفصولة بفواصل. اختياري — تُستخدم في البحث."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρισμένα με κόμματα. Προαιρετικό — χρησιμοποιείται για αναζήτηση."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesszővel elválasztva. Opcionális — a kereséshez használjuk."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate prin virgulă. Opțional — se folosesc la căutare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddelené čiarkami. Nepovinné — používa sa pri vyhľadávaní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ločeno z vejicami. Neobvezno — uporablja se za iskanje."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odvojeno zarezima. Neobavezno — koristi se za pretragu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздвојено зарезима. Необавезно — користи се за претрагу."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Komadega eraldatud. Vabatahtlik — kasutatakse otsinguks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atdalīti ar komatiem. Neobligāti — izmanto meklēšanai."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atskirta kableliais. Neprivaloma — naudojama paieškai."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Separat per comes. Opcional: s'utilitza per cercar."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðgreint með kommum. Valfrjálst — notað við leit."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Të ndara me presje. Opsionale — përdoren për kërkim."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одделено со запирки. Изборно — се користи за пребарување."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Scartha le camóga. Roghnach — úsáidtear é le cuardach."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mifruda bil-virgoli. Fakultattiv — jintuża għat-tfittxija."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗號分隔。選填——用於搜尋。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipisahkan koma. Opsional — dipakai untuk pencarian."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipisahkan dengan koma. Pilihan — digunakan untuk carian."
          }
        },
        "vi": {
