    "%@ short — that's the closest this plate set can make without going over.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ по-малко — това е най-близкото, което този комплект дискове може да направи, без да надхвърли."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zu wenig — näher kommt dieser Scheibensatz nicht heran, ohne darüber zu liegen."
          }
        }
      }
    },
