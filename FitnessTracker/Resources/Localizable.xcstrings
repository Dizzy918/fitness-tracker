    "%lld session%@ this week had no power or heart rate, so its load is estimated from duration.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld тренировк%@ тази седмица без мощност или пулс, затова натоварването е оценено по продължителност."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Einheit%@ diese Woche ohne Leistung oder Herzfrequenz — die Belastung wird aus der Dauer geschätzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sesion%@ esta semana sin potencia ni frecuencia cardíaca, así que su carga se estima por la duración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld séance%@ cette semaine sans puissance ni fréquence cardiaque : leur charge est estimée d'après la durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessi%@ questa settimana senza potenza né frequenza cardiaca: il carico è stimato dalla durata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessie%@ deze week zonder vermogen of hartslag, dus de belasting is geschat op basis van de duur."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessõe%@ esta semana sem potência nem frequência cardíaca, por isso a carga é estimada a partir da duração."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sesj%@ w tym tygodniu bez mocy i tętna, więc obciążenie oszacowano z czasu trwania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pass%@ den här veckan saknade effekt och puls, så belastningen uppskattas från tiden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週の %lld 件のセッション%@はパワーも心拍もないため、負荷は時間から推定しています。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pas%@ i denne uge havde hverken effekt eller puls, så belastningen er anslået ud fra tiden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld økt%@ denne uken manglet både watt og puls, så belastningen er anslått ut fra tiden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld harjoitu%@ tällä viikolla ilman tehoa ja sykettä, joten kuormitus on arvioitu kestosta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tréni%@ tento týden bez výkonu i tepové frekvence, zátěž je proto odhadnuta z délky."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta %lld antrenman%@ güç veya nabız verisi yoktu, bu yüzden yükü süreden tahmin edildi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой неделе тренировок без мощности и пульса: %lld%@, поэтому нагрузка оценена по длительности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього тижня тренувань без потужності та пульсу: %lld%@, тому навантаження оцінено за тривалістю."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 %lld개 세션%@ 파워나 심박수가 없어 부하를 시간으로 추정했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周有 %lld 次训练%@没有功率或心率数据，因此负荷由时长估算。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld treino%@ desta semana ficaram sem potência ou frequência cardíaca, então a carga foi estimada pela duração."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%lld حصة%@ هذا الأسبوع بلا قدرة أو نبض، لذا قُدِّر حملها من المدة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld προπόνηση%@ αυτή την εβδομάδα δεν είχαν ισχύ ή καρδιακούς παλμούς, οπότε το φορτίο τους εκτιμήθηκε από τη διάρκεια."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a héten %lld edzésnél%@ nem volt teljesítmény- vagy pulzusadat, ezért a terhelést az időtartamból becsültük."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld antrenamente%@ din această săptămână nu au avut putere sau puls, așa că încărcătura lor e estimată din durată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tréning%@ tento týždeň nemal výkon ani tepovú frekvenciu, takže jeho záťaž je odhadnutá z trvania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld treningov%@ ta teden ni imelo moči ali srčnega utripa, zato je njihova obremenitev ocenjena iz trajanja."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld treninga%@ ovaj tjedan nije imalo snagu ni puls, pa je njihovo opterećenje procijenjeno iz trajanja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld тренинга%@ ове недеље није имало снагу ни пулс, па је њихово оптерећење процењено из трајања."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sel nädalal oli %lld trenni%@ ilma võimsuse või pulsita, seega on nende koormus hinnatud kestuse põhjal."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šonedēļ %lld treniņiem%@ nebija jaudas vai pulsa, tāpēc to slodze ir novērtēta pēc ilguma."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šią savaitę %lld treniruočių%@ neturėjo galios ar pulso, todėl jų krūvis įvertintas pagal trukmę."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessions%@ d'aquesta setmana no tenien potència ni freqüència cardíaca, així que la càrrega s'estima per la durada."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld æfingar%@ í þessari viku voru án afls eða púls, svo álagið er metið út frá tímalengd."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld stërvitje%@ këtë javë nuk kishin fuqi ose rrahje zemre, prandaj ngarkesa e tyre është vlerësuar nga kohëzgjatja."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld тренинзи%@ оваа недела немаа моќност или пулс, па нивното оптоварување е проценето од времетраењето."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní raibh cumhacht ná ráta croí ag %lld seisiún%@ an tseachtain seo, mar sin meastar a n-ualach ón ré."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessjoni%@ din il-ġimgħa ma kellhomx qawwa jew taħbit tal-qalb, għalhekk it-tagħbija tagħhom hija stmata mit-tul."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週有 %lld 次訓練%@沒有功率或心率資料，因此負荷由時長估算。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sesi%@ minggu ini tanpa data daya atau detak jantung, jadi bebannya diperkirakan dari durasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sesi%@ minggu ini tiada data kuasa atau denyutan jantung, jadi bebannya dianggarkan daripada tempoh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld buổi%@ tuần này không có công suất hay nhịp tim, nên tải của nó được ước tính từ thời lượng."
          }
        }
      }
    },
