            "value": "Beides ist optional — ein Plan kann auch nur ein Name an einem Tag sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos son opcionales: un plan puede ser solo un nombre en un día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux sont facultatifs : un plan peut n'être qu'un nom sur un jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi sono facoltativi: un piano può essere solo un nome su un giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide zijn optioneel — een plan kan gewoon een naam op een dag zijn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos são opcionais — um plano pode ser apenas um nome num dia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba są opcjonalne — plan może być po prostu nazwą w danym dniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Båda är valfria — en plan kan vara bara ett namn på en dag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらも任意です。プランはその日の名前だけでも構いません。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge dele er valgfrie — en plan kan være bare et navn på en dag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begge er valgfrie — en plan kan være bare et navn på en dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Molemmat ovat valinnaisia — suunnitelma voi olla pelkkä nimi päivälle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obojí je nepovinné — plán může být jen název na daný den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkisi de isteğe bağlı — bir plan sadece bir güne yazılmış bir isim olabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба поля необязательны — планом может быть просто название на день."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва поля необов’язкові — планом може бути просто назва на день."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘 다 선택 사항입니다 — 계획은 그날에 적힌 이름 하나여도 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项均为选填——一个计划可以只是某天的一个名字。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos são opcionais — um plano pode ser só um nome em um dia."
          }
        }
      }
    },
