            "value": "Plant een taper van %lld dagen voor deze datum."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeia um afinamento de %lld dias antes desta data."
          }
        },
        "pl": {
