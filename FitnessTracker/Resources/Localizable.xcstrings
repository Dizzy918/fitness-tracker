    "Pulls your history, including per-second streams and watch laps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt deine Historie, inklusive Sekundendaten und Runden von der Uhr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère votre historique, y compris les données seconde par seconde et les tours de la montre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae tu historial, incluidos los datos segundo a segundo y las vueltas del reloj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera il tuo storico, inclusi i dati al secondo e i giri registrati dall'orologio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt je historie op, inclusief data per seconde en rondes van het horloge."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz o seu histórico, incluindo dados ao segundo e as voltas do relógio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traz seu histórico, incluindo dados segundo a segundo e as voltas do relógio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera twoją historię, łącznie z danymi co sekundę i okrążeniami z zegarka."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar din historik, inklusive data per sekund och varv från klockan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter din historik, inklusive data pr. sekund og omgange fra uret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter historikken din, inkludert data per sekund og runder fra klokka."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakee historiasi, mukaan lukien sekuntikohtaiset tiedot ja kellon kierrokset."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтегля историята ти, включително данните по секунди и обиколките от часовника."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne tvou historii včetně dat po sekundách a okruhů z hodinek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎秒データや時計のラップも含めて履歴を取り込みます。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saniyelik kayıtlar ve saatin turları dâhil geçmişini çeker."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтягивает вашу историю, включая посекундные данные и круги с часов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтягує вашу історію, включно з посекундними даними та колами з годинника."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초 단위 데이터와 시계의 랩까지 포함해 기록을 가져옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取你的历史记录，包括逐秒数据和手表分段。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجلب سجلّك، بما في ذلك البيانات لكل ثانية ولفّات الساعة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβάει το ιστορικό σου, μαζί με τα δεδομένα ανά δευτερόλεπτο και τους γύρους του ρολογιού."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehúzza az előzményeidet, a másodpercenkénti adatsorokkal és az óra köreivel együtt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți aduce istoricul, inclusiv datele secundă cu secundă și turele de pe ceas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahne tvoju históriu vrátane údajov po sekundách a okruhov z hodiniek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenese tvojo zgodovino, vključno s sekundnimi zapisi in krogi z ure."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovlači tvoju povijest, uključujući zapise po sekundi i krugove sa sata."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Довлачи твоју историју, укључујући записе по секунди и кругове са сата."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõmbab sinu ajaloo, sealhulgas sekundipõhised salvestused ja kella ringid."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievelk tavu vēsturi, ieskaitot ierakstus pa sekundēm un pulksteņa apļus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įtraukia tavo istoriją, įskaitant įrašus kas sekundę ir laikrodžio ratus."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera el teu historial, incloent-hi els registres segon a segon i les voltes del rellotge."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sækir söguna þína, þar á meðal skráningar á sekúndufresti og hringi úr úrinu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Tërheq historinë tënde, përfshirë regjistrimet sekondë pas sekonde dhe xhirot nga ora."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ја повлекува твојата историја, вклучувајќи ги записите по секунда и круговите од часовникот."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarraingíonn sé do stair anuas, lena n-áirítear taifid gach soicind agus camchuairteanna an uaireadóra."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iġib l-istorja tiegħek, inklużi r-reġistrazzjonijiet kull sekonda u d-dawriet tal-arloġġ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取你的歷史紀錄，包括逐秒資料流與手錶分段。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menarik riwayatmu, termasuk rekaman per detik dan lap dari jam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menarik sejarah anda, termasuk rakaman setiap saat dan pusingan daripada jam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo về lịch sử của bạn, gồm cả chuỗi dữ liệu từng giây và các vòng bấm trên đồng hồ."
          }
        }
      }
    },
