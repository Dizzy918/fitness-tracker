    "Readiness %lld out of 100, %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовност %lld от 100, %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereitschaft %lld von 100, %@"
          }
        }
      }
    },
    "Readiness is a heuristic over your own recent trends — not a medical measurement. Treat it as one input alongside how you actually feel.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовността е евристика върху собствените ти скорошни тенденции — не медицинско измерване. Приемай я като един показател редом с това как реално се чувстваш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereitschaft ist eine Heuristik über deine eigenen jüngsten Trends — keine medizinische Messung. Nimm sie als einen Anhaltspunkt neben dem, wie du dich tatsächlich fühlst."
          }
        }
      }
    },
    "Reading": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Показание"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messwert"
          }
        }
      }
    },
    "Reading %@…": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Четене на %@…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird gelesen…"
          }
        }
      }
    },
    "Reading your efforts…": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Четене на усилията ти…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Belastungen werden gelesen…"
          }
        }
      }
    },
    "Reads your best 20-minute efforts from the last year. Every figure is a convention applied to your own training, not a lab test — each row says what it rests on, and nothing is applied until you tap it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Чете най-добрите ти 20-минутни усилия от последната година. Всяко число е конвенция, приложена към твоите тренировки, не лабораторен тест — всеки ред казва на какво стъпва и нищо не се прилага, докато не го докоснеш."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest deine besten 20-Minuten-Belastungen des letzten Jahres. Jeder Wert ist eine Konvention, angewandt auf dein eigenes Training, kein Labortest — jede Zeile nennt ihre Grundlage, und nichts wird übernommen, bis du darauf tippst."
          }
        }
      }
    },
    "Recorded %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
