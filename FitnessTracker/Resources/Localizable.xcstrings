    "Sets are logged against an exercise, so start by setting up your library.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се записват към упражнение, затова започни с изграждането на библиотеката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze werden zu einer Übung erfasst — richte also zuerst deine Bibliothek ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series se registran contra un ejercicio, así que empieza montando tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries sont enregistrées sur un exercice : commence donc par constituer ta bibliothèque."
          }
        }
      }
    },
    "Sets are logged against an exercise, so you need at least one. Start from the built-in list and edit it, or add your own.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сериите се записват към упражнение, така че ти трябва поне едно. Започни от вградения списък и го редактирай, или добави свои."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätze werden zu einer Übung erfasst, du brauchst also mindestens eine. Fang mit der mitgelieferten Liste an und passe sie an, oder leg eigene an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series se registran contra un ejercicio, así que necesitas al menos uno. Parte de la lista incluida y edítala, o añade los tuyos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries sont enregistrées sur un exercice, il t'en faut donc au moins un. Pars de la liste fournie et modifie-la, ou ajoute les tiens."
          }
        }
      }
    },
