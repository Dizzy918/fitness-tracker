        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ολυμπιακή μπάρα είναι %@· οι γυναικείες είναι %@, ενώ μια μπάρα προπόνησης μπορεί να είναι 10."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az olimpiai rúd %@; a női rudak %@, az edzőrúd pedig lehet 10 is."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara olimpică are %@; barele de damă au %@, iar o bară de antrenament poate avea 10."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olympijská os má %@; dámske osi majú %@ a tréningová os môže mať 10."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Olimpijska palica ima %@; ženske palice imajo %@, vadbena palica pa je lahko 10."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olimpijska šipka ima %@; ženske šipke imaju %@, a šipka za trening može imati 10."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Олимпијска шипка има %@; женске шипке имају %@, а шипка за тренинг може имати 10."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Olümpiakang on %@; naiste kangid on %@ ja treeningkang võib olla 10."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
