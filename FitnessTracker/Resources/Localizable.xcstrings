    "Low confidence — verify against the PDF": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниска увереност — провери спрямо PDF-а"
          }
        },
