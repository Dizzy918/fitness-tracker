    "Mixed time and distance steps, so there's no single total until it's run.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Смесени стъпки по време и разстояние, така че няма общ сбор, докато не се изпълни."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemischte Zeit- und Distanzschritte — es gibt also keine Gesamtsumme, bis die Einheit gelaufen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos mezclados de tiempo y distancia, así que no hay un total único hasta hacerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étapes mêlant temps et distance : il n'y a pas de total unique avant de l'avoir faite."
