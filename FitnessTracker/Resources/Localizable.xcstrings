    "Connect Strava or intervals.icu below to enable syncing.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържи Strava или intervals.icu по-долу, за да включиш синхронизацията."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde unten Strava oder intervals.icu, um die Synchronisierung zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Strava o intervals.icu abajo para activar la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte Strava ou intervals.icu ci-dessous pour activer la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega Strava o intervals.icu qui sotto per attivare la sincronizzazione."
          }
        },
        "nl": {
