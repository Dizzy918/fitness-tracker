    "All of this can be changed, or estimated from your data, in Settings later.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко това може да се промени или да се оцени от данните ти по-късно в Настройки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "All das lässt sich später in den Einstellungen ändern oder aus deinen Daten schätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esto se puede cambiar, o estimar a partir de tus datos, más tarde en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout cela peut être modifié, ou estimé à partir de tes données, plus tard dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto questo si può cambiare, o stimare dai tuoi dati, più avanti nelle Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan later allemaal worden aangepast, of uit je gegevens worden geschat, in Instellingen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo isto pode ser alterado, ou estimado a partir dos teus dados, mais tarde nas Definições."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko to można później zmienić lub oszacować z twoich danych w Ustawieniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt detta går att ändra, eller uppskatta ur dina data, senare i Inställningar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはあとから設定で変更したり、データから推定したりできます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt dette kan ændres eller anslås ud fra dine data senere under Indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt dette kan endres, eller anslås ut fra dataene dine, senere under Innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaiken tämän voi muuttaa tai arvioida tiedoistasi myöhemmin asetuksissa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše lze později v Nastavení změnit nebo odhadnout z tvých dat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunların hepsi sonradan Ayarlar'da değiştirilebilir veya verilerinden tahmin edilebilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё это потом можно изменить или оценить по вашим данным в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе це потім можна змінити або оцінити за вашими даними в налаштуваннях."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모든 값은 나중에 설정에서 바꾸거나 데이터로부터 추정할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些之后都可以在设置中修改，或由你的数据推算。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo isso pode ser alterado depois nos ajustes, ou estimado a partir dos seus dados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل هذا يمكن تغييره لاحقًا في الإعدادات، أو تقديره من بياناتك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα αυτά μπορούν να αλλάξουν αργότερα στις Ρυθμίσεις ή να εκτιμηθούν από τα δεδομένα σου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindez később módosítható, vagy az adataidból megbecsülhető a Beállításokban."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate acestea pot fi modificate mai târziu în Setări sau estimate din datele tale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko toto sa dá neskôr zmeniť v Nastaveniach alebo odhadnúť z tvojich údajov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse to lahko pozneje spremeniš v Nastavitvah ali oceniš iz svojih podatkov."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve se ovo poslije može promijeniti u Postavkama ili procijeniti iz tvojih podataka."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Све ово се касније може променити у Подешавањима или проценити из твојих података."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõike seda saab hiljem Seadetes muuta või sinu andmete põhjal hinnata."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visu šo vēlāk var mainīt Iestatījumos vai novērtēt pēc taviem datiem."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa tai vėliau galima pakeisti Nustatymuose arba įvertinti iš tavo duomenų."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot això es pot canviar més endavant a Configuració, o estimar-se a partir de les teves dades."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Öllu þessu má breyta síðar í Stillingum, eða meta út frá gögnunum þínum."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "E gjitha kjo mund të ndryshohet më vonë te Cilësimet, ose të vlerësohet nga të dhënat e tua."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сето ова подоцна може да се смени во Поставки или да се процени од твоите податоци."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is féidir é seo ar fad a athrú níos déanaí sna Socruithe, nó a mheas as do shonraí."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan kollu jista' jinbidel aktar tard fis-Settings, jew jiġi stmat mid-data tiegħek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些之後都可以在設定中修改，或由你的資料推算。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ini bisa diubah, atau diperkirakan dari datamu, di Pengaturan nanti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ini boleh diubah, atau dianggarkan daripada data anda, dalam Tetapan kemudian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả những mục này đều có thể sửa, hoặc ước tính từ dữ liệu của bạn, trong Cài đặt sau này."
          }
        }
      }
    },
