    "Add a pair to track mileage and get wear warnings.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добави чифт, за да следиш километража и да получаваш предупреждения за износване."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Paar hinzu, um die Laufleistung zu verfolgen und Verschleißwarnungen zu bekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un par para seguir el kilometraje y recibir avisos de desgaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une paire pour suivre le kilométrage et recevoir des alertes d'usure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un paio per seguire il chilometraggio e ricevere avvisi di usura."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een paar toe om de kilometers bij te houden en slijtagewaarschuwingen te krijgen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um par para acompanhar a quilometragem e receber avisos de desgaste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj parę, aby śledzić przebieg i dostawać ostrzeżenia o zużyciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett par för att följa milen och få slitagevarningar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走行距離を記録し、摩耗の警告を受け取るには 1 足追加してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et par for at følge kilometerne og få advarsler om slid."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et par for å følge kilometerne og få varsler om slitasje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää pari, niin näet kilometrit ja saat varoituksia kulumisesta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej pár, ať sleduješ nájezd a dostáváš upozornění na opotřebení."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilometreyi takip etmek ve aşınma uyarısı almak için bir çift ekle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте пару, чтобы считать пробег и получать предупреждения об износе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте пару, щоб рахувати пробіг і отримувати попередження про знос."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 켤레를 추가하면 주행 거리를 추적하고 마모 경고를 받을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一双跑鞋即可记录里程并在磨损时收到提醒。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um par para acompanhar a quilometragem e receber avisos de desgaste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف زوجًا لتتبّع المسافة وتلقّي تنبيهات التآكل."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε ένα ζευγάρι για να μετράς χιλιόμετρα και να παίρνεις προειδοποιήσεις φθοράς."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy párat, hogy kövesd a futott távot, és figyelmeztetést kapj a kopásról."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă o pereche ca să urmărești kilometrajul și să primești avertismente de uzură."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridaj pár, aby si sledoval nakilometrované a dostával upozornenia na opotrebenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj par, da spremljaš prevožene kilometre in dobiš opozorila o obrabi."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj par da pratiš kilometražu i dobivaš upozorenja o istrošenosti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додај пар да пратиш километражу и добијаш упозорења о похабаности."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa paar, et jälgida läbitud kilomeetreid ja saada hoiatusi kulumise kohta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievieno pāri, lai sekotu nobraukumam un saņemtu brīdinājumus par nolietojumu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėk porą, kad sektum nubėgtą atstumą ir gautum įspėjimus apie nusidėvėjimą."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix un parell per fer el seguiment dels quilòmetres i rebre avisos de desgast."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu við pari til að fylgjast með kílómetrum og fá viðvaranir um slit."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shto një palë për të ndjekur kilometrat dhe për të marrë paralajmërime konsumimi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додај пар за да ја следиш километражата и да добиваш предупредувања за истрошеност."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuir péire leis chun an mhíleáiste a rianú agus rabhaidh chaithimh a fháil."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Żid par biex issegwi l-kilometraġġ u tirċievi twissijiet dwar il-konsum."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增一雙跑鞋即可記錄里程，並在磨損時收到提醒。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan sepasang untuk melacak jarak tempuh dan mendapat peringatan keausan."
          }
        },
        "ms": {
