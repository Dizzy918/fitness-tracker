          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планирует подводку на %lld дн. перед этой датой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Планує підведення на %lld дн. перед цією датою."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날짜 전 %lld일간의 테이퍼링을 계획합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
