    "Superset exercises alternate: a set of each, then rest.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражненията в суперсерия се редуват: по една серия от всяко, после почивка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übungen im Supersatz wechseln sich ab: je ein Satz, dann Pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios de una superserie se alternan: una serie de cada uno y después descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices d'un superset alternent : une série de chaque, puis récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esercizi di una superserie si alternano: una serie per ciascuno, poi recupero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefeningen in een superset wisselen elkaar af: één set van elk, dan rust."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exercícios de uma supersérie alternam: uma série de cada, depois descanso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenia w superserii następują na przemian: po serii z każdego, potem przerwa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övningar i ett superset varvas: ett set av varje, sedan vila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スーパーセットの種目は交互に行います。各 1 セットずつ、そのあとレストです。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelser i et supersæt skiftes: ét sæt af hver, derefter pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelser i et supersett veksler: ett sett av hver, så pause."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Supersarjan liikkeet vuorottelevat: sarja kumpaakin, sitten tauko."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cviky v superserii se střídají: série z každého, pak odpočinek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süperset hareketleri dönüşümlü yapılır: her birinden bir set, sonra dinlenme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнения суперсета чередуются: по подходу каждого, затем отдых."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправи суперсету чергуються: по підходу кожної, потім відпочинок."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슈퍼세트의 운동은 번갈아 진행합니다: 각각 한 세트씩 한 뒤 휴식합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超级组的动作交替进行：每个各做一组，然后休息。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exercícios do bi-set se alternam: uma série de cada e então o descanso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتناوب تمارين المجموعة المزدوجة: مجموعة من كلٍّ منها، ثم راحة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ασκήσεις του superset εναλλάσσονται: ένα σετ από κάθε μία, μετά διάλειμμα."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szuperszett gyakorlatai váltakoznak: mindegyikből egy sorozat, aztán pihenő."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercițiile din superserie alternează: o serie din fiecare, apoi pauză."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cviky v superérii sa striedajú: séria z každého, potom oddych."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaje v superseriji se izmenjujejo: po ena serija vsake, nato počitek."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbe u superseriji se izmjenjuju: po jedna serija svake, pa odmor."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбе у суперсерији се смењују: по једна серија сваке, па одмор."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Superseeria harjutused vahelduvad: seeria kummastki, siis puhkus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Superpieejas vingrinājumi mijas: pa vienai pieejai no katra, tad atpūta."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Superseto pratimai kaitaliojasi: po seriją kiekvieno, tada poilsis."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els exercicis de la superserie s'alternen: una sèrie de cadascun i després descans."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfingar í ofursetti skiptast á: eitt sett af hvorri og svo hvíld."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushtrimet e superserisë alternohen: një seri nga secili, pastaj pushim."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбите во суперсеријата се менуваат: по една серија од секоја, па одмор."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Malartaíonn cleachtaí na sársraithe: sraith de gach ceann, ansin sos."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-eżerċizzji tas-superset jalternaw: sett minn kull wieħed, imbagħad mistrieħ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超級組的動作交替進行：每個各做一組，然後休息。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakan superset bergantian: satu set masing-masing, lalu istirahat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaman superset berselang-seli: satu set setiap satu, kemudian rehat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài trong superset làm xen kẽ: mỗi bài một hiệp, rồi mới nghỉ."
          }
        }
      }
    },
