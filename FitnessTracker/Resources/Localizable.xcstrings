    "SWOLF adds length time and stroke count — lower means more efficient.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF събира времето за дължина и броя загребвания — по-ниско значи по-ефективно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF addiert Bahnzeit und Zugzahl — niedriger heißt effizienter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SWOLF suma el tiempo del largo y el número de brazadas: menos es más eficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le SWOLF additionne le temps de longueur et le nombre de mouvements : plus bas, plus efficace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo SWOLF somma il tempo della vasca e il numero di bracciate: più basso significa più efficiente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF telt baantijd en slagen bij elkaar op — lager betekent efficiënter."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O SWOLF soma o tempo da piscina e o número de braçadas — mais baixo significa mais eficiente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF sumuje czas długości i liczbę ruchów — niżej znaczy wydajniej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF adderar banlängdstid och antal simtag — lägre betyder effektivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF は 1 本のタイムとストローク数の合計です。低いほど効率的です。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF lægger banetid og antal tag sammen — lavere betyder mere effektivt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF legger sammen tiden på lengden og antall tak — lavere betyr mer effektivt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF laskee yhteen altaanvälin ajan ja vetojen määrän — pienempi on tehokkaampi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF sčítá čas na délku a počet záběrů — nižší znamená efektivnější."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF, kulvar süresi ile kulaç sayısını toplar — düşük olması daha verimli demektir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF складывает время отрезка и число гребков — чем меньше, тем эффективнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF додає час відрізка до кількості гребків — що менше, то ефективніше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF는 한 랩의 시간과 스트로크 수를 더한 값으로, 낮을수록 효율적입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF 是单程用时加划水次数——数值越低效率越高。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SWOLF soma o tempo da piscina com o número de braçadas — quanto menor, mais eficiente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏SWOLF يجمع زمن الطول مع عدد الضربات — والأقل يعني أكفأ."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το SWOLF προσθέτει τον χρόνο της διαδρομής και τον αριθμό των χεριών — όσο μικρότερο, τόσο πιο αποδοτικό."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SWOLF a hossz idejét és a karcsapások számát adja össze — az alacsonyabb a hatékonyabb."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF adună timpul pe lungime și numărul de brațe — mai mic înseamnă mai eficient."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF sčítava čas na dĺžku a počet záberov — nižšie znamená efektívnejšie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF sešteje čas dolžine in število zavesljajev — nižje pomeni učinkoviteje."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF zbraja vrijeme dužine i broj zaveslaja — manje znači učinkovitije."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF сабира време дужине и број завеслаја — мање значи ефикасније."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF liidab basseinipikkuse aja ja tõmmete arvu — väiksem tähendab tõhusamat."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF saskaita baseina garuma laiku un vēzienu skaitu — mazāks nozīmē efektīvāk."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF sudeda baseino ilgio laiką ir mostų skaičių — mažiau reiškia efektyviau."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El SWOLF suma el temps del llarg i el nombre de braçades: com més baix, més eficient."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF leggur saman tíma lengdarinnar og fjölda sundtaka — lægra þýðir skilvirkara."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF mbledh kohën e gjatësisë dhe numrin e kraharoreve — sa më i ulët, aq më efikas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF го собира времето на должината и бројот на замавнувања — помало значи поефикасно."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Suimíonn SWOLF am an fhaid agus líon na mbuillí — is éifeachtaí é an ceann is ísle."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "L-SWOLF jgħodd flimkien il-ħin tat-tul u n-numru ta' daqqiet — inqas ifisser aktar effiċjenti."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF 是單趟用時加上划水次數——數值越低效率越高。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF menjumlahkan waktu per panjang kolam dan jumlah kayuhan — makin rendah makin efisien."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF menjumlahkan masa sepanjang kolam dengan bilangan kayuhan — makin rendah makin cekap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SWOLF cộng thời gian bơi một chiều bể với số sải tay — càng thấp thì càng hiệu quả."
          }
        }
      }
    },
