        }
      }
    },
    "Based on %lld%% of inputs": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На база %lld%% от входните данни"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf %lld%% der Eingaben"
          }
        }
      }
    },
    "Based on %lld%% of the sessions in this window.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На база %lld%% от тренировките в този период."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf %lld%% der Einheiten in diesem Zeitraum."
          }
        }
      }
    },
    "Based on part of the picture, and on how your own trends usually look — not on how you feel. If those disagree, trust yourself.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "На база част от картината и на това как обикновено изглеждат твоите тенденции — не на това как се чувстваш. Ако се разминават, вярвай на себе си."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basiert auf einem Teil des Bildes und darauf, wie deine Trends normalerweise aussehen — nicht darauf, wie du dich fühlst. Bei Widerspruch vertraue dir selbst."
          }
        }
      }
    },
    "Below the aerobic threshold — conversational": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Под аеробния праг — разговорно темпо"
