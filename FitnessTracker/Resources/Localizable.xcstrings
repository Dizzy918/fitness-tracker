    "Sends this route's coordinates to OpenTopoData's public service to read ground elevation. Imported GPX that already carries elevation doesn't need this.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изпраща координатите на маршрута към публичната услуга на OpenTopoData, за да прочете надморската височина. Импортиран GPX, който вече носи височина, няма нужда от това."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet die Koordinaten dieser Route an den öffentlichen Dienst von OpenTopoData, um die Geländehöhe abzurufen. Importierte GPX-Dateien, die bereits Höhen enthalten, brauchen das nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía las coordenadas de esta ruta al servicio público de OpenTopoData para leer la altitud del terreno. Un GPX importado que ya trae altitud no lo necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les coordonnées de cet itinéraire au service public OpenTopoData pour lire l'altitude du terrain. Un GPX importé qui contient déjà l'altitude n'en a pas besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia le coordinate di questo percorso al servizio pubblico OpenTopoData per leggere la quota del terreno. Un GPX importato che già contiene le quote non ne ha bisogno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt de coördinaten van deze route naar de publieke dienst van OpenTopoData om de terreinhoogte op te halen. Een geïmporteerde GPX die al hoogtes bevat heeft dit niet nodig."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia as coordenadas deste percurso para o serviço público do OpenTopoData para ler a altitude do terreno. Um GPX importado que já traga altitude não precisa disto."
          }
        }
      }
    },
