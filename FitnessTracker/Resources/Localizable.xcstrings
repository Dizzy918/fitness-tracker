            "value": "Kad gautum pasirengimo įvertį, importuok iš Sveikatos arba užpildyk dienos įrašą."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa de Salut o fes el registre diari per obtenir una puntuació de preparació."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttu inn úr Heilsu eða skráðu daglega líðan til að fá viðbúnaðareinkunn."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Importo nga Shëndeti ose bëj regjistrimin ditor për të marrë një vlerësim gatishmërie."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увези од Здравје или направи дневен запис за да добиеш оцена за подготвеност."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Iompórtáil ó Health nó déan seiceáil laethúil chun scór ullmhachta a fháil."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa minn Health jew agħmel ir-reġistrazzjoni ta' kuljum biex tikseb punteġġ ta' tħejjija."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「健康」匯入或完成每日簽到，即可取得狀態評分。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor dari Health atau lakukan check-in harian untuk mendapat skor kesiapan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Import daripada Health atau buat daftar masuk harian untuk mendapatkan skor kesediaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập từ Health hoặc điểm danh hằng ngày để có điểm sẵn sàng."
          }
        }
      }
    },
