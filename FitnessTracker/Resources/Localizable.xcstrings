    "Time in zone needs per-second heart rate, which comes from a .fit import or a synced activity with streams.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Времето в зона изисква пулс по секунди, който идва от .fit импорт или синхронизирана активност с потоци."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit in der Zone braucht Herzfrequenz im Sekundentakt, aus einem .fit-Import oder einer synchronisierten Aktivität mit Datenströmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo en zona necesita frecuencia cardíaca por segundo, que viene de una importación .fit o de una actividad sincronizada con registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps en zone exige une fréquence cardiaque à la seconde, issue d'un import .fit ou d'une activité synchronisée avec relevés."
          }
        }
      }
    },
