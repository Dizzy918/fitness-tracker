    "Readiness %lld out of 100, %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовност %lld от 100, %@"
          }
        },
        "de": {
