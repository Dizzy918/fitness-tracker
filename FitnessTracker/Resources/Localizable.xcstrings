        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra olímpica pesa %@; as barras femininas %@, e uma barra de treino pode pesar 10."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gryf olimpijski waży %@; damskie %@, a treningowy może ważyć 10."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En olympisk stång väger %@; damstänger %@, och en träningsstång kan väga 10."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリンピックバーは %@、女性用は %@、トレーニングバーは 10 のこともあります。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En olympisk stang vejer %@; damestænger %@, og en træningsstang kan veje 10."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En olympisk stang veier %@; damestenger %@, og en treningsstang kan veie 10."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olympiatanko painaa %@; naisten tangot %@, ja harjoitustanko voi olla 10."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Olympijská osa váží %@; dámské %@ a tréninková může mít 10."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olimpik bar %@; kadın barları %@ ve antrenman barı 10 olabilir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Олимпийский гриф — %@; женский — %@, а тренировочный может быть 10."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Олімпійський гриф — %@; жіночий — %@, а тренувальний може бути 10."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올림픽 바는 %@이고, 여성용 바는 %@이며, 연습용 바는 10일 수도 있습니다."
