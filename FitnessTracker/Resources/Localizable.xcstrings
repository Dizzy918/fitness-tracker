    "Superset exercises alternate: a set of each, then rest.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражненията в суперсерия се редуват: по една серия от всяко, после почивка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übungen im Supersatz wechseln sich ab: je ein Satz, dann Pause."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios de una superserie se alternan: una serie de cada uno y después descanso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices d'un superset alternent : une série de chaque, puis récupération."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esercizi di una superserie si alternano: una serie per ciascuno, poi recupero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefeningen in een superset wisselen elkaar af: één set van elk, dan rust."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exercícios de uma supersérie alternam: uma série de cada, depois descanso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwiczenia w superserii następują na przemian: po serii z każdego, potem przerwa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Övningar i ett superset varvas: ett set av varje, sedan vila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スーパーセットの種目は交互に行います。各 1 セットずつ、そのあとレストです。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelser i et supersæt skiftes: ét sæt af hver, derefter pause."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvelser i et supersett veksler: ett sett av hver, så pause."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Supersarjan liikkeet vuorottelevat: sarja kumpaakin, sitten tauko."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cviky v superserii se střídají: série z každého, pak odpočinek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süperset hareketleri dönüşümlü yapılır: her birinden bir set, sonra dinlenme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнения суперсета чередуются: по подходу каждого, затем отдых."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вправи суперсету чергуються: по підходу кожної, потім відпочинок."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슈퍼세트의 운동은 번갈아 진행합니다: 각각 한 세트씩 한 뒤 휴식합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超级组的动作交替进行：每个各做一组，然后休息。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os exercícios do bi-set se alternam: uma série de cada e então o descanso."
          }
        }
      }
    },
