    "Plans a %lld-day taper before this date.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Планира %lld-дневно намаляване преди тази дата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant %lld Tage Tapering vor diesem Datum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica una puesta a punto de %lld días antes de esta fecha."
          }
        },
        "fr": {
          "stringUnit": {
