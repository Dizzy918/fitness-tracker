          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Strava ou o intervals.icu abaixo para ativar a sincronização."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط Strava أو intervals.icu أدناه لتفعيل المزامنة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύνδεσε το Strava ή το intervals.icu παρακάτω για να ενεργοποιήσεις τον συγχρονισμό."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szinkronizáláshoz csatlakoztasd lent a Stravát vagy az intervals.icu-t."
          }
        },
        "ro": {
          "stringUnit": {
