    "Stored on this device only — they go into an encrypted backup if you make one, and nowhere else.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съхраняват се само на това устройство — влизат в криптирано резервно копие, ако направиш такова, и никъде другаде."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät gespeichert — sie landen in einer verschlüsselten Sicherung, falls du eine anlegst, und sonst nirgends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan solo en este dispositivo: van a una copia cifrada si haces una, y a ningún sitio más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockées uniquement sur cet appareil : elles vont dans une sauvegarde chiffrée si tu en fais une, et nulle part ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvate solo su questo dispositivo: finiscono in un backup cifrato se ne fai uno, e da nessun'altra parte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen op dit apparaat bewaard — ze gaan mee in een versleutelde reservekopie als je die maakt, en verder nergens heen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardadas só neste dispositivo — vão para uma cópia de segurança cifrada se fizeres uma, e para mais lado nenhum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane tylko na tym urządzeniu — trafiają do zaszyfrowanej kopii zapasowej, jeśli ją zrobisz, i nigdzie indziej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas bara på den här enheten — de följer med i en krypterad säkerhetskopia om du gör en, och ingen annanstans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにのみ保存されます。バックアップを作れば暗号化されたバックアップに入りますが、それ以外のどこにも送られません。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmes kun på denne enhed — de kommer med i en krypteret sikkerhedskopi, hvis du laver en, og ingen andre steder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagres bare på denne enheten — de blir med i en kryptert sikkerhetskopi hvis du lager en, og ingen andre steder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetaan vain tähän laitteeseen — ne päätyvät salattuun varmuuskopioon, jos teet sellaisen, eikä minnekään muualle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloženo jen v tomto zařízení — pokud si vytvoříš šifrovanou zálohu, půjde to do ní, a jinam nikam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu cihazda saklanır — şifreli bir yedek alırsan ona girer, başka hiçbir yere gitmez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится только на этом устройстве — попадёт в зашифрованную резервную копию, если вы её сделаете, и больше никуда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігається лише на цьому пристрої — потрапить до зашифрованої резервної копії, якщо ви її зробите, і більше нікуди."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에만 저장됩니다 — 암호화 백업을 만들면 거기에 포함되며, 그 외 어디로도 가지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅存放在本设备——如果你做加密备份，它们会进入备份，除此之外不会去任何地方。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardadas só neste dispositivo — entram em um backup criptografado, se você fizer um, e em nenhum outro lugar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزَّنة على هذا الجهاز فقط — وتدخل في نسخة احتياطية مشفَّرة إن أنشأت واحدة، ولا تذهب إلى أي مكان آخر."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύονται μόνο σε αυτή τη συσκευή — μπαίνουν σε κρυπτογραφημένο αντίγραφο ασφαλείας αν φτιάξεις ένα, και πουθενά αλλού."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak ezen az eszközön tárolódnak — bekerülnek egy titkosított biztonsági mentésbe, ha készítesz ilyet, máshová sehová."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se păstrează doar pe acest dispozitiv — ajung într-o copie de rezervă criptată dacă faci una, și nicăieri altundeva."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené len v tomto zariadení — ak si vytvoríš šifrovanú zálohu, pôjde to do nej, a inam nikam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shranjeno samo v tej napravi — če narediš šifrirano varnostno kopijo, gre vanjo, sicer nikamor drugam."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno samo na ovom uređaju — ako napraviš šifriranu sigurnosnu kopiju, ide u nju, i nigdje drugdje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сачувано само на овом уређају — ако направиш шифровану резервну копију, иде у њу, и нигде другде."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestatud ainult sellesse seadmesse — need lähevad krüpteeritud varukoopiasse, kui sa selle teed, ja mitte kuhugi mujale."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glabājas tikai šajā ierīcē — tie nonāk šifrētā dublējumā, ja tādu izveido, un nekur citur."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugoma tik šiame įrenginyje — pateks į šifruotą atsarginę kopiją, jei tokią padarysi, ir niekur kitur."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es guarden només en aquest dispositiu: van a una còpia de seguretat xifrada si en fas una, i enlloc més."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymt aðeins í þessu tæki — það fer í dulkóðað afrit ef þú býrð það til, og hvergi annars staðar."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhen vetëm në këtë pajisje — futen në një kopje rezervë të enkriptuar nëse krijon një të tillë, dhe askund tjetër."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Се чуваат само на овој уред — влегуваат во шифрирана резервна копија ако направиш таква, и никаде на друго место."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Stóráilte ar an ngléas seo amháin — téann siad isteach i gcúltaca criptithe má dhéanann tú ceann, agus áit ar bith eile."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Maħżuna fuq dan l-apparat biss — jidħlu f'backup iċċifrat jekk tagħmel wieħed, u mkien iżjed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只存在本裝置——如果你做加密備份，它們會進到備份裡，除此之外哪裡都不會去。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan di perangkat ini saja — semuanya ikut ke cadangan terenkripsi kalau kamu membuatnya, dan tidak ke mana pun lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan pada peranti ini sahaja — semuanya masuk ke dalam sandaran tersulit jika anda membuatnya, dan tidak ke mana-mana lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưu trên thiết bị này — chúng sẽ nằm trong bản sao lưu đã mã hóa nếu bạn tạo một bản, và không đi đâu khác."
          }
        }
      }
    },
    "Straight into the next exercise — the rest comes at the end of the round.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направо към следващото упражнение — почивката идва в края на кръга."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt weiter zur nächsten Übung — die Pause kommt am Ende der Runde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Directo al siguiente ejercicio: el descanso llega al final de la ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enchaîne directement sur l'exercice suivant : la récupération vient à la fin du tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subito all'esercizio successivo: il recupero arriva alla fine del giro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct door naar de volgende oefening — de rust komt aan het eind van de ronde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue direto para o exercício seguinte — o descanso vem no fim da ronda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od razu do następnego ćwiczenia — przerwa jest na końcu rundy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt vidare till nästa övning — vilan kommer i slutet av varvet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのまま次の種目へ。レストはラウンドの最後です。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte videre til næste øvelse — pausen kommer i slutningen af runden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett videre til neste øvelse — pausen kommer på slutten av runden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoraan seuraavaan liikkeeseen — tauko tulee kierroksen lopussa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovnou na další cvik — odpočinek přijde na konci kola."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan sonraki harekete — dinlenme turun sonunda gelir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу к следующему упражнению — отдых в конце круга."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу до наступної вправи — відпочинок у кінці кола."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬지 않고 다음 운동으로 — 휴식은 라운드 끝에 옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接进入下一个动作——休息放在这一轮结束时。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direto para o próximo exercício — o descanso vem no fim da rodada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مباشرةً إلى التمرين التالي — والراحة في نهاية الجولة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατευθείαν στην επόμενη άσκηση — το διάλειμμα έρχεται στο τέλος του γύρου."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyből a következő gyakorlat — a pihenő a kör végén jön."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct la exercițiul următor — pauza vine la finalul rundei."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovno na ďalší cvik — oddych príde na konci kola."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naravnost na naslednjo vajo — počitek pride na koncu kroga."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmah na sljedeću vježbu — odmor dolazi na kraju kruga."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одмах на следећу вежбу — одмор долази на крају круга."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otse järgmise harjutuse juurde — puhkus tuleb ringi lõpus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzreiz pie nākamā vingrinājuma — atpūta nāk apļa beigās."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Iškart į kitą pratimą — poilsis ateina rato pabaigoje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Directament al següent exercici: el descans arriba al final de la ronda."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Beint í næstu æfingu — hvíldin kemur í lok umferðarinnar."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Drejt e te ushtrimi tjetër — pushimi vjen në fund të raundit."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веднаш на следната вежба — одморот доаѓа на крајот од кругот."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Díreach isteach sa chéad chleachtadh eile — tagann an sos ag deireadh an bhabhta."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dritt għall-eżerċizzju li jmiss — il-mistrieħ jiġi fl-aħħar tar-round."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接進入下一個動作——休息放在這一輪的最後。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung ke gerakan berikutnya — istirahatnya di akhir putaran."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus ke senaman seterusnya — rehatnya di hujung pusingan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào thẳng bài tiếp theo — nghỉ để đến cuối vòng."
          }
        }
      }
    },
