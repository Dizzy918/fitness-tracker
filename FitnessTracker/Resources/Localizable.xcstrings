    "Plan a route on the map, or import a GPX file. Export sends it to your watch.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Планирай маршрут на картата или импортирай GPX файл. Експортът го изпраща към часовника ти."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane eine Route auf der Karte oder importiere eine GPX-Datei. Der Export schickt sie an deine Uhr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifica una ruta en el mapa o importa un archivo GPX. Exportar la envía a tu reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace un itinéraire sur la carte, ou importe un fichier GPX. L'export l'envoie à ta montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia un percorso sulla mappa o importa un file GPX. L'esportazione lo invia al tuo orologio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan een route op de kaart, of importeer een GPX-bestand. Exporteren stuurt hem naar je horloge."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeia um percurso no mapa, ou importa um ficheiro GPX. Exportar envia-o para o teu relógio."
          }
        }
      }
    },
    "Plan on map": {
