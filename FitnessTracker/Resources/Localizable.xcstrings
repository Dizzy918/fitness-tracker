    "Runs until you press lap on the watch.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Продължава, докато не натиснеш обиколка на часовника."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft, bis du auf der Uhr die Runde drückst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue hasta que pulses vuelta en el reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poursuit jusqu'à ce que tu appuies sur tour sur la montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosegue finché non premi giro sull'orologio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopt door tot je op je horloge op ronde drukt."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua até carregares em volta no relógio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa, aż naciśniesz okrążenie na zegarku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätter tills du trycker varv på klockan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計でラップを押すまで続きます。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsætter, indtil du trykker omgang på uret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsetter til du trykker runde på klokka."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkuu, kunnes painat kellosta kierrosta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běží, dokud na hodinkách nezmáčkneš okruh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatte tur düğmesine basana kadar sürer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт, пока вы не нажмёте «круг» на часах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває, доки ви не натиснете «коло» на годиннику."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계에서 랩 버튼을 누를 때까지 계속됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直进行，直到你在手表上按下分段键。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue até você apertar volta no relógio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر حتى تضغط زر اللفة على الساعة."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζει μέχρι να πατήσεις γύρο στο ρολόι."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Addig tart, amíg meg nem nyomod a kör gombot az órán."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuă până apeși butonul de tură pe ceas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Beží, kým na hodinkách nestlačíš okruh."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teče, dokler na uri ne pritisneš kroga."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traje dok na satu ne pritisneš krug."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Траје док на сату не притиснеш круг."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestab, kuni vajutad kellal ringinuppu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turpinās, līdz pulkstenī nospied apļa pogu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tęsiasi, kol laikrodyje paspausi rato mygtuką."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua fins que premis volta al rellotge."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Heldur áfram þar til þú ýtir á hring í úrinu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazhdon derisa të shtypësh xhiron në orë."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трае додека не притиснеш круг на часовникот."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Leanann sé go dtí go mbrúnn tú camchuairt ar an uaireadóir."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tibqa' sejra sakemm tagħfas id-dawra fuq l-arloġġ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一直進行，直到你在手錶上按下分段鍵。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan sampai kamu menekan lap di jam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan sehingga anda menekan pusingan pada jam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy cho tới khi bạn bấm nút vòng trên đồng hồ."
          }
        }
      }
    },
