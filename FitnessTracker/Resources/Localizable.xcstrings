          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا المسار إلى نقطتين على الأقل ليكون له مقطع."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η διαδρομή χρειάζεται τουλάχιστον δύο σημεία για να έχει προφίλ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez az útvonalhoz legalább két pont kell, hogy profilja lehessen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest traseu are nevoie de cel puțin două puncte ca să aibă un profil."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto trasa potrebuje aspoň dva body, aby mohla mať profil."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta pot potrebuje vsaj dve točki, da ima lahko profil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova ruta treba barem dvije točke da bi imala profil."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Овој рути требају бар две тачке да би имала профил."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellel marsruudil peab profiili saamiseks olema vähemalt kaks punkti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šim maršrutam vajag vismaz divus punktus, lai tam varētu būt profils."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiam maršrutui reikia bent dviejų taškų, kad turėtų profilį."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta ruta necessita com a mínim dos punts per poder tenir perfil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi leið þarf að minnsta kosti tvo punkta til að geta haft snið."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky itinerar ka nevojë për të paktën dy pika që të ketë një profil."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "На оваа траса ѝ требаат барем две точки за да има профил."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Teastaíonn dhá phointe ar a laghad ón mbealach seo sula mbeidh próifíl aige."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Din ir-rotta teħtieġ mill-inqas żewġ punti biex ikollha profil."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條路線至少要有兩個點才能產生剖面。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rute ini perlu setidaknya dua titik sebelum bisa punya profil."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laluan ini memerlukan sekurang-kurangnya dua titik sebelum ia boleh mempunyai profil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lộ trình này cần ít nhất hai điểm thì mới có mặt cắt được."
          }
        }
      }
    },
