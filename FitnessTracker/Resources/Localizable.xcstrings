        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby se to projevilo, ukonči a znovu otevři aplikaci."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu uygulamak için uygulamayı kapatıp yeniden aç."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы применить, закройте и снова откройте приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб застосувати, закрийте й знову відкрийте застосунок."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용하려면 앱을 종료했다가 다시 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出并重新打开应用以生效。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche e reabra o app para aplicar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق التطبيق وافتحه من جديد لتطبيق ذلك."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείσε και ξανάνοιξε την εφαρμογή για να εφαρμοστεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazásához lépj ki az appból, és indítsd újra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide și redeschide aplicația pentru a aplica."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sa to prejavilo, ukonči a znova otvor aplikáciu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za uveljavitev zapri in znova odpri aplikacijo."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za primjenu zatvori i ponovno otvori aplikaciju."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "За примену затвори и поново отвори апликацију."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendamiseks sulge ja ava rakendus uuesti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai to piemērotu, aizver un atver lietotni no jauna."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad tai įsigaliotų, uždaryk ir vėl atverk programą."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanca i torna a obrir l'app per aplicar-ho."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaðu forritinu og opnaðu það aftur til að virkja þetta."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbyll dhe rihap aplikacionin që kjo të zbatohet."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За да се примени, затвори ја и повторно отвори ја апликацијата."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Dún agus athoscail an aip chun é seo a chur i bhfeidhm."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agħlaq u erġa' iftaħ l-app biex dan jgħodd."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束並重新開啟 App 以生效。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dan buka lagi aplikasinya untuk menerapkan ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluar dan buka semula aplikasi untuk menerapkan ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát rồi mở lại ứng dụng để áp dụng thay đổi này."
          }
        }
      }
    },
