    "Still warming up — the 42-day average needs about three weeks of history before it settles.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Още се загрява — 42-дневната средна има нужда от около три седмици история, преди да се установи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch am Einschwingen — der 42-Tage-Durchschnitt braucht rund drei Wochen Historie, bis er sich setzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía calentando: la media de 42 días necesita unas tres semanas de historial para asentarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore en rodage : la moyenne sur 42 jours a besoin d'environ trois semaines d'historique pour se stabiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora in rodaggio: la media a 42 giorni ha bisogno di circa tre settimane di storico per stabilizzarsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog aan het inlopen — het gemiddelde over 42 dagen heeft zo'n drie weken geschiedenis nodig voordat het stabiel is."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda a assentar — a média de 42 dias precisa de cerca de três semanas de histórico para estabilizar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze się rozgrzewa — średnia 42-dniowa potrzebuje około trzech tygodni historii, zanim się ustabilizuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortfarande i uppstart — 42-dagarssnittet behöver ungefär tre veckors historik innan det sätter sig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ立ち上がり中です。42 日平均が安定するには 3 週間ほどの履歴が要ります。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stadig i gang med at komme op — 42-dages-gennemsnittet skal bruge omkring tre ugers historik, før det falder til ro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsatt i oppstart — 42-dagerssnittet trenger rundt tre uker med historikk før det roer seg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielä käynnistymässä — 42 päivän keskiarvo tarvitsee noin kolme viikkoa historiaa ennen kuin se asettuu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ještě se rozjíždí — 42denní průměr potřebuje zhruba tři týdny historie, než se ustálí."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz ısınıyor — 42 günlük ortalamanın oturması için yaklaşık üç haftalık geçmiş gerekir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё разгоняется — 42-дневному среднему нужно около трёх недель истории, чтобы устояться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще розганяється — 42-денному середньому потрібно близько трьох тижнів історії, щоб устоятися."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 데이터가 쌓이는 중입니다 — 42일 평균이 안정되려면 약 3주치 기록이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还在预热——42 天平均值需要约三周的历史数据才会稳定。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda aquecendo — a média de 42 dias precisa de umas três semanas de histórico para assentar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال يتشكّل — يحتاج متوسط 42 يومًا إلى نحو ثلاثة أسابيع من السجل حتى يستقر."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμη ζεσταίνεται — ο μέσος όρος 42 ημερών θέλει περίπου τρεις εβδομάδες ιστορικού για να σταθεροποιηθεί."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még melegszik — a 42 napos átlagnak nagyjából három hét előzményre van szüksége, hogy beálljon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă se încălzește — media pe 42 de zile are nevoie de vreo trei săptămâni de istoric ca să se stabilizeze."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ešte sa rozbieha — 42-dňový priemer potrebuje asi tri týždne histórie, kým sa ustáli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še se ogreva — 42-dnevno povprečje potrebuje okoli tri tedne zgodovine, da se ustali."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još se zagrijava — 42-dnevnom prosjeku treba oko tri tjedna povijesti da se ustali."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још се загрева — 42-дневном просеку треба око три недеље историје да се устали."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles soojeneb — 42 päeva keskmine vajab paikaloksumiseks umbes kolme nädala ajalugu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vēl iesildās — 42 dienu vidējam vajag apmēram trīs nedēļu vēsturi, lai nostabilizētos."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
