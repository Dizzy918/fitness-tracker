          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olimpinis grifas sveria %@; moteriški grifai — %@, o treniruočių grifas gali būti 10."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra olímpica fa %@; les de dona fan %@, i una barra d'entrenament pot ser de 10."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ólympísk stöng er %@; kvennastangir eru %@ og æfingastöng getur verið 10."
