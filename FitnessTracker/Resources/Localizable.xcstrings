    "%@ short — that's the closest this plate set can make without going over.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ по-малко — това е най-близкото, което този комплект дискове може да направи, без да надхвърли."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zu wenig — näher kommt dieser Scheibensatz nicht heran, ohne darüber zu liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan %@: es lo más cerca que puede quedar este juego de discos sin pasarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque %@ : c'est au plus près que ce jeu de disques peut arriver sans dépasser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano %@: è il massimo che questo set di dischi può fare senza superare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te weinig — dichterbij komt deze schijvenset niet zonder eroverheen te gaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %@ — é o mais perto que este conjunto de discos consegue chegar sem passar."
          }
        }
      }
    },
