    "Zone %lld, %@": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зона %lld, %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone %lld, %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Zona %lld, %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone %lld, %@"
          }
        }
      }
    },
    "Zones, training load and readiness are all computed against your own heart rate. Without a maximum they fall back to the highest figure in your data, which is usually a little low.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Зоните, тренировъчното натоварване и готовността се изчисляват спрямо собствения ти пулс. Без максимум те падат обратно към най-високото число в данните ти, което обикновено е малко ниско."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen, Trainingsbelastung und Bereitschaft werden alle gegen deine eigene Herzfrequenz berechnet. Ohne Maximum greifen sie auf den höchsten Wert in deinen Daten zurück, und der ist meist etwas zu niedrig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas, la carga de entrenamiento y la disposición se calculan todas contra tu propia frecuencia cardíaca. Sin un máximo recurren a la cifra más alta de tus datos, que suele quedarse algo corta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones, la charge d'entraînement et la disponibilité se calculent toutes par rapport à ta propre fréquence cardiaque. Sans maximum, elles retombent sur le chiffre le plus élevé de tes données, généralement un peu faible."
          }
        }
      }
    },
