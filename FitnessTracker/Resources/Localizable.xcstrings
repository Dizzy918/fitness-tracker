    "Not enough training in the week for the spread to mean anything.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Training in der Woche, als dass die Streuung etwas aussagen würde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d'entraînement dans la semaine pour que la dispersion veuille dire quelque chose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente entrenamiento en la semana para que la dispersión signifique algo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo poco allenamento nella settimana perché la dispersione significhi qualcosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig training in de week om de spreiding iets te laten zeggen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Treino insuficiente na semana para a dispersão significar alguma coisa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treino insuficiente na semana para a dispersão significar alguma coisa."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha prou entrenament a la setmana perquè la dispersió vulgui dir res."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea puțin antrenament în săptămână pentru ca împrăștierea să însemne ceva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało treningu w tygodniu, żeby rozrzut cokolwiek znaczył."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V týdnu je příliš málo tréninku, aby rozptyl něco znamenal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V týždni je príliš málo tréningu, aby rozptyl niečo znamenal."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premalo treninga v tednu, da bi razpršenost kaj pomenila."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premalo treninga u tjednu da bi raspršenost išta značila."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Премало тренинга у недељи да би расипање ишта значило."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Твърде малко тренировки през седмицата, за да значи нещо разсейването."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Премалку тренинг во неделата за расејувањето да значи нешто."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком мало тренировок за неделю, чтобы разброс что-то значил."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
