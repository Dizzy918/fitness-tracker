    "An Olympic bar is %@; women's bars are %@, and a training bar can be 10.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Олимпийският лост е %@; дамските лостове са %@, а тренировъчният може да е 10."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Olympiastange wiegt %@; Frauenstangen %@, eine Trainingsstange kann 10 wiegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra olímpica pesa %@; las de mujer %@, y una barra de entrenamiento puede pesar 10."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre olympique pèse %@ ; les barres femmes %@, et une barre d'entraînement peut faire 10."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bilanciere olimpico pesa %@; quelli femminili %@, e uno da allenamento può pesare 10."
