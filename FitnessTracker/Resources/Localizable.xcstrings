    "Derived from your best effort converted to a 10 km equivalent. A lab or field test would be more accurate.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изведено от най-доброто ти усилие, преобразувано към еквивалент на 10 км. Лабораторен или полеви тест би бил по-точен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeleitet aus deiner Bestleistung, umgerechnet auf ein 10-km-Äquivalent. Ein Labor- oder Feldtest wäre genauer."
          }
        },
        "es": {
          "stringUnit": {
