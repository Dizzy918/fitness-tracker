    "Runs until you press lap on the watch.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Продължава, докато не натиснеш обиколка на часовника."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
