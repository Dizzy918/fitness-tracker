    "This workout has no GPS track, so the card is stats only.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази тренировка няма GPS следа, затова картата е само със статистики."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einheit hat keinen GPS-Track, die Karte zeigt also nur Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este entrenamiento no tiene track GPS, así que la tarjeta solo lleva datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette séance n'a pas de trace GPS : la carte ne contient que des chiffres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo allenamento non ha una traccia GPS, quindi la scheda riporta solo i numeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze training heeft geen GPS-track, dus de kaart bevat alleen cijfers."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este treino não tem trilho de GPS, por isso o cartão só traz números."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten trening nie ma śladu GPS, więc karta zawiera same liczby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här passet saknar GPS-spår, så kortet innehåller bara siffror."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークアウトには GPS トラックがないため、カードは数値のみになります。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne træning har intet GPS-spor, så kortet indeholder kun tal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne økta har ingen GPS-spor, så kortet inneholder bare tall."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä harjoituksessa ei ole GPS-jälkeä, joten kortilla on vain lukuja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenhle trénink nemá GPS stopu, takže karta obsahuje jen čísla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu antrenmanın GPS izi yok, bu yüzden kart yalnızca istatistiklerden oluşuyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой тренировки нет GPS-трека, поэтому на карточке только цифры."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цього тренування немає GPS-треку, тож на картці лише цифри."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 운동에는 GPS 트랙이 없어 카드에 수치만 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
