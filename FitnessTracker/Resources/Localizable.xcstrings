          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через кому. Необов’язково — використовується для пошуку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표로 구분. 선택 사항 — 검색에 사용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
