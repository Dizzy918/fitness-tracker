        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Höjdtjänsten är begränsad just nu. Försök igen om en minut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標高サービスは現在、回数制限がかかっています。1 分ほどおいて再試行してください。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højdetjenesten er begrænset lige nu. Prøv igen om et minut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høydetjenesten er begrenset akkurat nå. Prøv igjen om et minutt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkeuspalvelua rajoitetaan juuri nyt. Yritä minuutin kuluttua uudelleen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výšková služba je teď omezená počtem dotazů. Zkus to za minutu znovu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükseklik servisi şu anda istek sınırında. Bir dakika sonra tekrar dene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис высот сейчас ограничивает частоту запросов. Попробуйте через минуту."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервіс висот зараз обмежує частоту запитів. Спробуйте за хвилину."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고도 서비스가 지금 요청 수를 제한하고 있습니다. 1분 뒤에 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海拔服务当前受请求频率限制。请稍等一分钟再试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de elevação está limitando requisições agora. Tente de novo em um minuto."
          }
        }
      }
    },
