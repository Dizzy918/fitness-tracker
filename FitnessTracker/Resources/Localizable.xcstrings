        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fós ag téamh — teastaíonn timpeall trí seachtaine de stair ón meán 42 lá sula socraíonn sé."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Għadha tisħon — il-medja ta' 42 ġurnata teħtieġ madwar tliet ġimgħat ta' storja qabel ma tistabbilizza."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還在暖身——42 天平均值需要約三週的歷史資料才會穩定。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih pemanasan — rata-rata 42 hari perlu sekitar tiga minggu riwayat sebelum stabil."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih memanaskan badan — purata 42 hari memerlukan kira-kira tiga minggu sejarah sebelum ia stabil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn đang khởi động — đường trung bình 42 ngày cần khoảng ba tuần dữ liệu trước khi ổn định."
          }
        }
      }
    },
