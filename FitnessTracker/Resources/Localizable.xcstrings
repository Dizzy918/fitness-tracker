    "Import a .fit file from your Suunto — or drag a folder's worth onto this window — connect Strava or intervals.icu, read a PDF with AI, or seed demo data to explore the app.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортирай .fit файл от Suunto — или довлачи цяла папка върху този прозорец — свържи Strava или intervals.icu, прочети PDF с ИИ, или зареди демо данни, за да разгледаш приложението."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere eine .fit-Datei von deiner Suunto — oder zieh einen ganzen Ordner auf dieses Fenster —, verbinde Strava oder intervals.icu, lies ein PDF mit KI, oder lade Demodaten, um die App zu erkunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un archivo .fit de tu Suunto —o arrastra una carpeta entera a esta ventana—, conecta Strava o intervals.icu, lee un PDF con IA, o carga datos de ejemplo para explorar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe un fichier .fit de ta Suunto — ou glisse tout un dossier sur cette fenêtre —, connecte Strava ou intervals.icu, lis un PDF avec l'IA, ou charge des données de démonstration pour explorer l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un file .fit dal tuo Suunto — o trascina un'intera cartella su questa finestra —, collega Strava o intervals.icu, leggi un PDF con l'IA, oppure carica dati dimostrativi per esplorare l'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer een .fit-bestand van je Suunto — of sleep een hele map op dit venster —, koppel Strava of intervals.icu, lees een PDF met AI, of laad demogegevens om de app te verkennen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa um ficheiro .fit do teu Suunto — ou arrasta uma pasta inteira para esta janela —, liga o Strava ou o intervals.icu, lê um PDF com IA, ou carrega dados de demonstração para explorares a app."
          }
        }
      }
    },
