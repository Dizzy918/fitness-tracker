    "Set your FTP in Settings to get Intensity Factor and TSS.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задай FTP в Настройки, за да получиш Intensity Factor и TSS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage deinen FTP in den Einstellungen ein, um Intensity Factor und TSS zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu FTP en Ajustes para obtener Intensity Factor y TSS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renseigne ta FTP dans les Réglages pour obtenir l'Intensity Factor et le TSS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'FTP nelle Impostazioni per ottenere Intensity Factor e TSS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je FTP in bij Instellingen voor Intensity Factor en TSS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o teu FTP nas Definições para obteres Intensity Factor e TSS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw FTP w Ustawieniach, aby otrzymać Intensity Factor i TSS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange din FTP i Inställningar för att få Intensity Factor och TSS."
          }
        },
        "ja": {
